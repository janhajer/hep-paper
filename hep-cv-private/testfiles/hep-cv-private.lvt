% hep-cv-private: bibliography filters, bibliography macros, environments
% and Indico e-print formats defined on top of hep-cv-bibliography.
\input{regression-test}
\documentclass{article}
\usepackage{hep-cv-bibliography}
\usepackage{hep-cv-private}

% Biber does not run in the tests: fake its output. The .bbl file has been
% generated by biber from the entry
%   @misc{Talk, author={D. Author}, title={Talk}, eprint={12345},
%     eprintclass={67890}, eprinttype={CERN}, date={2023-05}}
% (hash, sorting and label source lines removed).
\begin{filecontents*}[overwrite]{\jobname.bbl}
% $ biblatex auxiliary file $
% $ biblatex bbl format version 3.3 $
% Do not modify the above lines!
%
% This is an auxiliary file used by the 'biblatex' package.
% This file may safely be deleted. It will be recreated by
% biber as required.
%
\begingroup
\makeatletter
\@ifundefined{ver@biblatex.sty}
  {\@latex@error
     {Missing 'biblatex' package}
     {The bibliography requires the 'biblatex' package.}
      \aftergroup\endinput}
  {}
\endgroup


\refsection{0}
  \datalist[entry]{ymdnt/global//global/global/global}
    \entry{Talk}{misc}{}{}
      \name{author}{1}{}{%
        {{}{%
           family={Author},
           familyi={A\bibinitperiod},
           given={D.},
           giveni={D\bibinitperiod}}}%
      }
      \field{eprintclass}{67890}
      \field{eprinttype}{CERN}
      \field{month}{5}
      \field{title}{Talk}
      \field{year}{2023}
      \field{dateera}{ce}
      \verb{eprint}
      \verb 12345
      \endverb
    \endentry
  \enddatalist
\endrefsection
\endinput

\end{filecontents*}
% Only recorded in the .bcf file for biber
\bibliography{\jobname}
% \EPRINT{key}: the e-print as printed in the entry body
\DeclareCiteCommand{\EPRINT}{}{\usebibmacro{eprint}}{}{}
% \URLS{code}: the addresses that code prints with \nolinkurl
\newcommand*{\URLS}[1]{%
  \begingroup
    \renewcommand*{\nolinkurl}[1]{\TYPE{[##1]}}%
    \setbox0\hbox{#1}%
  \endgroup
}
\makeatletter
% \DEFINED{prefix}{list of names}: \<prefix><name> is defined or not
\newcommand*{\DEFINED}[2]{%
  \@for\hep@test@name:=#2\do{%
    \TYPE{\hep@test@name: \expandafter\ifx
      \csname#1\hep@test@name\endcsname\relax undefined\else defined\fi}%
  }%
}
\makeatother
\begin{document}
% Load the fonts
\setbox0\hbox{\EPRINT{Talk}}
\START
\makeatletter

\TEST{Loaded packages}{%
  \DEFINED{ver@}{hep-cv-private.sty,hep-cv-bibliography.sty}%
}

\TEST{Bibliography filters}{%
  \DEFINED{blx@filter@}{work,visit,education,lecture,tutorial,%
    master-supervision,PhD,master,funding-individual,funding-project,%
    funding-participation,organization,seminar,conference,contributions,%
    student,preprint,journal,proceedings,editor,community,software,%
    thesis,main}%
  \TYPE{work: \expandafter\meaning\csname blx@filter@work\endcsname}%
  \TYPE{PhD: \expandafter\meaning\csname blx@filter@PhD\endcsname}%
}

\TEST{Bibliography macros and environments}{%
  \DEFINED{abx@macro@}{presentationstyle}%
  \DEFINED{blx@env@}{work,visit,education,student,course,funding,talk,%
    publication,main}%
}

\TEST{Indico e-print formats}{%
  \DEFINED{abx@ffd@*@eprint:}{CERN,INFN,IJS,DESY,FNAL,Edinburgh,CNRS,%
    IIHE,IRMP,MITP,LIP,cern,infn,ijs,desy,fnal,edinburgh,cnrs,iihe,irmp,%
    mitp,lip}%
}

\TEST{Indico e-print without hep-bibliography and hyperref}{%
  \TYPE{hyperref: \csname @ifpackageloaded\endcsname{hyperref}{yes}{no}}%
  \URLS{\EPRINT{Talk}}%
}

\makeatother
\END
