%<*package>
%
% Load the \software{mathtools} package \cite{mathtools} which loads the \software{amsmath} package \cite{amsmath}.
% Allow page breaks within equations if necessary.
% Adjust the thick and med mu skips slightly.
%    \begin{macrocode}
\RequirePackage{mathtools}
\mathtoolsset{centercolon}
\numberwithin{equation}{section}
\allowdisplaybreaks[1]
\thickmuskip=5mu plus 3mu minus 1mu
\medmuskip=4mu plus 2mu minus 3mu
%    \end{macrocode}
%
% \begin{macro}{\mathdef}
% Define the "\mathdef"\marg{name}\oarg{arguments}\marg{macro} macro which \prefix{re}{defines} macros in math mode only.
% This macro is implemented using the \software{xparse} package \cite{xparse}.
% The dispatch between the two definitions is expandable, so that the macro also works in PDF strings, where a "\let" would be dropped.
% The text definition is copied with "\DeclareCommandCopy", which also copies robust commands correctly.
% If the macro is still the dispatcher of an earlier "\mathdef", only the math definition is replaced, so that the original text definition is kept and the dispatcher does not call itself.
% The dispatcher is recorded in "\hep@mathdef"\meta{name} for this test.
%    \begin{macrocode}
\RequirePackage{xparse}
\DeclareDocumentCommand{\mathdef}{mO{0}om}{%
  \hep@if@mathdef#1{}{%
    \ifdefined#1%
      \expandafter\DeclareCommandCopy\csname hep@text\string#1\endcsname#1%
    \else
      \expandafter\let\csname hep@text\string#1\endcsname=#1%
    \fi
  }%
  \expandafter\let\csname hep@math\string#1\endcsname\relax
  \expandafter\newcommand\expandafter*\csname hep@math\string#1%
  \IfNoValueTF{#3}{\endcsname[#2]}{\endcsname[#2][#3]}{#4}%
  \DeclareRobustCommand#1{%
    \csname hep@\ifmmode math\else text\fi\string#1\endcsname
  }%
  \expandafter\let\csname hep@mathdef\string#1\endcsname#1%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@if@mathdef}
% Test whether the macro is the dispatcher of an earlier "\mathdef".
%    \begin{macrocode}
\newcommand*{\hep@if@mathdef}[1]{%
  \ifcsname hep@mathdef\string#1\endcsname
    \expandafter\ifx\csname hep@mathdef\string#1\endcsname#1%
      \expandafter\expandafter\expandafter\@firstoftwo
    \else
      \expandafter\expandafter\expandafter\@secondoftwo
    \fi
  \else
    \expandafter\@secondoftwo
  \fi
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@mathdef@default}
% Define the default math meaning of a macro at the beginning of the document, unless the preamble already defined one with "\mathdef".
%    \begin{macrocode}
\newcommand*{\hep@mathdef@default}[2]{%
  \AtBeginDocument{\hep@if@mathdef#1{}{\mathdef{#1}{#2}}}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\i}
% Provide an upright imaginary unit in math mode.
%    \begin{macrocode}
\newcommand*{\imaginaryunit}{i}
\hep@mathdef@default{\i}{\imaginaryunit}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@soul@if@safe}
% Test whether the \software{soul} package \cite{soul} can process a text.
% This is the case if every macro in the text, outside of inline math, is known to \software{soul}: registered with "\soulregister", such as font commands and accents, or handled by \software{soul} itself, such as "\\" and "\mbox".
% Other macros may take arguments, which \software{soul} would separate from the macro, or look ahead, as "\xspace" does.
% The same test is defined by the \software{hep-text} package for "\underline", so it is only defined if it does not exist yet.
% "\hep@soul@if@safe" is the \hologo{LaTeXe} name of the conditional "\hep_soul_if_safe:nTF".
%    \begin{macrocode}
\ExplSyntaxOn
\cs_if_exist:NF \hep_soul_if_safe:nTF {
  \seq_new:N \l__hep_soul_seq
  \tl_new:N \l__hep_soul_tl
  \tl_new:N \l__hep_soul_known_tl
  \bool_new:N \l__hep_soul_bool
  \regex_const:Nn \c__hep_soul_math_regex { \cM\$ .*? \cM\$ }
  \regex_const:Nn \c__hep_soul_cs_regex { \c{.*} }
  \tl_const:Nn \c__hep_soul_known_tl {
    \\0\\ \\0\slash \\0\mbox \\0\hbox \\0\soulomit
    \\0\break \\0\linebreak \\0\- \\0\par
  }
  \prg_new_protected_conditional:Npnn \hep_soul_if_safe:n #1 { TF } {
    \group_begin:
    \cs_set:Npn \\ ##1 ##2 { \token_to_str:N ##2 , }
    \tl_set:No \l__hep_soul_known_tl { \the \SOUL@cmds }
    \tl_set:Ne \l__hep_soul_known_tl
      { , \l__hep_soul_known_tl \c__hep_soul_known_tl }
    \tl_set:Nn \l__hep_soul_tl {#1}
    \regex_replace_all:NnN \c__hep_soul_math_regex { } \l__hep_soul_tl
    \regex_extract_all:NVN \c__hep_soul_cs_regex
      \l__hep_soul_tl \l__hep_soul_seq
    \bool_set_true:N \l__hep_soul_bool
    \seq_map_inline:Nn \l__hep_soul_seq {
      \token_if_macro:NT ##1 {
        \exp_args:NNe \tl_if_in:NnF \l__hep_soul_known_tl
          { , \token_to_str:N ##1 , }
          { \bool_set_false:N \l__hep_soul_bool \seq_map_break: }
      }
    }
    \bool_if:NTF \l__hep_soul_bool
      { \group_end: \prg_return_true: }
