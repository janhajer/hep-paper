% \begin{macro}{\hep@order@power}
% \begin{macro}{\hep@power}
% Collect the order of a partial derivative.
% Integer exponents are summed, other exponents are added symbolically in front of the sum of the integers, so that \eg the exponents $n$, $1$, and $2$ give $n+3$.
% "\hep@order@power" prints the total order as superscript and "\hep@power"\marg{exponent} a single exponent, both only if they differ from one.
%    \begin{macrocode}
\ExplSyntaxOn
\tl_new:N \l__hep_order_tl
\int_new:N \l__hep_order_int
\regex_const:Nn \c__hep_integer_regex { \A \s* [\+\-]? \s* \d+ \s* \Z }
\cs_new_protected:Npn \hep@order@clear {
  \tl_clear:N \l__hep_order_tl
  \int_zero:N \l__hep_order_int
}
\cs_new_protected:Npn \hep@order@add #1 {
  \regex_match:NnTF \c__hep_integer_regex {#1} {
    \int_add:Nn \l__hep_order_int {#1}
  } {
    \tl_if_empty:NF \l__hep_order_tl
      { \tl_put_right:Nn \l__hep_order_tl { + } }
    \tl_put_right:Nn \l__hep_order_tl {#1}
  }
}
\cs_new_protected:Npn \hep@order@power {
  \tl_if_empty:NTF \l__hep_order_tl {
    \int_compare:nNnF \l__hep_order_int = 1
      { { ^ { \int_use:N \l__hep_order_int \! } } }
  } {
    { ^ {
      \l__hep_order_tl
      \int_compare:nNnT \l__hep_order_int > 0 { + }
      \int_compare:nNnF \l__hep_order_int = 0
        { \int_use:N \l__hep_order_int }
      \!
    } }
  }
}
\cs_new_protected:Npn \hep@power #1 {
  \regex_match:NnTF \c__hep_integer_regex {#1} {
    \int_compare:nNnF {#1} = 1 { { ^ {#1} } }
  } {
    { ^ {#1} }
  }
}
