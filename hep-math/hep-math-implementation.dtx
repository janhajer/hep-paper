% \begin{macro}{\hep@mathpdf@ifkeyval}
% Expandable test whether the optional argument of "\unit" is a key--value list.
%    \begin{macrocode}
\newcommand*{\hep@mathpdf@ifkeyval}[1]{%
  \hep@mathpdf@@ifkeyval#1=\hep@mathpdf@stop
}
\def\hep@mathpdf@@ifkeyval#1=#2\hep@mathpdf@stop{%
  \if\relax\detokenize{#2}\relax
    \expandafter\@secondoftwo
  \else
    \expandafter\@firstoftwo
  \fi
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@mathpdf@unprotect}
% The operators of \software{amsmath} are protected, so that they would vanish from PDF strings.
% Replace them by unprotected copies, if they still are operators.
%    \begin{macrocode}
\newcommand*{\hep@mathpdf@unprotect}[1]{%
  \expandafter\hep@mathpdf@@unprotect#1\hep@mathpdf@stop#1%
}
\def\hep@mathpdf@@unprotect#1#2\hep@mathpdf@stop#3{%
  \ifx\qopname#1\def#3{#1#2}\fi
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@mathpdf@definitions}
% Define the PDF-string versions of the macros, \eg for bookmarks.
% The imaginary unit and the differential become i and d, overlines, slashes, and arrow accents keep only their base, and vectors are written as parentheses.
% Operators keep their name followed by a space, the probability "\Pr" keeps its brackets, transposes and inverses become a circumflex, fractions become flat, and "\unit"\oarg{value}\marg{unit} keeps its value.
% The PDF-string version of "\unit" from \software{siunitx} is copied at each use, since \software{siunitx} registers it at the beginning of the document.
%    \begin{macrocode}
\newcommand*{\hep@mathpdf@definitions}{%
  \@tfor\hep@mathpdf@op:=\arcsin\arg\cosh\coth\deg\dim\exp\gcd\hom\inf
    \ker\lg\lim\ln\log\max\min\sin\sinh\sup\tanh
    \do{\expandafter\hep@mathpdf@unprotect\hep@mathpdf@op}%
  \def\liminf{lim inf }%
  \def\limsup{lim sup }%
  \def\i{i}%
  \def\d{d}%
  \let\overline\@firstofone
  \let\widebar\@firstofone
  \let\slashed\@firstofone
  \RenewExpandableDocumentCommand{\oset}{omm}{##3}%
  \def\column##1{(##1)}%
  \def\row##1{(##1)}%
  \def\transpose{\textasciicircum T}%
  \let\trans\transpose
  \def\qopname##1##2##3{##3 }%
  \RenewExpandableDocumentCommand{\operatorname}{sm}{##2}%
  \let\hep@trig@strut\@empty
  \def\Pr{Pr}%
  \def\given{|}%
  \def\hep@Re{Re}%
  \def\hep@Im{Im}%
  \RenewExpandableDocumentCommand{\inv}{O{1}m}{%
    ##2\textasciicircum-##1%
  }%
  \RenewExpandableDocumentCommand{\nicefrac}{omom}{##2/##4}%
  \def\textfrac##1##2{##1/##2}%
  \RenewExpandableDocumentCommand{\flatfrac}{somm}{##3/##4}%
  \DeclareCommandCopy{\hep@mathpdf@unit}{\unit}%
  \DeclareCommandCopy{\hep@mathpdf@qty}{\qty}%
  \RenewExpandableDocumentCommand{\unit}{om}{%
    \IfNoValueTF{##1}{\hep@mathpdf@unit{##2}}{%
      \hep@mathpdf@ifkeyval{##1}%
        {\hep@mathpdf@unit[##1]{##2}}{\hep@mathpdf@qty{##1}{##2}}%
    }%
  }%
  \RenewExpandableDocumentCommand{\unitfrac}{omm}{%
    \IfNoValueTF{##1}%
      {\hep@mathpdf@unit{##2\per##3}}{\hep@mathpdf@qty{##1}{##2\per##3}}%
  }%
}
%    \end{macrocode}
% \end{macro}
%
% Register the PDF-string definitions if \software{hyperref} is loaded, before or after this package.
% This happens at the end of "\begin{document}", after \software{siunitx} has registered its own definitions.
%    \begin{macrocode}
\AddToHook{begindocument/end}{%
  \@ifpackageloaded{hyperref}{%
    \pdfstringdefDisableCommands{\hep@mathpdf@definitions}%
  }{}%
}
