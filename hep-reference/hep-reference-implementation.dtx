% \section{Implementation}
%
% Load the \software{hyperref} package \cite{hyperref} enable Unicode encoding and hide links.
%    \begin{macrocode}
\RequirePackage{hyperref}
\hypersetup{
  pdfencoding=auto, psdextra,
  linktoc=all, hidelinks, breaklinks=true,
  pdfcreator={}, pdfproducer={}
}
\AtBeginDocument{\@ifpackageloaded{doc}{\hypersetup{hidelinks}}{}}
%    \end{macrocode}
%
% \begin{macro}{\hep@gobble@opt@mand}
% \begin{macro}{\hep@gobble@cite}
% \begin{macro}{\hep@pdf@newline}
% \begin{macro}{\hep@pdf@eqref}
% Ensure that unnecessary information is suppressed in \PDF strings.
% Footnotes, thanks, and citations are dropped, together with an optional argument and, for citations, the following spaces.
% Line breaks become spaces, "\unskip" and "\m@th" are ignored, and the content of "\ensuremath" is kept.
% Equation references become the parenthesised reference number.
%    \begin{macrocode}
\RequirePackage{xparse}
\NewExpandableDocumentCommand\hep@gobble@opt@mand{o+m}{}
\NewExpandableDocumentCommand\hep@gobble@cite{oom}{\ignorespaces}
\newcommand*\hep@pdf@newline{\space\ignorespaces}
\newcommand*\hep@pdf@eqref[1]{(\ref*{#1})}
\pdfstringdefDisableCommands{\def\varepsilon{\textepsilon}}
\pdfstringdefDisableCommands{\def\to{\textrightarrow}}
\AtBeginDocument{%
  \pdfstringdefDisableCommands{%
    \let\ensuremath\@firstofone
    \let\m@th\@empty
    \let\mathsurround\@gobble
    \let\unskip\@empty
    \let\thanks\@gobble
    \let\footnote\hep@gobble@opt@mand
    \let\\\hep@pdf@newline
    \let\cite\hep@gobble@cite
    \let\eqref\hep@pdf@eqref
    \let\@latex@warning@no@line\@gobble
    \let\class@warn\@gobble
  }%
}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\subject}
% Set the \PDF meta data according to the paper information.
% The title and keywords are left to \software{hep-title} or \software{hep-journal} if one of them is loaded, and a title or keywords set by the user with "\hypersetup" are kept.
% A missing title is skipped, since its default is a warning, which loops in a \PDF string if the \software{silence} package is loaded.
% For the same reason the warnings of the missing title in \LaTeX{} ("\@latex@warning@no@line") and REV\hologo{TeX} ("\class@warn") are dropped in \PDF strings.
% Define "\subject"\marg{subject} for the \PDF subject, unless the class already defines it.
% The KOMA-Script classes define "\subject" and store its argument in "\@subject", which then becomes the \PDF subject.
%
%    \begin{macrocode}
\@ifundefined{subject}{%
  \NewDocumentCommand{\subject}{m}{\def\hep@subject{#1}}%
}{}
\newcommand*{\hep@if@title@package}{%
  \@ifpackageloaded{hep-title}{\@firstoftwo}{%
    \@ifpackageloaded{hep-journal}{\@firstoftwo}{\@secondoftwo}%
  }%
}
\AddToHook{cmd/maketitle/before}[hep-reference/pdfinfo]{%
  \hep@if@title@package{}{%
    \ifx\@pdftitle\@empty
      \expandafter\in@\expandafter\@latex@warning@no@line
        \expandafter{\@title}%
      \ifin@\else
        \@ifundefined{hep@sub@title}{%
          \hypersetup{pdftitle={\@title}}%
        }{%
          \hypersetup{pdftitle={\@title: \hep@sub@title}}%
        }%
      \fi
    \fi
    \ifx\@pdfkeywords\@empty
      \@ifundefined{hep@key@words}{}{%
        \hypersetup{pdfkeywords={\hep@key@words}}%
      }%
    \fi
  }%
  \@ifundefined{hep@subject}{%
    \@ifundefined{@subject}{}{%
      \ifx\@subject\@empty\else\hypersetup{pdfsubject=\@subject}\fi
    }%
  }{%
    \hypersetup{pdfsubject=\hep@subject}%
  }%
}
%    \end{macrocode}
% \end{macro}

% \subsection{Footnotes}
%
% Place a hyperlink from the footnote back to its referencing label using the \software{footnotebackref} package \cite{footnotebackref}.
%    \begin{macrocode}
\def\BackrefFootnoteTag{}
\RequirePackage{footnotebackref}
%    \end{macrocode}
%
% \begin{macro}{\footnote}
% Ensure that no spaces appear before the footmark or at the beginning of the footnote.
% The footnote text may contain paragraphs.
%    \begin{macrocode}
\NewCommandCopy\@foot@note\footnote
\RenewDocumentCommand{\footnote}{o+m}{%
  \unskip%
  \IfValueTF{#1}{\@foot@note[#1]}{\@foot@note}{\ignorespaces#2}%
}
%    \end{macrocode}
% \end{macro}

% \subsection{References}
%
% \begin{macro}{\ref}
% Adjust "\ref"\marg{key} in order to prevent preceding line breaks.
% Keep it robust, so that it is written unexpanded to auxiliary files.
%    \begin{macrocode}
\AtBeginDocument{%
  \NewCommandCopy\hep@ref\ref
  \DeclareRobustCommand*\ref{\no@break@before\hep@ref}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\eqref}
% Adjust "\eqref"\marg{key} from the \software{amsmath} package in order to prevent preceding line breaks.
%    \begin{macrocode}
\AtBeginDocument{\@ifpackageloaded{amsmath}{%
  \DeclareRobustCommand*\eqref{\no@break@before\labelcref}%
}{}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\usecommand}
% Define the "\usecommand" macro providing an anonymous function.
%    \begin{macrocode}
\providecommand*\hep@use@command{}
\newcommand*\usecommand[2][1]{%
  \renewcommand*\hep@use@command[#1]{#2}\hep@use@command%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\textlabel}
% Define the "\textlabel" macro allowing to link to a piece of text using the \software{etoolbox} pcakage \cite{etoolbox}.
% The label is also written in the form of \software{cleveref}, with the type "textlabel" and a value that grows by two with every text label, so that "\cref" lists several text labels in the order of the document without combining them into ranges.
%    \begin{macrocode}
\RequirePackage{etoolbox}
\newcount\hep@textlabel
\NewDocumentCommand\textlabel{O{}mO{}m}{%
  \global\advance\hep@textlabel\tw@
  \protected@write\@auxout{}{%
    \string\newlabel{#2}{%
      {\protecting{#1{#4}}}{\thepage}{#4}{#2}{}%
    }%
    \string\newlabel{#2@cref}{%
      {[textlabel][\the\hep@textlabel][]\protecting{#1{#4}}}%
      {[1][\arabic{page}][]\thepage}{}{}{}%
    }%
  }%
  \hypertarget{#2}{}%
  {#3{#4}}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\cref}
% Improve reference using the \software{cleveref} package \cite{cleveref}.
% It must be loaded after \software{amsmath} \cite{amsmath}, so load that first.
%    \begin{macrocode}
\RequirePackage{amsmath}
\PassOptionsToPackage{noabbrev, nameinlink}{cleveref}
\RequirePackage{cleveref}
\newcommand*{\creflastconjunction}{, and\nobreakspace}
\crefname{enumi}{point}{points}
\crefname{inlinelisti}{point}{points}
%    \end{macrocode}
% \end{macro}
%
% References to text labels consist of the text alone.
%    \begin{macrocode}
\crefformat{textlabel}{#2#1#3}
\Crefformat{textlabel}{#2#1#3}
\crefmultiformat{textlabel}{#2#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\Crefmultiformat{textlabel}{#2#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
%    \end{macrocode}
%
%\begin{macro}{\no@break@before}
%\begin{macro}{\hep@space@width}
% Define a macro able to prevent line breaks.
% A preceding inter-word space becomes a non-breaking space.
% Wider skips, such as "\quad", are kept, so only a skip that is not wider than the widest inter-word space of the current font is replaced.
% That is its width after a sentence, or the "\spaceskip" or "\xspaceskip" if they are set and wider.
%    \begin{macrocode}
\newdimen\hep@space@width
\newcommand*\no@break@before{%
  \relax\ifvmode\else%
    \ifhmode%
      \ifdim\lastskip > 0pt%
        \hep@space@width\dimexpr\fontdimen2\font+\fontdimen7\font\relax%
        \ifdim\spaceskip>\hep@space@width\hep@space@width\spaceskip\fi%
        \ifdim\xspaceskip>\hep@space@width\hep@space@width\xspaceskip\fi%
        \ifdim\lastskip>\hep@space@width\else%
          \unskip\nobreakspace%
        \fi%
      \fi%
    \fi%
  \fi%
}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\subref}
% Adjust "\subref"\marg{key} from the \software{subcaption} package in order to prevent preceding line breaks.
%    \begin{macrocode}
\AtBeginDocument{\@ifpackageloaded{subcaption}{%
  \NewCommandCopy\hep@subref\subref
  \DeclareRobustCommand*\subref{\no@break@before\hep@subref}%
  \renewcommand*\subcaption@ref[2]{\begingroup%
    \caption@setoptions{sub}%
    \subcaption@reffmt\p@subref{\hep@ref#1{sub@#2}}%
  \endgroup}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\subcref}
% Provide the "\subcref" macro.
%    \begin{macrocode}
  \newcommand*{\subcref}[1]{\cref{sub@#1}}
}{}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\eqcrefname}
% Define the "\eqcrefname" macro for named equation types.
%    \begin{macrocode}
\NewDocumentCommand{\eqcrefname}{mmo}{%
  \crefname{#1}{#2}{\IfValueTF{#3}{#3}{#2s}}%
  \creflabelformat{#1}{##2(##1)##3}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\labelcrefrange}
% Define the missing "\labelcrefrange"\marg{key1}\marg{key2} macro.
%    \begin{macrocode}
\DeclareRobustCommand{\labelcrefrange}[2]{%
  \@crefrangenostar{labelcref}{#1}{#2}%
}
%    \end{macrocode}
% \end{macro}
%
% Adjust the title page
%    \begin{macrocode}
\AtBeginDocument{\@ifpackageloaded{hep-title}{%
  \labelcrefmultiformat{affiliation}{#2#1#3}{%
    \textsuperscript,#2#1#3}{\textsuperscript,#2#1#3%
  }{%
    \textsuperscript,#2#1#3%
  }
  \labelcrefrangeformat{affiliation}{#3#1#4\textsuperscript{--}#5#2#6}
}{}}
%    \end{macrocode}

