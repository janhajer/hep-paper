% Compute the paper height with \software{l3fp}, which accepts fractions as well as decimal ratios.
% The height is truncated to scaled points, like an integer multiplication followed by a division.
%    \begin{macrocode}
\setlength{\@tempdima}{\heptalk@paperwidth}
\ExplSyntaxOn
\edef\heptalk@paperheight{%
  \fp_eval:n { trunc ( \@tempdima * ( \heptalk@ratio ) / 1sp ) } sp%
}
\ExplSyntaxOff
%    \end{macrocode}
% Reset the paper geometry.
%    \begin{macrocode}
\RequirePackage{geometry}
\geometry{
  reset,
  paperwidth=\heptalk@paperwidth,
  paperheight=\heptalk@paperheight,
  margin=0pt,
  ignoreheadfoot,
  bottom=.02\paperwidth
}
%    \end{macrocode}

% \section{Lengths}
