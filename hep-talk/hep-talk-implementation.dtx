% \begin{macro}{\maketitle}
% The "\maketitle" macro.
% Wide slides get less space above the title, so that the logos stay on the page.
%    \begin{macrocode}
\AtBeginDocument{%
  \ifdim\paperheight<.7\paperwidth
    \def\hep@title@skip{3ex}%
  \else
    \def\hep@title@skip{10ex}%
  \fi
}
%    \end{macrocode}
% The title slide
%    \begin{macrocode}
\renewcommand*{\maketitle}{%
  \newframe%
  \strut\par\vspace{\hep@title@skip}\bgroup%
    \leftskip=\titlemargin
    \rightskip=\titlemargin
    {\Huge\hep@title@font\thetitle\par}%
    \vspace{.5ex}%
    \@ifundefined{hep@sub@title}{}%
      {\Large\hep@subtitle@font\hep@sub@title}\par%
    \vspace{3ex}%
    {\huge\hep@author@font\@author\vspace{1ex}\par}
    \vspace{3ex}%
    \normalsize\hep@date@font\@date\par%
    \vspace{3ex}%
    \@ifundefined{hep@logo}{}{%
      \hep@pre@logo\hep@logo\hep@post@logo\par%
    }%
  \egroup%
}
