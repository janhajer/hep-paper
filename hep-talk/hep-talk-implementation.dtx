% \begin{macro}{slide}
% Define a "slide" macro that starts a new frame with overlays.
% The overlays save the page counter when they start and restore it for every step, so clear the page first.
% Then all steps of a slide share its page number and the next slide continues from there.
%    \begin{macrocode}
\newenvironment{slide}[1][]{%
  \clearpage%
  \overlays%
  \newframe[#1]%
}{%
  \endoverlays%
}
%    \end{macrocode}
% \end{macro}

% \begin{macro}{robustslide}
% \begin{macro}{\hep@robust@slide}
% Define a "robustslide" environment for fragile content such as verbatim material.
% Like the "fragileoverlays" environment of the \software{overlays} package, it writes its body verbatim to the file \meta{jobname}".vrb" using the \software{verbatim} package \cite{verbatim} and reads it back on each overlay of a "slide".
%    \begin{macrocode}
\RequirePackage{verbatim}
\newwrite\hep@slide@out
\newenvironment{robustslide}[1][]{%
  \gdef\hep@slide@title{#1}%
  \@bsphack
  \immediate\openout\hep@slide@out=\jobname.vrb\relax
  \let\do\@makeother\dospecials
  \catcode`\^^M\active
  \catcode`\^^I=12
  \def\verbatim@processline{%
    \immediate\write\hep@slide@out{\the\verbatim@line}%
  }%
  \verbatim@start
}{%
  \immediate\closeout\hep@slide@out
  \@esphack
  \aftergroup\hep@robust@slide
}
%    \end{macrocode}
% After the end of the environment, when the category codes are restored, typeset the slide.
%    \begin{macrocode}
\newcommand*{\hep@robust@slide}{%
  \begin{slide}[\hep@slide@title]%
    \input{\jobname.vrb}%
  \end{slide}%
}
%    \end{macrocode}
% \end{macro}
% \end{macro}


