\g@addto@macro\normalsize{%
  \setlength\abovedisplayskip{0pt}%
  \setlength\abovedisplayshortskip{0pt}%
  \setlength\belowdisplayskip{1ex}%
  \setlength\belowdisplayshortskip{1ex}%
}
