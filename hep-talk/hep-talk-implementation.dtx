\newlength{\hmargin}
\setlength{\hmargin}{.0125\paperwidth}
\setlength{\leftskip}{\hmargin}
\setlength{\parindent}{0pt}
%    \end{macrocode}
% Vertical lengths
%    \begin{macrocode}
\newlength{\vmargin}
\setlength{\vmargin}{%
  .01\paperheight plus .1\paperheight minus .005\paperheight%
}
\setlength{\parskip}{\vmargin}
