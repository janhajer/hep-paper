% The citation macros below use the label macros of the author-year styles.
% Provide them for other styles, such as the default "numeric-comp" style of \software{hep-bibliography}, and provide the year of the entries.
%    \begin{macrocode}
\ExecuteBibliographyOptions{labeldateparts}
\providebibmacro*{cite:label}{%
  \iffieldundef{label}{%
    \printtext[bibhyperref]{\printfield[citetitle]{labeltitle}}%
  }{%
    \printtext[bibhyperref]{\printfield{label}}%
  }%
}
\providebibmacro*{cite:labeldate+extradate}{%
  \iffieldundef{labelyear}{}{%
    \printtext[bibhyperref]{\printlabeldateextra}%
  }%
}
\providebibmacro*{cite:shorthand}{%
  \printtext[bibhyperref]{\printfield{shorthand}}%
}
