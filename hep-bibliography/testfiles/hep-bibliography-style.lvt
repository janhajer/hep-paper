\START

\TEST{Style}{%
  \TYPE{style: \csname hepbib@style\endcsname}%
  % hep-bibliography redefines the bibliography macro cite:comp and uses
  % cite:init and the counter cbx@tempcntb in \ccite only if they exist,
  % i.e. in the numeric-comp style
  \TYPE{cite:comp \ifcsundef{abx@macro@cite:comp}{undefined}{defined},
    cite:init \ifcsundef{abx@macro@cite:init}{undefined}{defined},
    cbx@tempcntb \ifcsundef{c@cbx@tempcntb}{undefined}{defined}}%
}

\TEST{Citations}{%
  \SHOWHBOX{\cite{CMS,Collab}}%
}

\TEST{Clever citations}{%
  \SHOWHBOX{\ccite{CMS}}%
  \SHOWHBOX{\ccite[p.~1]{CMS,Collab}}%
  \SHOWHBOX{\Ccite{CMS}}%
}

\END
