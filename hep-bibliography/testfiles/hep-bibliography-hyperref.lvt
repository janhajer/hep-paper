% Print single bibliography macros and entries
\DeclareCiteCommand{\citeauthormacro}
  {}{\usebibmacro{author/translator+others}}{\multicitedelim}{}
\DeclareCiteCommand{\citeinmacro}
  {}{\usebibmacro{in:}}{\multicitedelim}{}
\DeclareCiteCommand{\citedoimacro}
  {}{\usebibmacro{doi+eprint+url}}{\multicitedelim}{}
% The bibliography is enclosed in the braces of a \vbox (report numbers
% used to break it there)
\newcommand*{\PRINTENTRY}[1]{%
  \defbibcheck{hep-test}{\iffieldequalstr{entrykey}{#1}{}{\skipentry}}%
  \SHOWVBOX{\printbibliography[heading=none, check=hep-test]}%
}

\begin{document}
% Load the fonts
\setbox0\vbox{\printbibliography\small\texttt{x}\textsc{x}$x$}
% Allocate the segment counter of the second refsection here, so that its
% engine-dependent register number is not recorded.
\makeatletter\expandafter\newcount\csname blx@maxsegment@1\endcsname\makeatother
\START

\TEST{Citations and links to the bibliography}{%
  \SHOWHBOX{\cite{Planck,CMS}}%
  \TYPE{first citation: Planck \csname hep@backref@0@Planck\endcsname,
    CMS \csname hep@backref@0@CMS\endcsname}%
  \SHOWHBOX{\cite{CMS}}%
  \TYPE{first citation: CMS \csname hep@backref@0@CMS\endcsname}%
}

\TEST{Clever citations}{%
  \SHOWHBOX{\ccite{Collab}}%
  \SHOWHBOX{\ccite{Collab,Cacciari}}%
  \SHOWHBOX{\Ccite{Collab}}%
}

\TEST{Bibliography entry: collaboration, report numbers, journal}{%
  \PRINTENTRY{CMS}%
}

\TEST{Bibliography entry: erratum}{%
  \PRINTENTRY{Cacciari}%
}

\TEST{Collaboration instead of author}{%
  \SHOWHBOX{\citeauthormacro{Collab}}%
  \SHOWHBOX{\citeauthormacro{Cacciari}}%
}

\TEST{No In: without journal}{%
  \SHOWHBOX{\citeinmacro{NoJournal}}%
  \SHOWHBOX{\citeinmacro{Collab}}%
}

\TEST{Page numbers without leading zeros}{%
  \SHOWHBOX{\citefield{Collab}[pages]{pages}}%
  \SHOWHBOX{\citefield{Cacciari}[pages]{pages}}%
  \SHOWHBOX{\citefield{Erratum}[pages]{pages}}%
  \SHOWHBOX{\citefield{CMS}[pages]{pages}}%
}

\TEST{URL and PubMed}{%
  \SHOWHBOX{\citedoimacro{PubMed}}%
  \SHOWHBOX{\citedoimacro{Url}}%
}

\TEST{Bibliography entry: URL and PubMed}{%
  \PRINTENTRY{PubMed}%
}

\TEST{Eprint types}{%
  \SHOWHBOX{\citedoimacro{GitHub}}%
  \SHOWHBOX{\citedoimacro{GitLab}}%
  \SHOWHBOX{\citedoimacro{Bitbucket}}%
  \SHOWHBOX{\citedoimacro{Launchpad}}%
  \SHOWHBOX{\citedoimacro{SourceForge}}%
  \SHOWHBOX{\citedoimacro{HEPForge}}%
  \SHOWHBOX{\citedoimacro{CTAN}}%
  \SHOWHBOX{\citedoimacro{CDS}}%
  \SHOWHBOX{\citedoimacro{HEPData}}%
}

\TEST{online and email}{%
  \SHOWHBOX{\online{https://example.org}{example.org}}%
  \SHOWHBOX{\email{name@example.org}}%
  \PDFSTRING{Text \cite{CMS}}%
  \PDFSTRING{Text \online{https://example.org}{example.org}}%
  \PDFSTRING{Text \email{name@example.org}}%
  \PDFSTRING{Text \nolinkurl{example.org}}%
}

\TEST{commalist}{%
  \SHOWHBOX{\begin{commalist}\item a\end{commalist}}%
  \SHOWHBOX{\begin{commalist}\item a \item b\end{commalist}}%
  \SHOWHBOX{\begin{commalist}\item a \item b \item c\end{commalist}}%
  \SHOWHBOX{\begin{commalist}[.]\item a \item b\end{commalist}}%
  \SHOWHBOX{\begin{commalist}lost \item a\end{commalist}}%
}

% Kept last, since it changes the counters of biblatex
\TEST{Second refsection: first citation, zero page, eprint without class}{%
  \begin{refsection}%
    \setbox0\hbox{\cite{CMS}}%
    \TYPE{refsection 1: CMS \csname hep@backref@1@CMS\endcsname}%
    \SHOWHBOX{\citefield{Zero}[pages]{pages}}%
    \SHOWHBOX{\citedoimacro{GitHubNoClass}}%
  \end{refsection}%
  \TYPE{refsection 0: CMS \csname hep@backref@0@CMS\endcsname}%
}
\END
