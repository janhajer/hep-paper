\bibliography{\jobname}

\DeclareCiteCommand{\citedoimacro}
  {}{\usebibmacro{doi+eprint+url}}{\multicitedelim}{}
% The bibliography is enclosed in the braces of a \vbox (report numbers
% used to break it there)
\newcommand*{\PRINTENTRY}[1]{%
  \defbibcheck{hep-test}{\iffieldequalstr{entrykey}{#1}{}{\skipentry}}%
  \SHOWVBOX{\printbibliography[heading=none, check=hep-test]}%
}

\begin{document}
% Load the fonts
\setbox0\vbox{\printbibliography\small\texttt{x}\textsc{x}$x$}
\START

\TEST{Package options and settings}{%
  \TYPE{biblatex: \csname @ifpackageloaded\endcsname{biblatex}{yes}{no},
    style: \csname hepbib@style\endcsname,
    hyperref: \csname @ifpackageloaded\endcsname{hyperref}{yes}{no}}%
}

\TEST{Citations without hyperref}{%
  \SHOWHBOX{\cite{CMS,Collab}}%
  \SHOWHBOX{\ccite{CMS}}%
  \SHOWHBOX{\Ccite{CMS,Collab}}%
}

\TEST{Bibliography entry without hyperref}{%
  \PRINTENTRY{CMS}%
}

\TEST{URL, PubMed and eprints without hyperref}{%
  \SHOWHBOX{\citedoimacro{PubMed}}%
  \SHOWHBOX{\citedoimacro{GitHub}}%
  \SHOWHBOX{\citedoimacro{HEPForge}}%
}

\TEST{Report numbers in a citation inside braces}{%
  \SHOWHBOX{{\citefield{CMS}[reportnumber]{reportnumber}}}%
}

\TEST{online and email without hyperref}{%
  \SHOWHBOX{\online{https://example.org}{example.org}}%
  \SHOWHBOX{\email{name@example.org}}%
}

\END
