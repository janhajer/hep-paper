% Only recorded in the .bcf file for biber
\bibliography{\jobname}
\makeatletter
% \DEFINED{list of control sequence names}
\newcommand*{\DEFINED}[1]{%
  \@for\hep@test@name:=#1\do{%
    \TYPE{\hep@test@name: \expandafter\ifx
      \csname\hep@test@name\endcsname\relax undefined\else defined\fi}%
  }%
}
\makeatother
\begin{document}
% Load the fonts
\setbox0\vbox{\printbibliography}
\START
\makeatletter

\TEST{Options: authoryear style, date scheme after the class}{%
  \TYPE{style: \hepcv@bibliography}%
  \TYPE{date: \ifhepcv@date true\else false\fi}%
  \DEFINED{Jan,Jul,hep@month}%
}

\TEST{Bibliography: tabulars are closed and not overfull}{%
  \setbox0\vbox{\printbibliography[heading=none]}%
  \TYPE{bibliography done}%
  \begingroup
    \hepcv@datefalse
    \setbox0\vbox{\printbibliography[heading=none]}%
  \endgroup
  \TYPE{bibliography without date scheme done}%
}

\TEST{Bibliography: entry width}{%
  \defbibcheck{hep-test}{\iffieldequalstr{entrykey}{Years}{}{\skipentry}}%
  \letbibmacro{hep-test-finentry}{finentry}%
  \renewbibmacro{finentry}{%
    \usebibmacro{hep-test-finentry}%
    \TYPE{main: \the\hep@main@width, line: \the\linewidth,
      itemindent: \the\itemindent, left: \the\hep@left@width,
      separator: \the\hep@seperator@width}%
  }%
  \setbox0\vbox{\printbibliography[heading=none, check=hep-test]}%
}

\makeatother
\END
