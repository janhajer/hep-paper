% hep-cv-bibliography with the authoryear style and the date option,
% loaded after the hep-cv class (which loads hep-cv without date): each
% entry is a two-column tabular that is closed again and fills the line.
\input{regression-test}
\documentclass{hep-cv}
\usepackage[bibliography=authoryear, date]{hep-cv-bibliography}
\input{hep-regression}

