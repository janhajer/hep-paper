% hep-cv-bibliography: which helpers, bibliography environments and
% headings are defined after loading the package.
\input{regression-test}
\documentclass{article}
\usepackage{hep-cv-bibliography}
\input{hep-regression}

% Biber does not run in the tests: fake its output. The .bbl file has been
% generated by biber from the entries
%   @misc{Range, author={A. Author}, title={Range}, organization={Org},
%     location={Town}, date={2020-01/2022-06}}
%   @misc{Years, author={B. Author}, title={Years}, date={2018/2019}}
%   @misc{Open, author={C. Author}, title={Open}, date={2022-07/},
%     keywords={ongoing}}
% (hash, sorting and label source lines removed).
\begin{filecontents*}[overwrite]{\jobname.bbl}
% $ biblatex auxiliary file $
% $ biblatex bbl format version 3.3 $
% Do not modify the above lines!
%
% This is an auxiliary file used by the 'biblatex' package.
% This file may safely be deleted. It will be recreated by
% biber as required.
%
\begingroup
\makeatletter
\@ifundefined{ver@biblatex.sty}
  {\@latex@error
     {Missing 'biblatex' package}
     {The bibliography requires the 'biblatex' package.}
      \aftergroup\endinput}
  {}
\endgroup


\refsection{0}
  \datalist[entry]{ymdnt/global//global/global/global}
    \entry{Open}{misc}{}{}
      \name{author}{1}{}{%
        {{}{%
           family={Author},
           familyi={A\bibinitperiod},
           given={C.},
           giveni={C\bibinitperiod}}}%
      }
      \field{endyear}{}
      \field{month}{7}
      \field{title}{Open}
      \field{year}{2022}
      \true{enddateunknown}
      \field{dateera}{ce}
      \keyw{ongoing}
    \endentry
    \entry{Range}{misc}{}{}
      \name{author}{1}{}{%
        {{}{%
           family={Author},
           familyi={A\bibinitperiod},
           given={A.},
           giveni={A\bibinitperiod}}}%
      }
      \list{location}{1}{%
        {Town}%
      }
      \list{organization}{1}{%
        {Org}%
      }
      \field{endmonth}{6}
      \field{endyear}{2022}
      \field{month}{1}
      \field{title}{Range}
      \field{year}{2020}
      \field{enddateera}{ce}
      \field{dateera}{ce}
    \endentry
    \entry{Years}{misc}{}{}
      \name{author}{1}{}{%
        {{}{%
           family={Author},
           familyi={A\bibinitperiod},
           given={B.},
           giveni={B\bibinitperiod}}}%
      }
      \field{endyear}{2019}
      \field{title}{Years}
      \field{year}{2018}
      \field{enddateera}{ce}
      \field{dateera}{ce}
    \endentry
  \enddatalist
\endrefsection
\endinput

\end{filecontents*}
% Only recorded in the .bcf file for biber
\bibliography{\jobname}
% \CVDATE{key}: the left-column date; \CVBODY{key}: organisation, location
% and date as printed in the entry body
\DeclareCiteCommand{\CVDATE}{}{\printcvdate}{}{}
\DeclareCiteCommand{\CVBODY}{}{\usebibmacro{organization+location+date}}{}{}
\makeatletter
% \DEFINED{list of control sequence names}
\newcommand*{\DEFINED}[1]{%
  \@for\hep@test@name:=#1\do{%
    \TYPE{\hep@test@name: \expandafter\ifx
      \csname\hep@test@name\endcsname\relax undefined\else defined\fi}%
  }%
}
\makeatother
\begin{document}
% Load the fonts
\setbox0\vbox{\printbibliography\CVDATE{Range}}
\START
\makeatletter

\TEST{Loaded packages}{%
  \DEFINED{ver@hep-cv.sty,ver@biblatex.sty}%
  \TYPE{style: \ifdefined\blx@bbxfile\blx@bbxfile\else undefined\fi}%
}

\TEST{Helper macros}{%
  \DEFINED{setlengths,printcvdate,printindex,printissuedate,%
    adjustOrgLocDat,cleardate,Jan,mkbibshortyear}%
}

\TEST{Bibliography environments and headings}{%
  \DEFINED{blx@env@unnumbered,blx@env@numbered,blx@env@starrednumbered,%
    blx@head@section,blx@head@subsection,blx@head@subsubsection}%
}

\TEST{printcvdate: formatted end month, no space without end month}{%
  \SHOWHBOX{\CVDATE{Range}}%
  \SHOWHBOX{\CVDATE{Years}}%
  \SHOWHBOX{\CVDATE{Open}}%
}

\TEST{cleardate: no date in organization+location+date}{%
  \SHOWHBOX{\CVBODY{Range}}%
  \SHOWHBOX{\cleardate\CVBODY{Range}}%
}

\makeatother
\END
