% hep-cv-bibliography with the date option, passed on to hep-cv: month
% macros and short years in the left-column dates, also for open ranges.
\input{regression-test}
\documentclass{article}
\usepackage[date]{hep-cv-bibliography}
\input{hep-regression}

% Biber does not run in the tests: fake its output. The .bbl file has been
% generated by biber from the entries
