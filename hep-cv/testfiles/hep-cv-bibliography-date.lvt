% Only recorded in the .bcf file for biber
\bibliography{\jobname}
% \CVDATE{key}: the left-column date
\DeclareCiteCommand{\CVDATE}{}{\printcvdate}{}{}
\makeatletter
% \DEFINED{list of control sequence names}
\newcommand*{\DEFINED}[1]{%
  \@for\hep@test@name:=#1\do{%
    \TYPE{\hep@test@name: \expandafter\ifx
      \csname\hep@test@name\endcsname\relax undefined\else defined\fi}%
  }%
}
\makeatother
\begin{document}
% Load the fonts
\setbox0\vbox{\printbibliography\CVDATE{Range}}
\START
\makeatletter

\TEST{The date option is passed on to hep-cv}{%
  \TYPE{hep-cv options: \csname opt@hep-cv.sty\endcsname}%
  \TYPE{date: \ifhepcv@date true\else false\fi}%
  \DEFINED{Jan,Jun,Jul,mkbibshortyear}%
}

\TEST{Short years}{%
  \TYPE{[\mkbibshortyear{2022}]}%
  \TYPE{[\mkbibshortyear{}]}%
}

\TEST{printcvdate with month macros and short years}{%
  \SHOWHBOX{\CVDATE{Range}}%
  \SHOWHBOX{\CVDATE{Years}}%
}

\TEST{printcvdate: open-ended range}{%
  \SHOWHBOX{\CVDATE{Open}}%
}

\makeatother
\END
