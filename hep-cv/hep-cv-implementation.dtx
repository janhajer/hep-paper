% \begin{macro}{\Oct}
% \begin{macro}{\Nov}
% \begin{macro}{\Dec}
% Apply macros of equally distributed month names.
% They are robust and print the plain month name in PDF strings such as bookmarks.
%    \begin{macrocode}
\newrobustcmd*{\Jan}{\hep@month{Jan}}%
\newrobustcmd*{\Feb}{\hep@month{Feb}}%
\newrobustcmd*{\Mar}{\hep@month{Mar}}%
\newrobustcmd*{\Apr}{\hep@month{Apr}}%
\newrobustcmd*{\May}{\hep@month{May}}%
\newrobustcmd*{\Jun}{\hep@month{Jun}}%
\newrobustcmd*{\Jul}{\hep@month{Jul}}%
\newrobustcmd*{\Aug}{\hep@month{Aug}}%
\newrobustcmd*{\Sep}{\hep@month{Sep}}%
\newrobustcmd*{\Oct}{\hep@month{Oct}}%
\newrobustcmd*{\Nov}{\hep@month{Nov}}%
\newrobustcmd*{\Dec}{\hep@month{Dec}}%
\AtBeginDocument{%
  \ifdefined\pdfstringdefDisableCommands
    \pdfstringdefDisableCommands{%
      \def\Jan{Jan}\def\Feb{Feb}\def\Mar{Mar}\def\Apr{Apr}%
      \def\May{May}\def\Jun{Jun}\def\Jul{Jul}\def\Aug{Aug}%
      \def\Sep{Sep}\def\Oct{Oct}\def\Nov{Nov}\def\Dec{Dec}%
    }%
  \fi
}%
