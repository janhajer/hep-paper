% \begin{macro}{begentry}
% \begin{macro}{finentry}
% Ensure that the "date" is printed in the left column of the \CV.
% Each entry is a two-column tabular, which starts at the left margin and fills the line.
% It is opened in "begentry" and closed in "finentry".
%    \begin{macrocode}
  \renewbibmacro{begentry}{%
    \hep@set@main@width
    \addtolength{\hep@main@width}{-\itemindent}%
    \begin{tabular}{%
      @{}>{\raggedleft\arraybackslash}p{\hep@left@width}%
      @{\hspace{\hep@seperator@width}}p{\hep@main@width}@{}%
    }%
    \ifhepcv@date
      \iffieldundef{month}{}{\printfield{month}\space}%
      \iffieldundef{year}{}{\printfield{year}}%
      \iffieldundef{endyear}{}{%
        --\iffieldundef{endmonth}{}{\printfield{endmonth}\space}%
        \printfield{endyear}%
      }%
    \else
      \printdate%
    \fi &%
  }
  \renewbibmacro{finentry}{\finentry\end{tabular}}
\fi
%    \end{macrocode}
% \end{macro}
