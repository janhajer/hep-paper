% The month macros are defined by "\hep@date@setup".
% It is called below with the "date" option and by \software{hep-cv-bibliography} if that package receives the "date" option after \software{hep-cv} has been loaded without it.
%    \begin{macrocode}
\RequirePackage{etoolbox}
\newcommand*{\hep@date@setup}{%
%    \end{macrocode}
%
% \begin{macro}{\hep@longest@month}
% \begin{macro}{\hep@spread@even}
% \begin{macro}{\hep@month}
% Define macros of equally distributed month names.
% The width of the longest month name is measured each time in the current font.
%    \begin{macrocode}
\newlength{\hep@longest@month}%
\newcommand*{\hep@spread@even}[1]{\@tfor\next:=##1\do{\hfil\next}}%
\newcommand*{\hep@month}[1]{%
  \settowidth{\hep@longest@month}{May}%
  \makebox[\hep@longest@month][c]{\hep@spread@even{##1}}%
}%
