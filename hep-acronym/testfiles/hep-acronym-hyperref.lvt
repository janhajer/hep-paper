\input{regression-test}
\documentclass{article}
\usepackage{hyperref}
\usepackage{hep-acronym}
\usepackage{glossary-list}% not needed, but must not interfere

% Every kind of acronym declaration
\acronym{PDF}{portable document format}
\acronym{URL}{uniform resource locator}
\acronym*{QCD}{quantum chromodynamics}
\acronym[LHCb]{LHCB}{large hadron collider beauty}
\acronym{CM}*{computer modern}
\acronym{EW}{electroweak}[electroweak]
\acronym[\textsc{lhc}]{LHC}{large hadron collider}
\acronym{API}{application programming interface}
\acronym{BSM}{beyond the standard model}
\shortacronym{SM}{standard model}
\longacronym{EFT}{effective field theory}[effective field theories]
\acronymalternative{PDF}{PDFalt}{printable document format}

% Pretend that the acronyms have been used several times in the previous run,
% so that the entry-count feature does not reduce them to their long form.
\makeatletter
\@for\hep@test@label:=PDF,URL,QCD,LHCB,LHC,CM,EW,API\do{%
  \@gls@entry@count{\hep@test@label}{5}%
}
% BSM was used only once: \BSM always prints the long form.
\@gls@entry@count{BSM}{1}
\makeatother

% Helpers \PDFSTRING, \SECTIONBOOKMARKS, \PDFINFO etc.
\input{hep-regression}

% The contents lines that hyperref writes for
% \section{\PDF ...}, \section{\PDFlong ...} etc.
\begin{filecontents*}[overwrite]{\jobname.toc}
\contentsline {section}{\numberline {1}\PDF {} at the beginning}{1}{section.1}%
\contentsline {section}{\numberline {2}\PDFlong {} at the beginning}{1}{section.2}%
\contentsline {section}{\numberline {3}The \URL {} in the middle}{1}{section.3}%
\contentsline {section}{\PDF {} starred}{1}{section*.1}%
\contentsline {section}{\numberline {4}\BSM {} used once}{1}{section.4}%
\contentsline {section}{\numberline {5}\PDFfirst {} and \resetacronym {URL}}{1}{section.5}%
\end{filecontents*}
\begin{filecontents*}[overwrite]{\jobname.lof}
\contentsline {figure}{\numberline {1}{\ignorespaces \QCD {} in a caption\relax }}{1}{figure.1}%
\end{filecontents*}

