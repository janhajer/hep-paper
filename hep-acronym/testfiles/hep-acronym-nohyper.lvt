  \SECTIONBOOKMARKS{%
    \section{\PDFlong at the beginning}%
    \section*{\PDFlong starred}%
    \addcontentsline{toc}{section}{\PDFlong starred}%
    \hypersetup{bookmarksnumbered}%
    \section{\PDFlong numbered}%
  }%
}
\TEST{No links with hyper=false}{%
  \setbox0\hbox{\PDF{} and \PDF}\showbox0
}
