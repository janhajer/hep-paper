% \begin{macro}{\hep@alternative}
% Execute \marg{code} with the long form and the description of the abbreviation \marg{label} replaced by its "useri" field.
% The \software{glossaries-extra} abbreviation styles read these fields directly.
% The original fields are restored afterwards, before any spacing code is executed.
%    \begin{macrocode}
\newrobustcmd*{\hep@alternative}[2]{%
  \csletcs{hep@alternative@long}{glo@\glsdetoklabel{#1}@long}%
  \csletcs{hep@alternative@desc}{glo@\glsdetoklabel{#1}@desc}%
  \csletcs{glo@\glsdetoklabel{#1}@long}{glo@\glsdetoklabel{#1}@useri}%
  \csletcs{glo@\glsdetoklabel{#1}@desc}{glo@\glsdetoklabel{#1}@useri}%
  #2%
  \csletcs{glo@\glsdetoklabel{#1}@long}{hep@alternative@long}%
  \csletcs{glo@\glsdetoklabel{#1}@desc}{hep@alternative@desc}%
}
%    \end{macrocode}
% \end{macro}
