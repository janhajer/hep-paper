%<*package>
%
% Define a hepacronym namespace for the options using the \software{kvoptions} package \cite{kvoptions}.
%    \begin{macrocode}
\RequirePackage{kvoptions}
\SetupKeyvalOptions{
  family=hepacronym,
  prefix=hepacronym@
}
%    \end{macrocode}
%
% \begin{macro}{hyper}
% Define the "hyper" option controlling the hyperlink to the first appearance of the acronyms.
%    \begin{macrocode}
\DeclareBoolOption[true]{hyper}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{titlesec}
% Define the "titlesec" option controlling whether section titles are treated as sentences.
% The \software{KOMA-Script} classes, which define "\KOMAClassName", have their own sectioning code, which \software{titlesec} does not support.
% For them the option is false unless it is set explicitly.
%    \begin{macrocode}
\@ifundefined{KOMAClassName}{%
  \DeclareBoolOption[true]{titlesec}%
}{%
  \DeclareBoolOption[false]{titlesec}%
}
%    \end{macrocode}
% \end{macro}
%
% Process options.
%    \begin{macrocode}
\ProcessKeyvalOptions*
%    \end{macrocode}
%
% Load the base package \cite{glossaries, glossaries-extra} and set the abbreviation style.
%    \begin{macrocode}
\PassOptionsToPackage{nostyles}{glossaries-extra}
\RequirePackage{glossaries-extra}
% \setabbreviationstyle{long-hyphen-short-hyphen}
%    \end{macrocode}
% Use the entry count feature.
%    \begin{macrocode}
\glsenableentrycount
\glssetcategoryattribute{abbreviation}{entrycount}{1}
%    \end{macrocode}
% Provide macros for older "glossaries-extra" installations.
%    \begin{macrocode}
\AtBeginDocument{
  \@ifpackageloaded{hyperref}{
    \providecommand*{\glsxtrusefield}[2]{\@gls@entry@field{#1}{#2}}
    \providecommand*{\glsxtrsetfieldifexists}[3]{\glsdoifexists{#1}{#3}}
    \providecommand*{\gGlsXtrSetField}[3]{%
      \glsxtrsetfieldifexists{#1}{#2}{%
        \csgdef{glo@\glsdetoklabel{#1}@#2}{#3}%
      }%
    }
%    \end{macrocode}
% Set hyperlinks from the abbreviation to their definition in the text.
%    \begin{macrocode}
    \glssetcategoryattribute{abbreviation}{nohyperfirst}{true}
    \renewcommand*{\glsdonohyperlink}[2]{{%
      \glsxtrprotectlinks\edef\fieldvalue{%
        \glsxtrusefield{\glslabel}{hastarget}%
      }%
      \ifdefstring\fieldvalue{true}{#2}{%
        \gGlsXtrSetField{\glslabel}{hastarget}{true}%
        \glsdohypertarget{#1}{#2}%
      }%
    }}
  }{}
}
%    \end{macrocode}
%
% \begin{macro}{\hep@disable}
% \begin{macro}{\hep@pdf@definitions}
% Collect the \PDF-string definitions of the acronym macros in a macro that \software{hyperref} executes before it converts a string.
% This works independently of the order in which the packages are loaded and also for acronyms declared in the document body.
%    \begin{macrocode}
\newcommand*{\hep@pdf@definitions}{}
\newcommand*{\hep@disable}[1]{\g@addto@macro\hep@pdf@definitions{#1}}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\hep@pdf@define}
% Define the \PDF string \marg{text}\marg{space} of the acronym macro with name \marg{name}.
% The \meta{space} is either empty or "\xspace", which \software{hyperref} supports in \PDF strings.
% The capitalised variant is stored under the detokenised macro name and used at the beginning of a \PDF string.
% Plain text has no small capitals, so "\textsc" becomes upper case.
%    \begin{macrocode}
\newcommand*{\hep@pdf@define}[3]{%
  \def\hep@pdf@text{#2}%
  \hep@pdf@uppercase@sc
  \begingroup
    \edef\hep@temp{\endgroup
      \noexpand\hep@disable{%
        \noexpand\@namedef{#1}{\unexpanded\expandafter{\hep@pdf@text#3}}%
      }%
      \global\noexpand\@namedef{hep@pdf@cap@\@backslashchar#1 }{%
        \noexpand\MFUsentencecase{\unexpanded\expandafter{\hep@pdf@text}}%
        \unexpanded{#3}%
      }%
    }%
  \hep@temp
}
\ExplSyntaxOn
\cs_new_protected:Npn \hep@pdf@uppercase@sc
  {
    \regex_replace_all:nnN
      { \c{textsc} } { \c{text_uppercase:n} } \hep@pdf@text
  }
\ExplSyntaxOff
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@pdf@sentence}
% In \PDF strings, "\sentence" capitalises the following acronym macro.
% Other expandable tokens in front of it, such as the conditionals that \software{titlesec} puts in front of the section titles, "\numberline" or "\textbf", are expanded first.
% Any other token ends the sentence beginning, and so does "\@empty", which "\pdfstringdef" places at the end of every string.
%    \begin{macrocode}
\ExplSyntaxOn
\cs_new:Npn \hep@pdf@sentence #1
  {
    \cs_if_exist:cTF { hep@pdf@cap@ \tl_to_str:n {#1} }
      { \use:c { hep@pdf@cap@ \tl_to_str:n {#1} } }
      {
        \bool_lazy_all:nTF
          {
            { \tl_if_single_token_p:n {#1} }
            { \token_if_expandable_p:N #1 }
            { ! \token_if_eq_meaning_p:NN #1 \@empty }
          }
          { \exp_after:wN \hep@pdf@sentence #1 }
          {#1}
      }
  }
\ExplSyntaxOff
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@pdf@numberline}
% In the standard classes, the bookmarks of sectioning commands begin with "\protect" followed by "\numberline"\marg{number}.
% Skip "\protect", which is not expandable here, and treat the text after the number as the beginning of a sentence.
%    \begin{macrocode}
\@namedef{hep@pdf@cap@\@backslashchar protect }{\sentence}
\newcommand*{\hep@pdf@numberline}[1]{\hep@pdf@@numberline{#1}\sentence}
\hep@disable{%
  \let\hep@pdf@@numberline\numberline
  \let\numberline\hep@pdf@numberline
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\pdfstringdef}
% Once \software{hyperref} is loaded, register the \PDF-string definitions and treat every \PDF string, \eg a bookmark, as the beginning of a sentence.
% The "\@empty" ensures that "\sentence" has an argument.
%    \begin{macrocode}
\newcommand*{\hep@pdf@register}{%
  \@ifpackageloaded{hyperref}{%
    \pdfstringdefDisableCommands{\hep@pdf@definitions}%
    \global\let\hep@pdfstringdef\pdfstringdef
    \gdef\pdfstringdef##1##2{\hep@pdfstringdef##1{\sentence##2\@empty}}%
    \global\let\hep@pdf@register\relax
  }{}%
}
\hep@pdf@register
\AtBeginDocument{\hep@pdf@register}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hyper@link}
% \begin{macro}{\hyper@linkurl}
% \begin{macro}{\hyper@linkfile}
% Acronyms in the text of a link, \eg of "\href" or "\hyperlink", do not link to their first use, since links cannot be nested.
% The drivers of \software{hyperref} define these macros, so they are wrapped at the end of "\begin{document}".
%    \begin{macrocode}
\AddToHook{begindocument/end}{%
  \@ifpackageloaded{hyperref}{%
    \let\hep@hyper@link\hyper@link
    \def\hyper@link#1#2#3{\hep@hyper@link{#1}{#2}{{\glsdisablehyper#3}}}%
    \let\hep@hyper@linkurl\hyper@linkurl
    \def\hyper@linkurl#1#2{\hep@hyper@linkurl{{\glsdisablehyper#1}}{#2}}%
    \let\hep@hyper@linkfile\hyper@linkfile
    \def\hyper@linkfile#1#2#3{%
      \hep@hyper@linkfile{{\glsdisablehyper#1}}{#2}{#3}%
    }%
  }{}%
}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
%
% Ignore only hyperref's "math shift" PDF-string warning.
%    \begin{macrocode}
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \let\hep@HyPsd@CatcodeWarning\HyPsd@CatcodeWarning
    \renewcommand*{\HyPsd@CatcodeWarning}[1]{%
      \ifstrequal{#1}{math shift}{}{%
        \hep@HyPsd@CatcodeWarning{#1}%
      }%
    }%
  }{}%
}
%    \end{macrocode}
% Deactivate hyperrefs if requested.
%    \begin{macrocode}
\ifhepacronym@hyper\else
  \glsdisablehyper
\fi
%    \end{macrocode}
%
% Load the \software{titlesec} package \cite{titlesec} in order to ensure that section headers are treated as sentences.
%    \begin{macrocode}
\ifhepacronym@titlesec\RequirePackage{titlesec}\fi
%    \end{macrocode}
%
% \begin{macro}{\begin@sentence}
% Mark the beginning of a paragraph as if it would follow a full stop using the \software{everyhook} package \cite{everyhook}.
% The space factor is a "\mathchardef" constant like "\@m", so that digits following "\sentence", for example in the label "\item[12]", do not extend the number.
%    \begin{macrocode}
\PassOptionsToPackage{excludeor}{everyhook}
\RequirePackage{everyhook}
\@ifdefinable\begin@sentence{\mathchardef\begin@sentence=1001\relax}
\newcommand*{\sentence}{\ifhmode\spacefactor=\begin@sentence\fi}
\hep@disable{\let\sentence\hep@pdf@sentence}
\PushPostHook{par}{{\sentence}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\ttl@case}
% \begin{macro}{\@hangfrom}
% Treat section titles as sentences using the \software{etoolbox} package \cite{etoolbox}.
% With \software{titlesec} its case hook "\ttl@case" marks the beginning of the title.
% Without it, the beginning of a sentence is marked after "\@hangfrom", which sets the number of displayed section headings in the standard classes, \software{amsart}, and \software{PoS}.
% Starred sections in the latter two remain lower case if \software{hyperref} is loaded, as its anchor restores the previous space factor.
%    \begin{macrocode}
\ifhepacronym@titlesec
  \gdef\ttl@case{\leavevmode\sentence}
\else
  \RequirePackage{etoolbox}
  \apptocmd{\@hangfrom}{\sentence}{}{}
\fi
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\frenchspacing}
% Adjust the "\frenchspacing" macro to be compatibel with this idea.
%    \begin{macrocode}
\def\frenchspacing{%
  \sfcode`\.\begin@sentence \sfcode`\?\begin@sentence
  \sfcode`\!\begin@sentence \sfcode`\:\begin@sentence
  \sfcode`\;\@m \sfcode`\,\@m
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@if@begin@of@sentence}
% Provide a macro checking for the beginning of a sentence by examining the length of the preceeding space.
%    \begin{macrocode}
\newcommand*{\hep@if@begin@of@sentence}[2]{\leavevmode\protecting{%
  \ifboolexpr{ test {\ifnumcomp{\spacefactor}{=}{3000}} or%
               test {\ifnumcomp{\spacefactor}{=}{2000}} or%
               test {\ifnumcomp{\spacefactor}{=}{\begin@sentence}}%
  }{#1}{#2}%
}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@starttoc}
% Typeset the table of contents and the lists of figures and tables, which all use "\@starttoc", with the short form of the acronyms.
% Their entries begin sentences.
% Acronyms are marked as used only locally, so that the lists change neither the first use nor the entry count.
% Links and link targets are deactivated, since the entries are links themselves.
%    \begin{macrocode}
\let\hep@starttoc\@starttoc
\renewcommand*{\@starttoc}[1]{%
  \begingroup
    \let\@glsunset\@glslocalunset
    \let\@glsreset\@glslocalreset
    \let\@gls@increment@currcount\@gls@local@increment@currcount
    \glslocalunsetall
    \glsdisablehyper
    \let\@glslink\@secondoftwo
    \let\glsdonohyperlink\@secondoftwo
    \let\hep@contents@line\contentsline
    \let\hep@number@line\numberline
    \renewcommand*{\contentsline}[2]{%
      \hep@contents@line{##1}{\sentence ##2}%
    }%
    \renewcommand*{\numberline}[1]{\hep@number@line{##1}\sentence}%
    \hep@starttoc{#1}%
  \endgroup
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@item@sentence}
% \begin{macro}{\hep@description@item}
% \begin{macro}{\descriptionsitem}
% Ensure that acronyms in description items get capitalised using the \software{enumitem} package \cite{enumitem}.
% The sentence-aware "\item" is installed only if it is not active yet, because in nested description lists saving the active "\item" would make it call itself.
%    \begin{macrocode}
\RequirePackage{enumitem}
\newcommand*\hep@item@sentence{\leavevmode\sentence}
\NewDocumentCommand{\hep@description@item}{o}{%
  \IfNoValueTF{#1}{%
    \hep@latex@item\hep@item@sentence
  }{%
    \hep@latex@item[\hep@item@sentence#1]\hep@item@sentence
  }%
}
\newcommand*\descriptionsitem{%
  \ifx\item\hep@description@item\else
    \let\hep@latex@item\item
    \let\item\hep@description@item
  \fi
}
\setlist[description]{before=\descriptionsitem}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\mathdef}
% Provide a macro that allows to extend a macro definition into math mode using the \software{xparse} package \cite{xparse}.
%    \begin{macrocode}
\RequirePackage{xparse}
\ProvideDocumentCommand{\mathdef}{mO{0}m}{%
  \expandafter\let\csname hep@text\string#1\endcsname=#1
  \expandafter\newcommand\expandafter*%
    \csname hep@math\string#1\endcsname[#2]{#3}
  \DeclareRobustCommand#1{%
    \ifmmode
      \expandafter\let\expandafter\next\csname%
      hep@math\string#1\endcsname%
    \else
      \expandafter\let\expandafter\next\csname%
      hep@text\string#1\endcsname%
    \fi
    \next
  }%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@if@short}
% Check whether "\cgls"\marg{label} prints the short form.
% It does not if the entry is unused or if the entry count of the previous run is one.
%    \begin{macrocode}
\newcommand*{\hep@if@short}[1]{%
  \ifglsused{#1}{%
    \ifnum\glsentryprevcount{#1}=\@ne
      \expandafter\@secondoftwo
    \else
      \expandafter\@firstoftwo
    \fi
  }{\@secondoftwo}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\acronym}
% Define the "\acronym"\meta{*}\oarg{typeset abbreviation}\marg{abbreviation}\meta{*}\marg{definition}\oarg{plural\linebreak[4] definition} macro using the \software{xspace} \cite{xspace} and \software{amstext} \cite{amstext} packages.
% \begin{enumerate}[nosep, label=\#\arabic*]
% \item star for omitting the \enquote{s} in the short plural
% \item optional typeset abbreviation
% \item mandatory abbreviation
% \item star for restoring the \hologo{TeX} default for space after text macros
% \item mandatory long form
% \item optional plural long form
% \end{enumerate}
%    \begin{macrocode}
\RequirePackage{xspace}
\RequirePackage{amstext}
\NewDocumentCommand{\acronym}{somsmo}{
  \newabbreviation[
    type=\acronymtype,
    sort=#3,
    \glsshortpluralkey=\IfBooleanTF{#1}{#3}{\IfNoValueTF{#2}{#3s}{#2s}},
    longplural=\IfNoValueTF{#6}{#5s}{#6}
  ]{#3}{\IfNoValueTF{#2}{#3}{#2}}{#5}
%    \end{macrocode}
% Provide the singular acronym macro.
%    \begin{macrocode}
