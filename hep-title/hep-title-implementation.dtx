% \begin{macro}{\placepreprint}
% \begin{macro}{\placereprint}
% Places a preprint number in the top right corner of the title page using the \software{calc} \cite{calc} and \software{atbegshi} \cite{atbegshi} packages.
% The box dimensions are measured into lengths before they enter the "\put" coordinates, because \software{calc} expressions such as "\heightof" are no longer accepted there.
%    \begin{macrocode}
\RequirePackage{calc}
\RequirePackage{atbegshi}
\newlength{\hep@box@width}
\newlength{\hep@box@height}
\newcommand*{\placepreprint}{%
  \AtBeginShipoutFirst{%
    \settowidth{\hep@box@width}{\normalfont\hep@preprint@box}%
    \settoheight{\hep@box@height}{\normalfont\hep@preprint@box}%
    \put(
      \textwidth+\oddsidemargin-\hep@box@width,
      -2pt-\topmargin-\hep@box@height
    ){\normalfont\hep@preprint@box}
  }
}
\newcommand*{\placereprint}{%
  \AtBeginShipoutFirst{%
    \settoheight{\hep@box@height}{\normalfont\hep@reprint@box}%
    \put(
      \oddsidemargin      ,
      -2pt-\topmargin-\hep@box@height
    ){\normalfont\hep@reprint@box}
  }
}
%    \end{macrocode}
% \end{macro}
