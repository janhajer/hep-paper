% \begin{macro}{\affiliation}
% Define the "\affiliation" macro, ensure that linebreaks happen after a comma.
% The penalty is robust, so that \software{authblk} stores it unexpanded and the column mode is checked when the affiliation is typeset.
% With the flexible margins of the affiliation block a break with a penalty of $-50$ has negative demerits, so on its own the comma penalty would add lines.
% Therefore each affiliation, including its label, is measured twice in the current paragraph shape: once without comma penalties and with a high "\linepenalty", which gives the smallest number of lines, and once as it is typeset.
% "\looseness" then asks for the smallest number of lines, among which the breaks after commas are preferred.
% Footnotes are dropped while measuring, so that they are not counted twice, and "\everypar" is cleared and the paragraph ends with the primitive "\par", so that the pending list item of the "center" environment is left for the affiliation itself.
%    \begin{macrocode}
\newcommand*\hep@penalty{\if@twocolumn85\else50\fi}
\newif\ifhep@affil@break\hep@affil@breaktrue
\DeclareRobustCommand*\hep@comma@penalty{%
  \ifhep@affil@break\penalty-\hep@penalty\relax\fi%
}
\newcommand*\hep@active@comma{,\hep@comma@penalty}
\newcommand*\hep@cat@comma@active{\catcode`\,\active}
{\hep@cat@comma@active\gdef,{\hep@active@comma}}
\newcount\hep@affil@lines
\newcommand\hep@affil@measure[2]{%
  \setbox\z@\vbox{%
    \let\footnote\@gobble\let\thanks\@gobble%
    \let\footnotemark\@empty%
    \everypar{}\looseness\z@\noindent%
    \if\relax#1\relax\else\theaffiliation\fi#2\@@par%
    \global\hep@affil@lines\prevgraf%
  }%
}
\DeclareRobustCommand\hep@affil@text[2]{%
  \begingroup%
    \hep@affil@measure{#1}{#2}%
    \count@\hep@affil@lines%
    \hep@affil@breakfalse\linepenalty\@m%
    \hep@affil@measure{#1}{#2}%
    \advance\count@-\hep@affil@lines%
    \count@-\count@%
  \expandafter\endgroup\expandafter\looseness\the\count@\relax%
  #2%
}
\newcommand*\hep@affil[1]{\endgroup\affil{\hep@affil@text{}{#1}}}
\def\hep@affil@opt[#1]#2{%
  \endgroup\affil[#1]{\hep@affil@text{#1}{#2}}%
}
\DeclareRobustCommand\hep@affiliation{%
  \@ifnextchar[{\hep@affil@opt}{\hep@affil}%
}
\newcommand*{\affiliation}{%
  \begingroup\hep@cat@comma@active\hep@affiliation%
}
%    \end{macrocode}
% \end{macro}
%
% Place endorser and affiliation.
% The affiliations are typeset with flexible margins, so that the line breaks after commas are preferred; this setting is local to the affiliation block.
%    \begin{macrocode}
\renewcommand*{\maketitlehookc}{%
  \hep@print@person{endorser}%
%       \\[\affilsep]
  \ifx\AB@affillist\AB@empty\else%
    \ifnum\value{affil}>\value{Maxaffil}\relax%
      \begingroup%
        \@flushglue=0pt plus .5\linewidth%
        \begin{center}\AB@affillist\end{center}%
      \endgroup%
    \fi%
  \fi%
}
%    \end{macrocode}
