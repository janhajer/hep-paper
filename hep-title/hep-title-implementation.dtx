% \subsubsection{Abstract}
%
% \begin{environment}{abstract*}
% Add a "abstract*" environment for two column mode taking also care of placing the title using the \software{environ} \cite{environ} and \software{abstract} \cite{abstract} packages.
% It is defined first, since the \software{abstract} package redefines the "abstract" environment.
%    \begin{macrocode}
\@ifundefined{abstract}{}{%
  \if@twocolumn
    \RequirePackage{environ}
    \RequirePackage{abstract}
    \renewcommand*{\abstitleskip}{-3ex}
    \NewEnviron{abstract*}{%
      \twocolumn[\maketitle\vspace{-5ex}%
      \begin{onecolabstract}\noindent\BODY\end{onecolabstract}%
      \vspace{.5cm}]\saythanks%
    }%
  \else
    \newenvironment{abstract*}{%
      \maketitle\begin{abstract}%
    }{%
      \end{abstract}%
    }
  \fi
%    \end{macrocode}
% \end{environment}
%
% \begin{environment}{abstract}
% Adjust the "abstract" environment to not start with indentation.
%    \begin{macrocode}
  \let\hep@abstract\abstract%
  \newcommand*\hep@abstract@begin{\hep@abstract\noindent\ignorespaces}%
  \let\hep@abstract@end\endabstract
  \let\hep@key@words\relax
  \newcommand*{\keywords}[1]{\def\hep@key@words{#1}}
  \AtBeginDocument{\@ifundefined{hep@key@words}{}{%
    \let\hep@end@abstract\hep@abstract@end%
    \renewcommand*\hep@abstract@end{
      \par\medskip\noindent\textit{Keywords: \hep@key@words}%
      \hep@end@abstract%
    }%
  }}
%    \end{macrocode}
%
% \begin{macro}{\ifhep@title@made}
% \begin{macro}{\hep@abstract@store}
% \begin{macro}{\hep@abstract@collect}
% Journals expect the abstract in different places: after "\maketitle" (\software{article}, \software{svjour3}), before it in the document (REV\hologo{TeX}, \software{amsart}), or in the preamble, either as environment or in the command form "\abstract"\marg{text} (\software{JHEP}, \software{JCAP}, PoS).
% Accept all of them: before the title is made the abstract is only stored, collected by the \software{environ} package \cite{environ} if it is an environment, and "\maketitle" places it after the title.
%    \begin{macrocode}
  \newif\ifhep@title@made
  \newif\ifhep@abstract@stored
  \RequirePackage{environ}
  \newcommand*\hep@abstract@name{abstract}
  \newcommand\hep@abstract@store[1]{%
    \gdef\hep@abstract@text{#1}%
    \global\hep@abstract@storedtrue
  }
  \newcommand*\hep@abstract@collect{%
    \Collect@Body\hep@abstract@store
  }
  \newif\ifhep@abstract@collecting
  \renewcommand*\abstract{%
    \ifhep@title@made
      \hep@abstract@collectingfalse
      \let\hep@abstract@next\hep@abstract@begin
    \else
      \ifx\@currenvir\hep@abstract@name
        \hep@abstract@collectingtrue
        \let\hep@abstract@next\hep@abstract@collect
      \else
        \let\hep@abstract@next\hep@abstract@store
      \fi
    \fi
    \hep@abstract@next
  }%
  \renewcommand*\endabstract{%
    \ifhep@abstract@collecting\else\hep@abstract@end\fi
  }%
  \renewcommand*\hep@abstract@place{%
    \global\hep@title@madetrue
    \ifhep@abstract@stored
      \global\hep@abstract@storedfalse
      \begin{abstract}\hep@abstract@text\end{abstract}%
    \fi
  }
}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{environment}
