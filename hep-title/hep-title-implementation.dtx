% \begin{macro}{\hep@new@setter}
% Define a macro \marg{name} that stores its argument in the macro \marg{internal}.
% The argument may contain paragraphs.
% "\def" is used, since "\newcommand" refuses names starting with "end", such as "\endorserfont".
%    \begin{macrocode}
\newcommand*\hep@new@setter[2]{%
  \expandafter\long\expandafter\def\csname#1\endcsname##1{%
    \@namedef{#2}{##1}%
  }%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@new@person}
% Define the user interface for a kind of person \marg{kind} with the line titles \marg{singular} and \marg{plural}:
% the counter \meta{kind}"s", the macro "\"\meta{kind}\oarg{label}\marg{name}, the font macros "\"\meta{kind}"font" and "\"\meta{kind}"titlefont", the title macro "\"\meta{kind}"title"\marg{singular}\marg{plural}, and the hooks "\pre"\meta{kind}, "\post"\meta{kind}, "\pre"\meta{kind}"title", and "\post"\meta{kind}"title".
% By default the line is centred and starts with the italic title, followed by a colon.
%    \begin{macrocode}
\newcommand*\hep@new@person[3]{%
  \newcounter{#1s}%
  \expandafter\let\csname hep@#1list\endcsname\AB@empty%
  \@namedef{hep@#1@sep1}{}%
  \@namedef{hep@#1@sep2}{\Authand}%
  \expandafter\NewDocumentCommand\csname#1\endcsname{O{}m}{%
    \hep@person{#1}{##1}{##2}%
  }%
  \hep@new@setter{#1font}{hep@#1@font}%
  \hep@new@setter{pre#1}{hep@pre@#1}%
  \hep@new@setter{post#1}{hep@post@#1}%
  \hep@new@setter{#1titlefont}{hep@#1@title@font}%
  \hep@new@setter{pre#1title}{hep@pre@#1@title}%
  \hep@new@setter{post#1title}{hep@post@#1@title}%
  \expandafter\def\csname#1title\endcsname##1##2{%
    \@namedef{hep@#1@title}{##1}%
    \@namedef{hep@#1@title@pl}{##2}%
  }%
  \@namedef{hep@#1@font}{}%
  \@nameuse{#1title}{#2}{#3}%
  \@nameuse{#1titlefont}{\itshape}%
  \@nameuse{pre#1title}{\@nameuse{hep@#1@title@font}}%
  \@nameuse{post#1title}{: }%
  \@nameuse{pre#1}{%
    \begin{center}%
      \large\@nameuse{hep@#1@font}\lineskip.5em%
      \begin{tabular}[t]{c}{%
        \@nameuse{hep@pre@#1@title}%
        \ifnum\value{#1s}>1\relax%
          \@nameuse{hep@#1@title@pl}%
        \else%
          \@nameuse{hep@#1@title}%
        \fi%
        \@nameuse{hep@post@#1@title}%
      }%
  }%
  \@nameuse{post#1}{\end{tabular}\par\end{center}}%
}
%    \end{macrocode}
