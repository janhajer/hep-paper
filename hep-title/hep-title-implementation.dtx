% \begin{macro}{\hep@contact}
% \begin{macro}{\hep@contact@add}
% \begin{macro}{\hep@contact@next}
% \begin{macro}{\hep@contact@check}
% \begin{macro}{\hep@contact@skip}
% \begin{macro}{\hep@contact@flush}
% Collect contact information, such as email addresses and ORCID links, for one footnote.
% After each item the next token is inspected; another "\email" or "\orcid" continues the footnote, everything else places it.
% Spaces are skipped while looking ahead and one space is restored after the footnote mark.
%    \begin{macrocode}
\newcommand*\hep@contact{}
\newif\ifhep@contact@space
\newcommand*\hep@contact@add[1]{%
  \ifdefempty{\hep@contact}{%
    \gdef\hep@contact{#1}%
  }{%
    \gappto\hep@contact{ #1}%
  }%
  \hep@contact@spacefalse%
  \hep@contact@next%
}
\newcommand*\hep@contact@next{%
  \futurelet\hep@contact@token\hep@contact@check%
}
\newcommand*\hep@contact@check{%
  \let\hep@contact@do\hep@contact@flush%
  \ifx\hep@contact@token\@sptoken%
    \let\hep@contact@do\hep@contact@skip%
  \fi%
  \ifx\hep@contact@token\email\let\hep@contact@do\relax\fi%
  \ifx\hep@contact@token\orcid\let\hep@contact@do\relax\fi%
  \hep@contact@do%
}
\@firstofone{\def\hep@contact@skip} {%
  \hep@contact@spacetrue\hep@contact@next%
}
\newcommand*\hep@contact@flush{%
  \unskip\expandafter\hep@contact@thanks\expandafter{\hep@contact}%
  \ifhep@contact@space\space\fi%
}
\newcommand*\hep@contact@thanks[1]{\gdef\hep@contact{}\thanks{#1}}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
%
% Redefine the email macro for the title page.
% In the preamble an email without label directly after "\author", "\editor", or "\endorser" is attached to this person.
% An email with label gets its own footnote.
%    \begin{macrocode}
\DeclareDocumentCommand{\email}{O{}m}{%
  \ifblank{#1}{%
    \hep@person@attach{\email{#2}}{\hep@contact@add{\hep@email{#2}}}%
  }{%
    \unskip\thanks[#1]{\hep@email{#2}}%
  }%
}
\providecommand*\hep@abstract@place{}
\AtBeginDocument{
  \let\hep@maketitle\maketitle
  \renewcommand*\maketitle{%
    \hep@maketitle\global\let\email\hep@email\global\let\orcid\orcidlink%
    \hep@abstract@place
  }
}
%    \end{macrocode}
