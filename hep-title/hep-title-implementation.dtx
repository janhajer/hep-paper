% \begin{macro}{\@author}
% Ensure that affiliation is not set directly below author.
% Without affiliations the list of all authors is used, since \software{authblk} keeps only the last one in this case; it falls back to the author given before \software{hep-title} has been loaded.
% The "\rlap" redefinition lives in a helper macro, so that "\@author" contains no parameter characters; \software{hyperref} copies "\@author" with the "pdfusetitle" option.
%    \begin{macrocode}
\newcommand*{\hep@no@rlap}{\def\rlap##1{##1}}
\def\@author{%
  \ifx\AB@affillist\AB@empty%
    \ifx\AB@authlist\AB@empty\AB@author\else\AB@authlist\fi%
  \else%
    \ifnum\value{affil}>\value{Maxaffil}\relax%
      \hep@no@rlap%
      \AB@authlist%
%       \\[\affilsep]\AB@affillist%
    \else%
      \AB@authors%
    \fi%
  \fi%
}
