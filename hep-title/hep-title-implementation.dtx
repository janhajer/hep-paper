% \begin{macro}{\hep@person@add}
% Add a name with an optional list of labels to the list of editors or endorsers, similar to the "\author" macro of \software{authblk}.
% The first argument is the kind of person.
%    \begin{macrocode}
\newcommand*\hep@person@add[3]{%
  \ifnewaffil%
    \addtocounter{affil}{1}%
    \edef\AB@thenote{\arabic{affil}}%
  \fi%
  \if\relax#2\relax\else\setcounter{Maxaffil}{0}\fi%
  \ifnum\value{#1s}>1\relax%
    \@namedef{hep@#1@sep\number\value{#1s}}{\Authsep}%
  \fi%
  \addtocounter{#1s}{1}%
  \begingroup%
    \let\protect\@unexpandable@protect%
    \let\and\AB@pand%
    \def\thanks{\protect\thanks}\def\footnote{\protect\footnote}%
    \let\\\authorcr%
    \@temptokena=\expandafter\expandafter\expandafter{%
      \csname hep@#1list\endcsname%
    }%
    \expandafter\xdef\csname hep@#1list\endcsname{%
      \the\@temptokena%
      \protect\@nameuse{hep@#1@sep\number\value{#1s}}%
      \protect\Authfont\hep@author@name{#3}%
      \if\relax#2\relax\else\protect\hep@multi@ref{#2}\fi%
    }%
  \endgroup%
  \ifnum\value{#1s}>2\relax%
    \@namedef{hep@#1@sep\number\value{#1s}}{\Authands}%
  \fi%
  \newaffilfalse%
}
