% \subsection{Unicode engines}
%
% Load the \software{unicode-math} package \cite{unicode-math} with ISO math style and let the math alphabet commands select symbols from the main math font.
%    \begin{macrocode}
\iftutex
  \RequirePackage{unicode-math}
  \unimathsetup{
    math-style=ISO,
    bold-style=ISO,
    sans-style=italic,
    partial=italic,
    nabla=italic,
    mathrm=sym,
    mathup=sym,
    mathit=sym,
    mathsf=sym,
    mathbf=sym,
    mathtt=sym
  }
%    \end{macrocode}
%
% Use the serif or sans-serif \NCM math font matching the main family, and the bold math font for the bold math version.
%    \begin{macrocode}
  \ExplSyntaxOn
  \str_if_eq:VnTF \g__hep_main_family_tl {sans}
    {\setmathfont{NewCMSansMath-Regular.otf}[Numbers=Lining]}
    {\setmathfont{NewCMMath-Regular.otf}[Numbers=Lining]}
  \ExplSyntaxOff
  \setmathfont{NewCMMath-Bold.otf}[version=bold,Numbers=Lining]
%    \end{macrocode}
%
% Declare symbol fonts for the serif and sans-serif math fonts.
% Each contains the italic, upright, bold and bold italic Unicode alphabets.
% Unicode has no bold blackboard alphabet and no bold dotless letters, h-bar and ell, so these are taken from the bold serif math font.
%    \begin{macrocode}
  \newfontfamily\hep@serifmath{NewCMMath-Regular.otf}[
    NFSSFamily=hep-serif,
    Script=Math,
    Numbers=Lining,
    BoldFont=NewCMMath-Bold.otf
  ]
  \newfontfamily\hep@sansmath{NewCMSansMath-Regular.otf}[
    NFSSFamily=hep-sans,
    Script=Math,
    Numbers=Lining
  ]
  \DeclareSymbolFont{hepserif}{TU}{hep-serif}{m}{n}
  \DeclareSymbolFont{hepserifbf}{TU}{hep-serif}{b}{n}
  \DeclareSymbolFont{hepsans}{TU}{hep-sans}{m}{n}
%    \end{macrocode}
%
% There is no bold sans-serif math font, so the bold sans-serif letters without bold Unicode characters are taken from the bold \NCM sans text faces.
%    \begin{macrocode}
  \newfontfamily\hep@sanstext{NewCMSans10-Regular.otf}[
    NFSSFamily=hep-sanstext,
    ItalicFont=NewCMSans10-Oblique.otf,
    BoldFont=NewCMSans10-Bold.otf,
    BoldItalicFont=NewCMSans10-BoldOblique.otf
  ]
  \DeclareSymbolFont{hepsansbfup}{TU}{hep-sanstext}{b}{n}
  \DeclareSymbolFont{hepsansbfit}{TU}{hep-sanstext}{b}{it}
%    \end{macrocode}
%
% The \NCM mono faces are text fonts, so declare a symbol font for each of the four faces.
%    \begin{macrocode}
  \newfontfamily\hep@monomath{NewCMMono10-Regular.otf}[
    NFSSFamily=hep-mono,
    Numbers=Lining,
    ItalicFont=NewCMMono10-Italic.otf,
    BoldFont=NewCMMono10-Bold.otf,
    BoldItalicFont=NewCMMono10-BoldOblique.otf
  ]
  \DeclareSymbolFont{hepmonoit}{TU}{hep-mono}{m}{it}
  \DeclareSymbolFont{hepmonoup}{TU}{hep-mono}{m}{n}
  \DeclareSymbolFont{hepmonobfit}{TU}{hep-mono}{b}{it}
  \DeclareSymbolFont{hepmonobfup}{TU}{hep-mono}{b}{n}
%    \end{macrocode}
%
% \begin{macro}{\hep@propfont}
% With the "proportional" option the Latin letters and digits come from the \LM proportional typewriter faces, whose bold face belongs to the light family like the bold \LM typewriter.
% They have no italic, so their oblique faces are used instead.
% The \LaTeX\ kernel declares at most $16$ symbol fonts, although the Unicode engines provide $256$ math families.
% The package already uses most of them, so the four faces are allocated past this limit at the beginning of the document, after the symbol fonts of other packages.
%    \begin{macrocode}
  \ifhepmathfont@proportional
    \newfontfamily\hep@propmath{lmmonoprop10-regular.otf}[
      NFSSFamily=hep-prop,
      ItalicFont=lmmonoprop10-oblique.otf,
      BoldFont=lmmonoproplt10-bold.otf,
      BoldItalicFont=lmmonoproplt10-boldoblique.otf
    ]
    \def\hep@propfont#1#2#3{%
      \expandafter\new@mathgroup\csname symhepprop#1\endcsname
      \expandafter\new@symbolfont\csname symhepprop#1\endcsname
        {TU}{hep-prop}{#2}{#3}}
    \AtBeginDocument{%
      \hep@propfont{it}{m}{it}\hep@propfont{up}{m}{n}%
      \hep@propfont{bfit}{b}{it}\hep@propfont{bfup}{b}{n}}
  \fi
%    \end{macrocode}
% \end{macro}
%
% The MnSymbol fonts are not available as Unicode math fonts.
% Unless the "symbols" option is "false" use the stylistic set of the \NCM math fonts, which provides a distinct script alphabet.
%    \begin{macrocode}
  \ExplSyntaxOn
  \str_if_eq:VnT \hepmathfont@symbols {minion} {
    \PackageError{hep-math-font}
      {symbols=minion~is~not~supported~by~Unicode~engines}
      {Use~symbols=true~or~ams~with~New~Computer~Modern.}
  }
  \str_if_eq:VnF \hepmathfont@symbols {false} {
    \str_if_eq:VnTF \g__hep_main_family_tl {sans} {
      \setmathfont{NewCMSansMath-Regular.otf}[range={scr,bfscr},
        StylisticSet=1,Numbers=Lining,BoldFont=NewCMMath-Bold.otf]
    }{
      \setmathfont{NewCMMath-Regular.otf}[range={scr,bfscr},
        StylisticSet=1,Numbers=Lining,BoldFont=NewCMMath-Bold.otf]
    }
  }
%    \end{macrocode}
%
% \begin{macro}{\__hep_math_family:nnnn}
% For "symbols=true" and "ams" allocate the math family "#1" past the limit of the \LaTeX\ kernel at the beginning of the document, which uses the font "#3" with the features "#4" as the font family "#2".
% \software{luaotfload} only applies the stylistic set to math characters in its base mode.
%    \begin{macrocode}
  \cs_new_protected:Npn \__hep_math_family:nnnn #1#2#3#4 {
    \use:e {
      \exp_not:N \newfontfamily \exp_not:c {hep@#1math} {#3} [
        NFSSFamily = hep-#2, Script = Math, Numbers = Lining,
        \sys_if_engine_luatex:T {Renderer = Basic,} #4
      ]
    }
    \AddToHook{begindocument}{
      \exp_args:Nc \new@mathgroup {sym#1}
      \exp_args:Nc \new@symbolfont {sym#1}{TU}{hep-#2}{m}{n}
    }
  }
%    \end{macrocode}
% \end{macro}
%
% The calligraphic capitals of the Euler math font are the upright calligraphic alphabet.
% The stylistic set of the \NCM math fonts provides the italic script alphabets, which are slanted back for the upright ones.
%    \begin{macrocode}
  \exp_args:NnV \clist_if_in:nnT {true, ams} \hepmathfont@symbols {
    \__hep_math_family:nnnn {hepeuler}{euler}{Euler-Math.otf}{}
    \__hep_math_family:nnnn {hepscr}{scr}{NewCMMath-Regular.otf}
      {StylisticSet = 1}
    \__hep_math_family:nnnn {hepsansscr}{sansscr}
      {NewCMSansMath-Regular.otf}{StylisticSet = 1}
    \__hep_math_family:nnnn {hepscrup}{scrup}{NewCMMath-Regular.otf}
      {StylisticSet = 1, FakeSlant = -0.4}
    \__hep_math_family:nnnn {hepsansscrup}{sansscrup}
      {NewCMSansMath-Regular.otf}{StylisticSet = 1, FakeSlant = -0.4}
  }
%    \end{macrocode}
