"""Build the pdfTeX virtual fonts of the hep-math-font package.

Run this script in the directory containing hep-math-font.sty.
It reads the glyph tables from that file and writes the hepalpha,
hepdecor, hepscript and hepbb TFM and VF files there, with the TFM files
of their re-encoded and slanted base fonts, the TrueType font of the
accents, two encodings and two map files.
Requires Python 3 with fontTools, kpsewhich, pltotf and vptovf.
"""
from functools import lru_cache
from pathlib import Path
import copy
import math
import re
import shutil
import statistics
import subprocess
import tempfile
from fontTools.fontBuilder import FontBuilder
from fontTools.misc.bezierTools import splitCubic, splitLine
from fontTools.pens.boundsPen import BoundsPen
from fontTools.pens.cu2quPen import Cu2QuPen
from fontTools.pens.recordingPen import RecordingPen
from fontTools.pens.transformPen import TransformPen
from fontTools.pens.ttGlyphPen import TTGlyphPen
from fontTools.t1Lib import T1Font
from fontTools.tfmLib import TFM
from fontTools.ttLib import TTFont, newTable
from fontTools.ttLib.tables import otTables

ROOT = Path.cwd()
TEMP = Path(tempfile.mkdtemp())
%    \end{macrocode}
%
% Locate installed files with \software{kpsewhich} and read the metrics of the generated and installed fonts and the outlines of the installed Type~1 fonts.
%    \begin{macrocode}
def kpse(name):
    """Return the path of an installed file."""
    path = subprocess.run(['kpsewhich', name], text=True,
                          stdout=subprocess.PIPE).stdout.strip()
    if not path:
        raise SystemExit('Missing installed file: ' + name)
    return path


@lru_cache(None)
def tfm(name):
    """Return the metrics of a generated or installed TFM file."""
    path = ROOT / (name + '.tfm')
    return TFM(str(path) if path.exists() else kpse(name + '.tfm'))


@lru_cache(None)
def type1(name):
    """Return the parsed Type 1 font of an installed PFB file."""
    font = T1Font(kpse(name + '.pfb'))
    font.parse()
    return font
%    \end{macrocode}
%
% The map file of \hologo{pdfTeX} names the Type~1 font and the encoding of each installed font.
% Without an encoding file the font uses its built-in encoding.
% The fonts generated by this script use their own encoding.
%    \begin{macrocode}
@lru_cache(None)
def maplines():
    """Return the lines of the pdfTeX map file by font name."""
    lines = Path(kpse('pdftex.map')).read_text().splitlines()
    return {line.split()[0]: line for line in lines
            if line.strip() and not line.startswith(('%', '#'))}


def mapfiles(name):
    """Return the font and encoding files of a font."""
    if name in REENCODED:
        return REENCODED[name], None
    if name not in maplines():
        raise SystemExit('Font missing from pdftex.map: ' + name)
    files = re.findall(r'<[<\[]?(\S+)', maplines()[name])
    pfb = next(file for file in files if file.endswith('.pfb'))
    enc = [file for file in files if file.endswith('.enc')]
    return pfb[:-4], enc[0] if enc else None


@lru_cache(None)
def encoding(name):
    """Return the glyph names of the slots of a font."""
    if name in REENCODED:
        return GLYPHS
    pfb, enc = mapfiles(name)
    if enc is None:
        return list(type1(pfb).font['Encoding'])
    text = re.sub(r'%.*', '', Path(kpse(enc)).read_text())
    return re.findall(r'/([^\s/\[\]]+)', text.split('[', 1)[1])
%    \end{macrocode}
%
% The horizontal extent of a glyph, optionally slanted by a shear, determines the metrics of the slanted glyphs.
%    \begin{macrocode}
def bounds(pfb, glyph, slant=0):
    """Return the horizontal extent of a glyph, optionally slanted."""
    glyphs = type1(pfb).getGlyphSet()
    pen = BoundsPen(glyphs)
    glyphs[glyph].draw(TransformPen(pen, (1, 0, slant, 1, 0, 0)))
    box = pen.bounds or (0, 0, 0, 0)
    return box[0] / 1000, box[2] / 1000
%    \end{macrocode}
%
% \subsection{Glyph tables}
%
% Read the glyph tables from the package, so that the slots are defined only once.
% The rows are expanded in the same way as by "\__hep_math_range:nnnnn", "\__hep_math_named:nnnnn", "\__hep_math_decor:nnn", "\__hep_math_bb:nnn" and "\__hep_math_cal:nnn".
% The accents of the rows "\__hep_math_accent:nnn" take the slots after the glyph table.
% Every call of a row macro must be parsed, otherwise the slots of the package and the virtual fonts would differ.
%    \begin{macrocode}
ARG = r'\s*\{([^}]*)\}'
ROW = re.compile(r'\\__hep_math_(range|named):nnnnn' + 5 * ARG)
DECOR = re.compile(r'\\__hep_math_decor:nnn' + 3 * ARG)
BB = re.compile(r'\\__hep_math_bb:nnn' + 3 * ARG)
CAL = re.compile(r'\\__hep_math_cal:nnn' + 3 * ARG)
ACCENT = re.compile(r'\\__hep_math_accent:nnn' + 3 * ARG)


def table_rows(pattern, sty, *names):
    """Return the parsed rows, which must be all calls of the macros."""
    found = pattern.findall(sty)
    calls = sum(len(re.findall(re.escape(name) + r'\s*\{', sty))
                for name in names)
    if len(found) != calls:
        raise SystemExit(f'Parsed {len(found)} of {calls} rows of '
                         + ', '.join(names))
    return found


def glyph_table(sty):
    """Expand the glyph rows exactly as the package does."""
    glyphs = []
    table = table_rows(ROW, sty, r'\__hep_math_range:nnnnn',
                       r'\__hep_math_named:nnnnn')
    for kind, names, *columns in table:
        start = [int(column, 16) for column in columns]
        if kind == 'range':
            items = [('', '')] * int(names)
        else:
            items = []
            for item in names.split(','):
                parts = [part.strip() for part in item.split('/')]
                items.append((parts[0], parts[-1]))
        for step, (name, text) in enumerate(items):
            glyphs.append(dict(index=len(glyphs), name=name, text=text,
                               unicode=[cp + step for cp in start]))
    assert len(glyphs) < 127, 'slot 127 + 128 = 255 is the skewchar'
    return glyphs


def decor_table(sty):
    """Expand the decorative rows to (alphabet, character, slot)."""
    rows = []
    table = table_rows(DECOR, sty, r'\__hep_math_decor:nnn')
    for alphabet, first, count in table:
        for step in range(int(count)):
            rows.append((alphabet, int(first, 16) + step, len(rows)))
    return rows


def bb_table(sty):
    """Expand the blackboard rows to input and Unicode characters."""
    chars = []
    table = table_rows(BB, sty, r'\__hep_math_bb:nnn')
    for first, count, unicode in table:
        chars += [(int(first, 16) + step, int(unicode, 16) + step)
                  for step in range(int(count))]
    assert 4 * len(chars) < 256, 'slot 255 is the skewchar'
    return chars

def cal_table(sty):
    """Expand the calligraphic rows to input characters."""
    table = table_rows(CAL, sty, r'\__hep_math_cal:nnn')
    return [int(first, 16) + step for first, count, _ in table
            for step in range(int(count))]


def accent_table(sty, glyphs):
    """Return the accents with their slot, pattern and characters."""
    table = table_rows(ACCENT, sty, r'\__hep_math_accent:nnn')
    accents = [dict(slot=len(glyphs) + index, pattern=pattern,
                    unicode=int(first, 16))
               for index, (_, pattern, first) in enumerate(table)]
    assert len(glyphs) + len(accents) <= 127, 'slot 128 is upright'
    return accents
%    \end{macrocode}
%
% \subsection{Source slots}
%
% The \LGR encoding addresses each Greek letter by an ASCII letter.
% The OML encoding only contains the Greek capitals which differ from the Latin ones, the others use the Latin capitals of the same font.
% The letters are identified by the names of their text commands.
%    \begin{macrocode}
GREEK = ('Alpha Beta Gamma Delta Epsilon Zeta Eta Theta Iota Kappa '
         'Lambda Mu Nu Xi Omicron Pi Rho Sigma Tau Upsilon Phi Chi Psi '
         'Omega')
LGR = dict(zip(GREEK.split(), 'ABGDEZHJIKLMNXOPRSTUFQYW'))
LGR.update((name.lower(), letter.lower()) for name, letter in
           list(LGR.items()))
LGR['finalsigma'] = 'c'
OML = dict(zip('Gamma Delta Theta Lambda Xi Pi Sigma Upsilon Phi Psi '
               'Omega'.split(), range(11)))
OML.update(zip('Alpha Beta Epsilon Zeta Eta Iota Kappa Mu Nu Omicron '
               'Rho Tau Chi'.split(), map(ord, 'ABEZHIKMNOPTX')))
OML.update(zip('alpha beta gamma delta varepsilon zeta eta theta iota '
               'kappa lambda mu nu xi pi rho sigma tau upsilon varphi '
               'chi psi omega'.split(), range(11, 34)))
OML.update(epsilon=34, phi=39, omicron=111, finalsigma=38)
%    \end{macrocode}
%
% The variant letters, derivatives, dotless letters, the ell and the h-bar are identified by their macro names.
% Their kind determines where the upright, typewriter and bold shapes come from.
%    \begin{macrocode}
SPECIAL = dict(epsilon=('cmu', 15), vartheta=('serifcmu', 35),
               phi=('serifcmu', 30), varrho=('serifcmu', 37),
               varpi=('variant', 36), partial=('variant', 64),
               varkappa=('kappa', 123), nabla=('nabla', 114),
               imath=('dotless', 123), jmath=('dotless', 124),
               ell=('ell', 96), hbar=('hbar', None))


def classify(glyph):
    """Return the kind of a glyph and its source slot(s)."""
    if glyph['name'] in SPECIAL:
        return SPECIAL[glyph['name']]
    if glyph['name']:
        text = glyph['text']
        return 'greek', dict(lgr=ord(LGR[text]), oml=OML[text])
    up = glyph['unicode'][0]
    return ('digit' if up < 65 else 'latin'), up
%    \end{macrocode}
%
% \subsection{Base fonts}
%
% The CM Unicode fonts provide the bold typewriter Greek, the upright and typewriter epsilon symbol, the upright serif theta, theta symbol, phi symbol and rho symbol, which are not part of the \LGR encoding.
% They distinguish the Greek Delta, Omega and mu from the symbols of the same name by a suffix.
% The \LM text fonts provide the h-bar.
% These glyphs form the encoding of the base fonts generated by this script.
%    \begin{macrocode}
CMU_GLYPHS = {name: name for name in GREEK.split() + GREEK.lower().split()}
CMU_GLYPHS.update(Delta='Delta.greek', Omega='Omega.greek',
                  mu='mu.greek', finalsigma='sigma1')
CMU_VARIANTS = dict(epsilon='uni03F5', vartheta='theta1', phi='phi1',
                    varrho='uni03F1')
GLYPHS = [*CMU_GLYPHS.values(), *CMU_VARIANTS.values(), 'theta.ipa',
          'hbar']
ENCODING = 'hep-math-font'
MAPS = {}
REENCODED = {}
%    \end{macrocode}
%
% Write the \TFM file of a base font, which takes a CM Unicode or \LM text font in this encoding, and record its map line.
% The metrics are computed from the outlines and the italic correction of an italic font covers the overhang of its glyphs.
% The CM Unicode fonts have the design size \unit[10]{pt}, the \LM fonts state it in their names.
%    \begin{macrocode}
def pl_value(value):
    """Return a property list real number."""
    return f'R {value:.9f}'


@lru_cache(None)
def reencoded(pfb):
    """Return the name of a base font of a PFB file in our encoding."""
    name = 'hep-' + pfb
    font = type1(pfb)
    glyphs = font.getGlyphSet()
    size = re.search(r'\d*$', pfb).group()
    italic = font.font['FontInfo'].get('ItalicAngle', 0) != 0
    pl = [f'(DESIGNSIZE R {size or 10})',
          f'(CODINGSCHEME {ENCODING.upper()})',
          '(FONTDIMEN (SLANT R 0.0) (QUAD R 1.0))']
    for slot, glyph in enumerate(GLYPHS):
        if glyph not in glyphs:
            continue
        box = BoundsPen(glyphs)
        glyphs[glyph].draw(box)
        x0, y0, x1, y1 = [value / 1000 for value in
                          box.bounds or (0, 0, 0, 0)]
        width = glyphs[glyph].width / 1000
        pl.append(f'(CHARACTER D {slot} (CHARWD {pl_value(width)}) '
                  f'(CHARHT {pl_value(max(y1, 0))}) '
                  f'(CHARDP {pl_value(max(-y0, 0))}) '
                  f'(CHARIC {pl_value(max(x1 - width, 0) * italic)}))')
    path = TEMP / (name + '.pl')
    path.write_text('\n'.join(pl) + '\n')
    subprocess.run(['pltotf', str(path), str(ROOT / (name + '.tfm'))],
                   check=True, stdout=subprocess.DEVNULL)
    line = (f'{name} {font.font["FontName"]} " {ENCODING.upper()}'
            f' ReEncodeFont " <{ENCODING}.enc <{pfb}.pfb')
    MAPS[name] = (line, line)
    REENCODED[name] = pfb
    return name
%    \end{macrocode}
%
% Synthetic shapes are slanted copies of installed or generated fonts.
% Their \TFM file is a copy of the original one and their map line slants the font by the "SlantFont" operator.
% The map line of the fallback map file uses the font unchanged.
%    \begin{macrocode}
def slant_of(name):
    """Return the slant of a font."""
    return tfm(name).fontdimens['SLANT']


SLANTED = {}


def slanted(base, slant):
    """Return the name of a slanted copy of a font."""
    name = 'hepslant-' + base
    if name not in SLANTED:
        SLANTED[name] = (base, slant)
        path = ROOT / (base + '.tfm')
        if base not in REENCODED:
            path = kpse(base + '.tfm')
        shutil.copyfile(path, ROOT / (name + '.tfm'))
        line = (MAPS[base][0] if base in REENCODED
                else maplines()[base]).split(None, 1)[1]
        if '"' in line:
            slant_line = line.replace('"', f'" {slant:.4f} SlantFont', 1)
        else:
            psname, files = line.split(None, 1)
            slant_line = f'{psname} " {slant:.4f} SlantFont " {files}'
        MAPS[name] = (f'{name} {slant_line}', f'{name} {line}')
    assert SLANTED[name] == (base, slant), name
    return name
%    \end{macrocode}
%
% The \LM text fonts exist at several optical sizes, choose the closest one.
%    \begin{macrocode}
def optical(stem, size):
    """Return the installed optical size of a font closest to size."""
    for candidate in [*range(size, 4, -1), *range(size + 1, 18)]:
        if subprocess.run(['kpsewhich', f'{stem}{candidate}.pfb'],
                          stdout=subprocess.DEVNULL).returncode == 0:
            return stem + str(candidate)
    raise SystemExit('Missing installed font: ' + stem)
%    \end{macrocode}
%
% \subsection{Source fonts}
%
% The CM Unicode and \LM text fonts for each family, weight and shape, where the shape is $1$ for upright.
% CM Unicode has no italic serif and sans-serif fonts, the math italic fonts are used instead.
% The family $3$ is the proportional typewriter.
%    \begin{macrocode}
CMU = {(0, 0, 1): 'cmunrm', (0, 1, 1): 'cmunbx', (1, 0, 1): 'cmunss',
       (1, 1, 1): 'cmunsx', (2, 0, 1): 'cmuntt', (2, 1, 1): 'cmuntb',
       (2, 0, 0): 'cmunit', (2, 1, 0): 'cmuntx'}
HBAR = {(0, 0, 1): 'lmr', (0, 1, 1): 'lmbx', (0, 0, 0): 'lmri',
        (0, 1, 0): 'lmbxi', (1, 0, 1): 'lmss', (1, 1, 1): 'lmssbx',
        (1, 0, 0): 'lmsso', (1, 1, 0): 'lmssbo', (2, 0, 1): 'lmtt',
        (2, 1, 1): 'lmtk', (2, 0, 0): 'lmtti', (2, 1, 0): 'lmtko',
        (3, 0, 1): 'lmvtt', (3, 1, 1): 'lmvtk', (3, 0, 0): 'lmvtto',
        (3, 1, 0): 'lmvtko'}
%    \end{macrocode}
%
% Return the source font and slot for a glyph in the family $0$, $1$ or $2$ for serif, sans-serif or typewriter, with the given weight, shape and size.
% The family $3$ for the proportional typewriter only differs in its Latin letters, digits and h-bar, and is otherwise treated as the typewriter family.
% The bold math italic fonts only exist at \unit[5]{pt}, \unit[7]{pt} and \unit[10]{pt}.
% Most variant Greek letters of the CM Unicode fonts only exist in serif.
%    \begin{macrocode}
def source(kind, slot, glyph, family, bold, up, size):
    """Return the source font and slot of a glyph."""
    mathsize = size if not bold else (5 if size == 5 else
                                      7 if size == 7 else 10)
    mi = ('lmmib' if bold else 'lmmi') + str(mathsize)
    sfmi = ('cmssmib' if bold else 'cmssmi') + str(size)
    italic = sfmi if family == 1 else mi
    prop = family == 3
    family = min(family, 2)

    def cmu(family, up):
        font = reencoded(CMU[family, bold, up])
        if glyph['name'] in CMU_VARIANTS:
            return font, GLYPHS.index(CMU_VARIANTS[glyph['name']])
        if glyph['name'] == 'theta' and family == 0:
            return font, GLYPHS.index('theta.ipa')
        return font, GLYPHS.index(CMU_GLYPHS[glyph['text']])
%    \end{macrocode}
%
% \CM has a single upright nabla for each family and weight, the typewriter family uses the serif one.
% The italic nabla is slanted by the slant of the math italic font.
%    \begin{macrocode}
    if kind == 'nabla':
        if family == 1:
            font = ('cmssbsy' if bold else 'cmsssy') + str(size)
        else:
            font = ('lmbsy' if bold else 'lmsy') + str(mathsize)
        return (font if up else slanted(font, slant_of(italic))), slot
%    \end{macrocode}
%
% The math italic fonts provide the italic variant letters and derivatives.
% The upright varpi and partial and the upright sans-serif phi, rho and theta symbols are the italic shapes slanted back.
% The typewriter family uses the serif shapes.
% The other upright and typewriter shapes come from CM Unicode.
%    \begin{macrocode}
    if kind == 'variant' or (kind == 'serifcmu'
                             and (family == 1 or not up)):
        font = sfmi if family == 1 else mi
        return (slanted(font, -slant_of(font)) if up else font), slot
    if kind == 'serifcmu':
        return cmu(0, 1)
    if kind == 'cmu':
        if up or family == 2:
            return cmu(family, up)
        return italic, slot
%    \end{macrocode}
%
% The kappa symbol comes from the \AMS blackboard fonts, whose sans-serif version is part of the \software{sansmathfonts} package.
% There is no bold kappa symbol.
% The ell of the math italic fonts serves both shapes and the typewriter family uses the serif one.
% The h-bar comes from the \LM text fonts.
%    \begin{macrocode}
    if kind == 'kappa':
        font = ('ssmsbm' if family == 1 else 'msbm') + str(size)
        return (slanted(font, -slant_of(italic)) if up else font), slot
    if kind == 'ell':
        return italic, slot
    if kind == 'hbar':
        stem = HBAR[family + prop, bold, up]
        return reencoded(optical(stem, size)), GLYPHS.index('hbar')
%    \end{macrocode}
%
% Italic serif and sans-serif Greek is taken from the OML math fonts.
% Upright and typewriter Greek is taken from the CB Greek fonts.
% Their upright serif theta has the shape of the theta symbol, so it comes from CM Unicode instead.
% Their italic typewriter epsilon has the shape of the epsilon symbol, so it is the upright epsilon slanted.
% The bold typewriter Greek comes from CM Unicode as the CB Greek typewriter fonts have no bold weight.
%    \begin{macrocode}
    if kind == 'greek':
        if family != 2 and not up:
            return italic, slot['oml']
        if family == 0 and glyph['name'] == 'theta':
            return cmu(0, 1)
        if family == 2 and not up and glyph['name'] == 'varepsilon':
            font, cp = source(kind, slot, glyph, family, bold, 1, size)
            return slanted(font, slant_of(f'gtti{size:02d}00')), cp
        if family == 2:
            if bold:
                return cmu(2, up)
            font = ('gttn' if up else 'gtti') + f'{size:02d}00'
            return font, slot['lgr']
        if family == 1:
            prefix = 'gsxn' if bold else 'gsmn'
        else:
            prefix = 'grxn' if bold else 'grmn'
        return prefix + f'{size:02d}00', slot['lgr']
%    \end{macrocode}
%
% Latin letters and digits are taken from the \LM text and math fonts.
% The proportional typewriter has no italic, its oblique fonts are used instead.
% Digits are always upright.
% The upright dotless letters are taken from the text fonts.
%    \begin{macrocode}
    if kind == 'digit':
        up = True
    if family == 0:
        lm = 'rm-lmbx' if bold else 'rm-lmr'
        font = lm + str(size) if up else mi
    elif family == 1:
        lm = 'rm-lmssbx10' if bold else 'rm-lmss' + str(max(8, size))
        font = lm if up else sfmi
    elif prop:
        lm = 'rm-lmvtk' if bold else 'rm-lmvtt'
        font = lm + ('10' if up else 'o10')
    elif bold:
        font = 'rm-lmtk10' if up else 'rm-lmtko10'
    else:
        font = 'rm-lmtt' + str(max(8, size)) if up else 'rm-lmtti10'
    if kind == 'dotless' and (up or family == 2):
        slot = 16 if glyph['name'] == 'imath' else 17
    return font, slot
%    \end{macrocode}
%
% \subsection{Virtual property lists}
%
% A character copies the width, height, depth and italic correction of its source.
% A slanted glyph keeps its left side bearing.
% Slanted back to upright it keeps the right side bearing including the italic correction, slanted to italic the overhang becomes its italic correction.
%    \begin{macrocode}
METRICS = [('CHARWD', 'width'), ('CHARHT', 'height'),
           ('CHARDP', 'depth'), ('CHARIC', 'italic')]


def slant_metrics(name, cp, metrics):
    """Return the metrics and offset of a slanted glyph."""
    base, slant = SLANTED[name]
    pfb = mapfiles(base)[0]
    glyph = encoding(base)[cp]
    x0, x1 = bounds(pfb, glyph)
    s0, s1 = bounds(pfb, glyph, slant)
    move = x0 - s0
    right = metrics['width'] + metrics.get('italic', 0) - x1
    metrics = dict(metrics, italic=0)
    if slant < 0:
        metrics['width'] = s1 + move + right
    else:
        metrics['italic'] = max(s1 + move + right - metrics['width'], 0)
    return metrics, move
%    \end{macrocode}
%
% Synthesise a bold glyph by overprinting copies of the glyph, which are shifted around a circle of the radius "BOLD" in units of the font size.
% The copies are a marked-content sequence with an empty actual text, so that the text extracted from the PDF file contains the glyph once.
% The sequence ends the text object before it begins and before it ends, so that both are properly nested.
%    \begin{macrocode}
BOLD = 0.012


def overprint(glyph, radius):
    """Return the VPL commands which embolden a glyph."""
    copies = ' '.join(
        f'(PUSH) (MOVERIGHT R {radius * (1 + math.cos(angle)):.9f}) '
        f'(MOVEUP R {radius * math.sin(angle):.9f}) {glyph} (POP)'
        for angle in (math.pi * step / 8 for step in range(16)))
    return ('(SPECIAL pdf:page:/Span<</ActualText()>>BDC) '
            + copies + ' (SPECIAL pdf:page:EMC) '
            f'(MOVERIGHT R {radius:.9f}) {glyph}')
%    \end{macrocode}
%
% Write a character of the virtual font, which moves a slanted glyph to keep its left side bearing.
% Source fonts listed in "SCALE" are scaled together with their metrics, and the radius "bold" widens a glyph on both sides and raises its height and depth.
% Source fonts listed in "PROXY" take their metrics from another font.
%    \begin{macrocode}
SCALE = {}
PROXY = {}


def character(slot, fonts, name, cp, bold=0):
    """Return a VPL character copying the metrics of its source."""
    metrics = tfm(PROXY.get(name, name)).chars.get(cp)
    assert metrics is not None, (name, cp)
    move = 0
    if name in SLANTED:
        metrics, move = slant_metrics(name, cp, metrics)
    metrics = {key: value * SCALE.get(name, 1)
               for key, value in metrics.items()}
    for key in ('width', 'height', 'depth'):
        metrics[key] = metrics.get(key, 0) + bold * (2 if key == 'width'
                                                      else 1)
    fields = ' '.join(f'({key} R {metrics.get(value, 0):.9f})'
                      for key, value in METRICS)
    shift = f'(MOVERIGHT R {move:.9f}) ' if move else ''
    glyph = f'(SELECTFONT D {fonts.index(name)}) (SETCHAR D {cp})'
    if bold:
        glyph = overprint(glyph, bold)
    return f'(CHARACTER D {slot} {fields} (MAP {shift}{glyph}))'
%    \end{macrocode}
%
% The source fonts are used at their design sizes, scaled to the size of the virtual font and by their factor in "SCALE".
%    \begin{macrocode}
def mapfonts(fonts):
    """Return the VPL font references at their design sizes."""
    return [f'(MAPFONT D {i} (FONTNAME {name}) '
            f'(FONTAT R {SCALE.get(name, 1.0)}) '
            f'(FONTDSIZE R {tfm(name).designsize}))'
            for i, name in enumerate(fonts)]
%    \end{macrocode}
%
% Math accents are placed using the kerns with the skew character.
% Redirect them to the empty slot 255, which the package declares as the skew character of the virtual fonts.
% Glyphs slanted to italic place the accent above the middle of their height.
%    \begin{macrocode}
def skew_kerns(rows):
    """Redirect accent skew kerns to the empty slot 255."""
    kerns = [f'(LABEL D {slot}) (KRN D 255 R {skew:.9f}) (STOP)'
             for slot, skew in rows if skew]
    return ['(LIGTABLE ' + ' '.join(kerns) + ')'] if kerns else []


def skew(name, cp):
    """Return the accent skew of a character of an italic source."""
    if name in SLANTED:
        base, slant = SLANTED[name]
        return max(slant, 0) * tfm(base).chars[cp]['height'] / 2
    if name.startswith(('lmmi', 'cmssmi')):
        return tfm(name).kerning.get(cp, {}).get(127, 0)
    return 0
%    \end{macrocode}
%
% Convert the property list with \software{vptovf}, keeping only the \TFM and \VF files.
%    \begin{macrocode}
def write(vpl, name):
    """Convert the VPL lines to TFM and VF files next to the package."""
    path = TEMP / (name + '.vpl')
    path.write_text('\n'.join(vpl) + '\n')
    subprocess.run(['vptovf', str(path), str(ROOT / (name + '.vf')),
                    str(ROOT / (name + '.tfm'))], check=True,
                   stdout=subprocess.DEVNULL)
%    \end{macrocode}
%
% \subsection{Accents}
%
% The dashed and dotted vector accents are copies of the vector accents of the math italic fonts for \hologo{pdfTeX} and of the \NCM math fonts for the Unicode engines, whose shafts are cut into dashes or dots.
% The arrowhead, the width, the height and the accent attachment are those of the original glyph, so that the accents are placed exactly like "\vec".
% The glyphs are collected in the TrueType font \file{hepaccent.ttf}, which \hologo{pdfTeX} uses through the \TFM file \file{hepaccent.tfm} and the "hepalpha" virtual fonts, and the Unicode engines through its private use characters and its math table.
% Each source font provides one glyph per accent.
% The bold and sans-serif math italic fonts only exist at the three sizes of the virtual fonts.
%    \begin{macrocode}
ACCENT_FONT = 'hepaccent'
ACCENT_SOURCES = [stem + str(size) for stem in
                  ('lmmi', 'lmmib', 'cmssmi', 'cmssmib')
                  for size in (5, 7, 10)]
ACCENT_UNICODE = ['NewCMMath-Regular', 'NewCMSansMath-Regular',
                  'NewCMMath-Bold']


def accent_source(family, bold, size):
    """Return the math italic font of a bank, whose accent is used."""
    return ('cmssmi' if family == 1 else 'lmmi') + 'b' * bold + str(size)
%    \end{macrocode}
%
% A glyph is a list of contours, each a list of line and curve segments given by their two or four points.
% The outlines are read with their original cubic curves.
%    \begin{macrocode}
def contours(glyph):
    """Return the contours of a glyph as lists of segments."""
    pen = RecordingPen()
    glyph.draw(pen)
    result = []
    for operator, points in pen.value:
        if operator == 'moveTo':
            start = current = points[0]
            result.append([])
        elif operator in ('lineTo', 'curveTo'):
            result[-1].append((current, *points))
            current = points[-1]
        elif operator in ('closePath', 'endPath'):
            if current != start:
                result[-1].append((current, start))
        else:
            raise SystemExit('Unexpected outline: ' + operator)
    return result


def at(segment, t):
    """Return the point at the parameter t of a segment."""
    if len(segment) == 2:
        weights = (1 - t, t)
    else:
        weights = ((1 - t) ** 3, 3 * t * (1 - t) ** 2,
                   3 * t * t * (1 - t), t ** 3)
    return tuple(sum(w * p[i] for w, p in zip(weights, segment))
                 for i in (0, 1))


def samples(contour):
    """Return points along a contour."""
    return [at(segment, step / 32) for segment in contour
            for step in range(32)]
%    \end{macrocode}
%
% The vector accents consist of a single contour: a horizontal shaft with a round left end and an arrowhead, whose barbs reach back over the shaft.
% The shaft is measured in the left part of the glyph and the arrowhead starts where the outline leaves the shaft.
%    \begin{macrocode}
def shaft(contour):
    """Return the left end, top, bottom and head start of a shaft."""
    points = samples(contour)
    left = min(x for x, _ in points)
    right = max(x for x, _ in points)
    middle = [y for x, y in points
              if left + .15 * (right - left) < x
              < left + .35 * (right - left)]
    top, bottom = max(middle), min(middle)
    margin = (top - bottom) / 4
    head = min(x for x, y in points
               if y > top + margin or y < bottom - margin)
    return left, top, bottom, head
%    \end{macrocode}
%
% Cut a contour at the vertical line "cut", keep its right part and close it by a round end on the left.
% The line has to cross the contour twice, at the top and the bottom of the shaft.
% A circular arc is drawn by two cubic curves per quarter.
%    \begin{macrocode}
KAPPA = 4 * (math.sqrt(2) - 1) / 3


def quarter(start, end, horizontal):
    """Return a quarter circle leaving start horizontally or not."""
    (x0, y0), (x1, y1) = start, end
    if horizontal:
        return (start, (x0 + KAPPA * (x1 - x0), y0),
                (x1, y1 - KAPPA * (y1 - y0)), end)
    return (start, (x0, y0 + KAPPA * (y1 - y0)),
            (x1 - KAPPA * (x1 - x0), y1), end)


def split(segment, cut):
    """Return the pieces of a segment on both sides of x = cut."""
    if len(segment) == 2:
        pieces = splitLine(*segment, cut, False)
    else:
        pieces = splitCubic(*segment, cut, False)
    return [tuple(piece) for piece in pieces]


def cut_shaft(contour, cut):
    """Return the part right of cut, closed by a round end."""
    pieces = [piece for segment in contour
              for piece in split(segment, cut)]
    right = [at(piece, .5)[0] > cut for piece in pieces]
    starts = [i for i in range(len(pieces))
              if right[i] and not right[i - 1]]
    assert len(starts) == 1, 'the cut must cross the shaft twice'
    order = pieces[starts[0]:] + pieces[:starts[0]]
    kept = [piece for piece in order if at(piece, .5)[0] > cut]
    exit, entry = kept[-1][-1], kept[0][0]
    radius = abs(exit[1] - entry[1]) / 2
    middle = (cut - radius, (exit[1] + entry[1]) / 2)
    return kept + [quarter(exit, middle, True),
                   quarter(middle, entry, False)]
%    \end{macrocode}
%
% The dashes are capsules and the dots are circles, both with the orientation of the original contour.
%    \begin{macrocode}
def capsule(left, right, y, radius):
    """Return a counterclockwise capsule between left and right."""
    a, b = left + radius, right - radius
    return [*([((a, y - radius), (b, y - radius))] if b > a else []),
            quarter((b, y - radius), (right, y), True),
            quarter((right, y), (b, y + radius), False),
            *([((b, y + radius), (a, y + radius))] if b > a else []),
            quarter((a, y + radius), (left, y), True),
            quarter((left, y), (a, y - radius), False)]


def area(contour):
    """Return the signed area of a contour."""
    points = samples(contour)
    return sum(x0 * y1 - x1 * y0 for (x0, y0), (x1, y1)
               in zip(points, points[1:] + points[:1])) / 2


def reverse(contour):
    """Return a contour with the opposite orientation."""
    return [segment[::-1] for segment in contour[::-1]]
%    \end{macrocode}
%
% \begin{macro}{DASH}
% \begin{macro}{DOT}
% The visible shaft reaches from its left end to the start of the arrowhead.
% The lengths below are given in units of the thickness of the shaft.
% Both shafts end in a stub of the length "STUB" before the arrowhead, which is preceded by a gap.
% The dashed shaft consists of two dashes before the stub, separated by gaps of the length "GAP".
% If the dashes would be shorter than "DASH", there is only one.
% The dotted shaft consists of three dots of the diameter "DOT".
% If the gaps between them would be smaller than "SPACE", the dots shrink down to "MINDOT" and then their number decreases.
% Thus the two patterns differ in the number and the length of their elements.
% The lengths are adjusted, so that the pattern fills the shaft exactly.
% The left end of the shaft and thus the bounding box are kept.
%    \begin{macrocode}
DASH, GAP, STUB = 1.3, 0.75, 0.6
DOT, MINDOT, SPACE = 1.3, 0.85, 0.5


def dashes(left, stub, thick):
    """Return the left ends of the dashes and their length."""
    for count in (2, 1):
        pitch = (stub - left) / count
        dash = pitch - GAP * thick
        if dash >= DASH * thick or count == 1:
            return [left + step * pitch for step in range(count)], dash


def dots(left, stub, thick):
    """Return the left ends of the dots and their diameter."""
    for count in (3, 2, 1):
        pitch = (stub - left) / count
        diameter = min(DOT * thick, pitch - SPACE * thick)
        if diameter >= MINDOT * thick or count == 1:
            return [left + step * pitch for step in range(count)], diameter


def pattern(glyph, style):
    """Return the contours of a glyph with a dashed or dotted shaft."""
    original, = contours(glyph)
    left, top, bottom, head = shaft(original)
    thick, y = top - bottom, (top + bottom) / 2
    stub = head - STUB * thick
    if style == 'dashed':
        starts, length = dashes(left, stub, thick)
        radius = thick / 2
    else:
        starts, length = dots(left, stub, thick)
        radius = length / 2
    shapes = [capsule(start, start + length, y, radius)
              for start in starts]
    if area(original) < 0:
        shapes = [reverse(shape) for shape in shapes]
    return shapes + [cut_shaft(original, stub + thick / 2)]
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% Draw the contours into a TrueType glyph, approximating the cubic curves by quadratic ones within $0.5$ units.
% The PostScript fonts orient their outer contours counterclockwise, TrueType fonts clockwise.
%    \begin{macrocode}
def truetype(shapes):
    """Return a TrueType glyph of the contours."""
    pen = TTGlyphPen(None)
    cubic = Cu2QuPen(pen, 0.5, reverse_direction=True)
    for contour in shapes:
        cubic.moveTo(contour[0][0])
        for segment in contour:
            if len(segment) == 2:
                cubic.lineTo(segment[1])
            else:
                cubic.curveTo(*segment[1:])
        cubic.closePath()
    return pen.glyph()
%    \end{macrocode}
%
% The vector accent is the slot $126$ of the math italic fonts and the combining right arrow above in the \NCM math fonts.
% The width of a Type~1 glyph is only known after its outline has been drawn.
%    \begin{macrocode}
def accent_glyph(name):
    """Return the glyph set, glyph name and width of a vector accent."""
    if name in ACCENT_UNICODE:
        font = TTFont(kpse(name + '.otf'))
        glyph = font.getBestCmap()[0x20D7]
        return font.getGlyphSet(), glyph, font['hmtx'][glyph][0]
    pfb, _ = mapfiles(name)
    glyphs = type1(pfb).getGlyphSet()
    glyph = encoding(name)[126]
    glyphs[glyph].draw(RecordingPen())
    return glyphs, glyph, glyphs[glyph].width
%    \end{macrocode}
%
% The math table of the font contains the accent attachments of the original glyphs and the constants of the \NCM math font.
% Without it the Unicode engines would treat the font as a traditional font and centre the accents.
%    \begin{macrocode}
def math_table(order, attachments):
    """Return a math table with the given accent attachments."""
    source = TTFont(kpse(ACCENT_UNICODE[0] + '.otf'))['MATH'].table
    table = otTables.MATH()
    table.Version = 0x00010000
    table.MathConstants = copy.deepcopy(source.MathConstants)
    names = [name for name in order if name in attachments]
    top = otTables.MathTopAccentAttachment()
    top.TopAccentCoverage = otTables.Coverage()
    top.TopAccentCoverage.glyphs = names
    top.TopAccentAttachmentCount = len(names)
    top.TopAccentAttachment = []
    for name in names:
        record = otTables.MathValueRecord()
        record.Value = attachments[name]
        record.DeviceTable = None
        top.TopAccentAttachment.append(record)
    info = otTables.MathGlyphInfo()
    info.MathItalicsCorrectionInfo = None
    info.MathTopAccentAttachment = top
    info.ExtendedShapeCoverage = None
    info.MathKernInfo = None
    table.MathGlyphInfo = info
    variants = otTables.MathVariants()
    variants.MinConnectorOverlap = source.MathVariants.MinConnectorOverlap
    variants.VertGlyphCoverage = variants.HorizGlyphCoverage = None
    variants.VertGlyphCount = variants.HorizGlyphCount = 0
    variants.VertGlyphConstruction = []
    variants.HorizGlyphConstruction = []
    table.MathVariants = variants
    math_font = newTable('MATH')
    math_font.table = table
    return math_font


def top_accent(name, glyph):
    """Return the accent attachment of a glyph of a Unicode font."""
    font = TTFont(kpse(name + '.otf'))
    top = font['MATH'].table.MathGlyphInfo.MathTopAccentAttachment
    return top.TopAccentAttachment[
        top.TopAccentCoverage.glyphs.index(glyph)].Value
%    \end{macrocode}
%
% Write the TrueType font with a glyph for each accent and source font.
% The glyphs of the Unicode fonts get consecutive private use characters, starting at the character of their accent.
% The glyphs of the math italic fonts are only addressed by their names through the encoding \file{hepaccent.enc}, which the \TFM file \file{hepaccent.tfm} and the map line use.
% The \TFM file copies the metrics of the original glyphs.
% \hologo{XeTeX} expects every font to contain a space.
% Return the slots of the \TFM file by source font and accent pattern.
%    \begin{macrocode}
def accent_font(accents):
    """Write the accent font with its TFM, encoding and map line."""
    names, glyphs, widths, attachments = ['.notdef', 'space'], {}, {}, {}
    for name, width in (('.notdef', 0), ('space', 333)):
        glyphs[name], widths[name] = TTGlyphPen(None).glyph(), width
    cmap = {0x20: 'space'}
    slots, pl = {}, ['(DESIGNSIZE R 10)', '(CODINGSCHEME HEPACCENT)',
                     '(FONTDIMEN (SLANT R 0.0) (QUAD R 1.0))']
    for source in ACCENT_SOURCES + ACCENT_UNICODE:
        glyphset, glyph, width = accent_glyph(source)
        for accent in accents:
            name = f'uni20D7.{accent["pattern"]}.{source}'
            names.append(name)
            glyphs[name] = truetype(pattern(glyphset[glyph],
                                            accent['pattern']))
            widths[name] = width
            if source in ACCENT_UNICODE:
                cp = accent['unicode'] + ACCENT_UNICODE.index(source)
                cmap[cp] = name
                attachments[name] = top_accent(source, glyph)
                continue
            slot = len(slots)
            slots[source, accent['pattern']] = slot
            metrics = tfm(source).chars[126]
            pl.append(f'(CHARACTER D {slot} ' + ' '.join(
                f'({key} {pl_value(metrics.get(value, 0))})'
                for key, value in METRICS) + ')')
    builder = FontBuilder(1000, isTTF=True)
    builder.setupGlyphOrder(names)
    builder.setupCharacterMap(cmap)
    builder.setupGlyf(glyphs)
    table = builder.font['glyf']
    for name in names:
        table[name].recalcBounds(table)
    builder.setupHorizontalMetrics(
        {name: (round(widths[name]), getattr(table[name], 'xMin', 0))
         for name in names})
    builder.setupHorizontalHeader(ascent=800, descent=-200)
    builder.setupNameTable(dict(
        familyName='HEP Math Accents', styleName='Regular',
        psName='HEPMathAccents', version='Version 1.0',
        copyright='Derived from Latin Modern, sansmathfonts and New '
                  'Computer Modern under the GUST Font License'))
    builder.setupOS2(fsType=0, sTypoAscender=800, sTypoDescender=-200,
                     usWinAscent=800, usWinDescent=200)
    builder.setupPost()
    builder.font['MATH'] = math_table(names, attachments)
    builder.save(str(ROOT / (ACCENT_FONT + '.ttf')))
    vector = [name for name in names
              if name.split('.')[-1] in ACCENT_SOURCES]
    vector += ['.notdef'] * (256 - len(vector))
    (ROOT / (ACCENT_FONT + '.enc')).write_text(
        f'/{ACCENT_FONT.upper()} [\n' +
        '\n'.join('/' + glyph for glyph in vector) + '\n] def\n')
    path = TEMP / (ACCENT_FONT + '.pl')
    path.write_text('\n'.join(pl) + '\n')
    subprocess.run(['pltotf', str(path),
                    str(ROOT / (ACCENT_FONT + '.tfm'))],
                   check=True, stdout=subprocess.DEVNULL)
    line = (f'{ACCENT_FONT} <{ACCENT_FONT}.enc <{ACCENT_FONT}.ttf')
    MAPS[ACCENT_FONT] = (line, line)
    return slots
%    \end{macrocode}
%
% \subsection{Fonts}
%
% Write the eight "hepalpha" banks for the three families and the proportional typewriter in medium and bold weight at three sizes.
% The upright glyphs are placed $128$ slots above the italic ones.
% The accents follow the italic glyphs.
% They are copied from the math italic font of the family and weight, whose x-height the bank adopts, because \TeX\ lowers an accent by the x-height of its font.
%    \begin{macrocode}
def alphabets(glyphs, accents, accent_slots):
    """Write the banks: serif, sans, mono, proportional times weight."""
    for family in range(4):
        for bold in range(2):
            bank = 2 * family + bold
            for size in (5, 7, 10):
                italic = accent_source(family, bold, size)
                rows = [(accent['slot'], ACCENT_FONT,
                         accent_slots[italic, accent['pattern']])
                        for accent in accents]
                for up in range(2):
                    for glyph in glyphs:
                        kind, slot = classify(glyph)
                        font, cp = source(kind, slot, glyph, family, bold,
                                          up, size)
                        rows.append((glyph['index'] + 128 * up, font, cp))
                fonts = list(dict.fromkeys(font for _, font, _ in rows))
                vpl = [f'(VTITLE HEP CM alphabets bank {bank})',
                       '(FAMILY HEPALPHA)', f'(DESIGNSIZE R {size})',
                       '(CODINGSCHEME HEP MATH ALPHABETS)',
                       '(FONTDIMEN (SLANT R 0.0) (SPACE R 0.0) '
                       '(STRETCH R 0.0) (SHRINK R 0.0) (XHEIGHT '
                       f'{pl_value(tfm(italic).fontdimens["XHEIGHT"])}) '
                       '(QUAD R 1.0))']
                vpl += mapfonts(fonts)
                vpl += [character(slot, fonts, font, cp)
                        for slot, font, cp in rows]
                vpl.append('(CHARACTER D 255 (CHARWD R 0.0) (MAP))')
                vpl += skew_kerns((slot, skew(font, cp))
                                  for slot, font, cp in rows)
                write(vpl, f'hepalpha{bank}-{size}')
%    \end{macrocode}
%
% Write the "hepdecor" banks.
% For "symbols=minion" the banks $0$ to $3$ contain all four decorative alphabets for the serif and sans-serif blackboard in medium and bold weight.
% Otherwise the banks $4$ and $5$ contain the fraktur alphabet in medium and bold weight, followed by the four composable italic calligraphic alphabets.
% The serif alphabets use the \LM calligraphic capitals, as the \NCM math font of the Unicode engines does.
% The calligraphic capitals of the \CM sans symbol fonts only retrace them, so the sans-serif alphabets use the Zapf Chancery capitals of the \software{mathalpha} package instead, which exist in a single weight and design size.
% They are scaled to the median capital height of the \LM capitals, and the bold alphabet overprints them.
% The RSFS and double-stroke fonts have no bold weight.
% MnSymbol uses the skew character $0$, RSFS uses $127$, the \LM symbol fonts use $48$ and Zapf Chancery uses $45$.
%    \begin{macrocode}
CAL_FONTS = (('lmsy', True, 48, 0), ('lmbsy', True, 48, 0),
             ('urwchancal', False, 45, 0),
             ('urwchancal', False, 45, BOLD))


def capitals(name):
    """Return the median height of the capitals of a font."""
    chars = tfm(name).chars
    return statistics.median(chars[cp]['height'] for cp in range(65, 91))


SCALE['urwchancal'] = round(capitals('lmsy10')
                            / capitals('urwchancal'), 3)
%    \end{macrocode}
%
% Each calligraphic or script alphabet of a list of sources occupies the same number of consecutive slots, starting at "first".
%    \begin{macrocode}
def capital_rows(sources, cal, size, first=0):
    """Return the rows of consecutive capital alphabets."""
    rows = []
    for index, (name, sized, char, bold) in enumerate(sources):
        font = name + str(size) if sized else name
        rows += [(first + len(cal) * index + slot, font, cp, char, bold)
                 for slot, cp in enumerate(cal)]
    return rows
%    \end{macrocode}
%
% Write a font with the given rows of slot, source font, source slot, skew character and bold radius.
%    \begin{macrocode}
def write_rows(rows, size, title, name):
    """Write a virtual font of decorative glyphs."""
    fonts = list(dict.fromkeys(row[1] for row in rows))
    vpl = [f'(VTITLE HEP {title})', f'(DESIGNSIZE R {size})',
           '(FONTDIMEN (SLANT R 0.0) (SPACE R 0.0) '
           '(XHEIGHT R 0.430555) (QUAD R 1.0))']
    vpl += mapfonts(fonts)
    vpl += [character(slot, fonts, font, cp, bold)
            for slot, font, cp, _, bold in rows]
    vpl.append('(CHARACTER D 255 (CHARWD R 0.0) (MAP))')
    vpl += skew_kerns(
        (slot, SCALE.get(font, 1) * tfm(PROXY.get(font, font))
         .kerning.get(cp, {}).get(skew, 0) + bold
         if skew is not None else 0)
        for slot, font, cp, skew, bold in rows)
    write(vpl, name)


def decorations(rows, cal):
    """Write the decorative banks of symbols=minion, true and ams."""
    assert len(rows) + len(CAL_FONTS) * len(cal) < 255
    banks = [(2 * sans + bold, sans, bold) for sans in range(2)
             for bold in range(2)] + [(4, None, 0), (5, None, 1)]
    skewchar = dict(mathcal=0, mathscr=127)
    for bank, sans, bold in banks:
        for size in (5, 7, 10):
            sources = {'mathfrak': ('eufb' if bold else 'eufm')
                                   + str(size)}
            if sans is not None:
                sources['mathscr'] = 'rsfs' + str(size)
                sources['mathcal'] = ('MnSymbolS' + ('-Bold' if bold
                                                     else '') + str(size))
                sources['mathbb'] = ('dsss' if sans else 'dsrom') + '10'
            used = [(slot, sources[alphabet], cp,
                     skewchar.get(alphabet), 0)
                    for alphabet, cp, slot in rows if alphabet in sources]
            if sans is None:
                used += capital_rows(CAL_FONTS, cal, size, len(rows))
            write_rows(used, size, 'decorative alphabets',
                       f'hepdecor{bank}-{size}')
%    \end{macrocode}
%
% Write the "hepscript" fonts with the italic and upright script and the upright calligraphic alphabets in medium and bold weight.
% The italic script uses the RSFS capitals and the bold alphabet overprints them.
% The upright script uses the less slanted RSFS capitals of the \software{rsfso} package, whose virtual fonts only add the metrics and accent kerns for the skew character $45$ to the slanted base fonts.
% Their glyphs are taken from the base fonts and their metrics from the virtual fonts.
% The upright calligraphic alphabets use the Euler script, which has the skew character $48$.
%    \begin{macrocode}
SCRIPT_FONTS = (('rsfs', True, 127, 0), ('rsfs', True, 127, BOLD),
                ('rrsfso', True, 45, 0), ('rrsfso', True, 45, BOLD),
                ('eusm', True, 48, 0), ('eusb', True, 48, 0))
PROXY.update(('rrsfso' + str(size), 'rsfso' + str(size))
             for size in (5, 7, 10))


def scripts(cal):
    """Write the script fonts used by symbols=true and ams."""
    assert len(SCRIPT_FONTS) * len(cal) < 255
    for size in (5, 7, 10):
        write_rows(capital_rows(SCRIPT_FONTS, cal, size), size,
                   'script alphabets', f'hepscript-{size}')
%    \end{macrocode}
%
% Write the "hepbb" fonts with the serif and sans-serif blackboard in medium and bold weight.
% Each alphabet occupies the same number of consecutive slots.
% The \NCM blackboard of the \software{mathalpha} package is addressed by the glyph names of its Unicode characters, the \software{bboldx} fonts by the input characters.
% The \NCM blackboard uses the skew character $45$, \software{bboldx} has no accent kerns.
%    \begin{macrocode}
def blackboard(chars):
    """Write the blackboard fonts used by symbols=true."""
    sources = ['mathalpha-ncmbb-regular', 'mathalpha-ncmbb-bold',
               'BBOLDX-Regular', 'BBOLDX-Bold']
    rows = []
    for bank, name in enumerate(sources):
        for index, (char, cp) in enumerate(chars):
            if name.startswith('mathalpha'):
                glyph = f'uni{cp:04X}' if cp < 0x10000 else f'u{cp:X}'
                char = encoding(name).index(glyph)
            rows.append((len(chars) * bank + index, name, char))
    for size in (5, 7, 10):
        vpl = ['(VTITLE HEP blackboard alphabets)',
               f'(DESIGNSIZE R {size})',
               '(FONTDIMEN (SLANT R 0.0) (SPACE R 0.0) '
               '(XHEIGHT R 0.430555) (QUAD R 1.0))']
        vpl += mapfonts(sources)
        vpl += [character(slot, sources, name, char)
                for slot, name, char in rows]
        vpl.append('(CHARACTER D 255 (CHARWD R 0.0) (MAP))')
        vpl += skew_kerns(
            (slot, tfm(name).kerning.get(char, {}).get(45, 0)
             if name.startswith('mathalpha') else 0)
            for slot, name, char in rows)
        write(vpl, f'hepbb-{size}')
%    \end{macrocode}
%
% Read the package, write all fonts, the encoding of the generated base fonts and the two map files.
%    \begin{macrocode}
def main():
    sty = (ROOT / 'hep-math-font.sty').read_text()
    glyphs = glyph_table(sty)
    accents = accent_table(sty, glyphs)
    alphabets(glyphs, accents, accent_font(accents))
    decorations(decor_table(sty), cal_table(sty))
    scripts(cal_table(sty))
    blackboard(bb_table(sty))
    vector = GLYPHS + ['.notdef'] * (256 - len(GLYPHS))
    (ROOT / (ENCODING + '.enc')).write_text(
        f'/{ENCODING.upper()} [\n' +
        '\n'.join('/' + glyph for glyph in vector) + '\n] def\n')
    for suffix, index in (('', 0), ('-fallback', 1)):
        (ROOT / f'{ENCODING}{suffix}.map').write_text(
            ''.join(lines[index] + '\n' for lines in MAPS.values()))
    shutil.rmtree(TEMP)
    print('Built the hepalpha, hepdecor, hepscript and hepbb fonts '
          'and the accent font')


if __name__ == '__main__':
    main()
