% \begin{macro}{\hep_math_cal_select:}
% \begin{macro}{\hep_math_cal_map:nnn}
% Select the serif or the sans-serif math face for the italic calligraphic capitals and the Euler math font for the upright ones.
% Select the serif or the sans-serif script face, with "synthetic=false" always the italic one.
% The typewriter family uses the sans-serif capitals, whose strokes have a uniform width.
% Map the input character "#2" to the script character "#3", or for bold to the bold script character, which has no gaps in Unicode.
%    \begin{macrocode}
  \cs_new_protected:Npn \hep_math_cal_select: {
    \int_set:Nn \l__hep_cal_family_int {
      \bool_if:NTF \l__hep_scr_bool {
        \use:c {
          symhep \str_if_eq:VnF \l__hep_family_tl {serif} {sans} scr
          \ifhepmathfont@synthetic
            \bool_if:NT \l__hep_up_bool {up}
          \fi
        }
      }{
        \bool_if:NTF \l__hep_up_bool {\symhepeuler} {
          \str_if_eq:VnTF \l__hep_family_tl {serif}
            {\symhepserif}{\symhepsans}
        }
      }
    }
  }
  \cs_new_protected:Npn \hep_math_cal_map:nnn #1#2#3 {
    \Umathcode #2 = 7~\l__hep_cal_family_int~\int_eval:n {
      \bool_if:NTF \l__hep_bold_bool {"1D4D0+#2-`A}{#3}
    }\scan_stop:
  }
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\hep_math_glyph:nnnnnnn}
% Register a glyph with its slot "#1", its macro name "#2", the name "#3" of its text command, and its four Unicode characters.
% The math codes of the upright and the italic character are set.
% Greek letter macros select the character by its math code.
%    \begin{macrocode}
  \cs_new_protected:Npn \hep_math_glyph:nnnnnnn #1#2#3#4#5#6#7 {
    \tl_gput_right:Nn \g__hep_glyph_setup_tl
      {\hep_math_map:nnnnn {#1}{#4}{#5}{#6}{#7}}
    \tl_gput_right:Nn \g__hep_math_codes_tl {{#4}{#5}}
    \tl_if_empty:nF {#2} {
      \cs_gset:cpn {hep_math_char_#1:}{\char_generate:nn {#4}{12}}
      \hep_math_greek_record:nnn {#1}{#2}{#3}
    }
  }
%    \end{macrocode}
