%
% \begin{macro}{\__hep_math_cal:nnn}
% Register "#2" consecutive calligraphic characters starting at the hexadecimal input character "#1" and the hexadecimal Unicode script character "#3".
% Unicode does not distinguish calligraphic and script characters, so the same rows serve both alphabets.
% The row order determines the slots within each calligraphic and script alphabet of the virtual fonts.
%    \begin{macrocode}
\int_new:N \g__hep_math_cal_int
\cs_new_protected:Npn \__hep_math_cal:nnn #1#2#3 {
