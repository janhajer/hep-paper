%
% \subsection{Modifiers}
%
% \begin{macro}{\__hep_math_map:}
% Map all characters of the glyph table to the current state.
% The blackboard alphabet then replaces the Latin letters and digits, and the calligraphic or script alphabet the capitals.
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_math_map: {
  \tl_use:N \g__hep_glyph_setup_tl
  \bool_if:NT \l__hep_bb_bool {
    \hep_math_bb_select:
    \tl_use:N \g__hep_bb_setup_tl
  }
  \bool_lazy_or:nnT {\l__hep_cal_bool}{\l__hep_scr_bool} {
    \hep_math_cal_select:
    \tl_use:N \g__hep_cal_setup_tl
  }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\l__hep_state_tl}
% \begin{macro}{\l__hep_applied_tl}
% \begin{macro}{\g__hep_cache_bool}
% The name of the current state, and the name of the state whose math codes are in effect, which is empty if other code has changed the math codes since.
% Both are local like the math codes.
% Math codes are only cached in the document body, after all math families have been allocated.
%    \begin{macrocode}
\tl_new:N \l__hep_state_tl
\tl_new:N \l__hep_applied_tl
\bool_new:N \g__hep_cache_bool
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\hep_math_apply:}
% Reset the math family set by "\fam" and apply the current state to all characters of the glyph table.
% The math codes are local, so the formula is parsed as usual.
% Mapping a character requires several decisions, which only depend on the state, so the resulting math codes of each state are cached the first time it is used.
% Nothing has to be done if the math codes of the state are already in effect, which is the case for most formulas.
% The backend selection is cheap and also sets the variables used by the Greek letter macros.
%    \begin{macrocode}
\cs_new_protected:Npn \hep_math_apply: {
  \tex_fam:D -1\scan_stop:
  \hep_math_backend_select:
  \tl_set:Ne \l__hep_state_tl {
    \l__hep_family_tl
    \bool_if:NT \l__hep_bold_bool {-bold}
    \bool_if:NT \l__hep_up_bool {-up}
    \bool_if:NT \l__hep_bb_bool {-bb}
    \bool_if:NT \l__hep_cal_bool {-cal}
    \bool_if:NT \l__hep_scr_bool {-scr}
  }
  \tl_if_eq:NNF \l__hep_state_tl \l__hep_applied_tl {
    \bool_if:NTF \g__hep_cache_bool
      {\__hep_math_cached_map:}
      {\__hep_math_map:}
    \tl_set_eq:NN \l__hep_applied_tl \l__hep_state_tl
  }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\__hep_math_cached_map:}
% Use the cached math codes of the current state, or map the characters and save their math codes.
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_math_cached_map: {
  \tl_if_exist:cTF {g__hep_state_ \l__hep_state_tl _tl}
    {\tl_use:c {g__hep_state_ \l__hep_state_tl _tl}}
    {
      \__hep_math_map:
      \tl_gset:ce {g__hep_state_ \l__hep_state_tl _tl} {
        \tl_map_function:NN \g__hep_math_codes_tl
          \__hep_math_saved_code:n
      }
    }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\__hep_math_native:}
% Restore the original math codes of the characters, which are no longer those of a state.
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_math_native: {
  \tl_use:N \g__hep_native_codes_tl
  \tl_clear:N \l__hep_applied_tl
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\__hep_math_alphabet:n}
% Set the flag "#1" of the blackboard, calligraphic and script alphabets and clear the other two, or all three for an empty argument.
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_math_alphabet:n #1 {
  \clist_map_inline:nn {bb, cal, scr} {
    \str_if_eq:nnTF {##1}{#1}
      {\bool_set_true:c {l__hep_##1_bool}}
      {\bool_set_false:c {l__hep_##1_bool}}
  }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep_math_modify:nn}
% Apply the attributes in the list "#1" to the math "#2" within a group.
% Bold and upright accumulate, and the innermost family and the innermost of blackboard, calligraphic and script win.
% With "mathsf=contrast" "sf" selects the family opposite to the main family of the document, independent of the current family.
%    \begin{macrocode}
\cs_new_protected:Npn \hep_math_modify:nn #1#2 {
  \group_begin:
  \clist_map_inline:nn {#1} {
    \str_case:nn {##1} {
      {bold}{\bool_set_true:N \l__hep_bold_bool}
      {bb}{\__hep_math_alphabet:n {bb}}
      {cal}{\__hep_math_alphabet:n {cal}}
      {scr}{\__hep_math_alphabet:n {scr}}
      {up}{\bool_set_true:N \l__hep_up_bool}
      {it}{\bool_set_false:N \l__hep_up_bool}
      {mono}{\tl_set:Nn \l__hep_family_tl {mono}}
      {serif}{\tl_set:Nn \l__hep_family_tl {serif}}
      {sf}{
        \tl_set:Nn \l__hep_family_tl {sans}
        \bool_lazy_and:nnT
          {\str_if_eq_p:Vn \hepmathfont@mathsf {contrast}}
          {\str_if_eq_p:Vn \g__hep_main_family_tl {sans}}
          {\tl_set:Nn \l__hep_family_tl {serif}}
      }
    }
  }
  \hep_math_apply:
  #2
  \group_end:
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\l__hep_native_bool}
% Some packages typeset text in math mode and rely on the original math codes.
% This flag disables the initialisation of the math alphabets there.
%    \begin{macrocode}
\bool_new:N \l__hep_native_bool
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep_math_initialize:}
% Each formula starts italic and without blackboard, calligraphic and script in the family and weight of the surrounding text.
% The bold math version also selects bold.
%    \begin{macrocode}
\cs_new_protected:Npn \hep_math_initialize: {
  \bool_if:NF \l__hep_native_bool {
    \tl_set_eq:NN \l__hep_family_tl \l__hep_text_family_tl
    \bool_set_eq:NN \l__hep_bold_bool \l__hep_text_bold_bool
    \str_if_eq:eeT {\math@version}{bold}
      {\bool_set_true:N \l__hep_bold_bool}
    \bool_set_false:N \l__hep_up_bool
    \__hep_math_alphabet:n {}
    \hep_math_apply:
  }
}
%    \end{macrocode}
% \end{macro}
%
% \subsection{User commands}
%
% Define the user commands at the end of the beginning of the document, after \software{unicode-math} has defined its own commands.
% Determine the main family again and define the Greek letter macros.
% The math fonts were selected for the main family detected when the package was loaded, so warn if it has changed since.
%    \begin{macrocode}
\AddToHook{begindocument/end}{
  \tl_set_eq:NN \l_tmpa_tl \g__hep_main_family_tl
  \hep_math_detect_family:
  \tl_if_eq:NNF \l_tmpa_tl \g__hep_main_family_tl {
    \PackageWarningNoLine{hep-math-font}{
      The~main~family~changed~from~\l_tmpa_tl\space
      to~\g__hep_main_family_tl\space
      after~loading~the~package.\MessageBreak
      Load~hep-font~and~set~\protect\familydefault\space
      before~hep-math-font
    }
  }
  \tl_set_eq:NN \l__hep_text_family_tl \g__hep_main_family_tl
  \tl_use:N \g__hep_greek_setup_tl
%    \end{macrocode}
% \begin{macro}{\mathcal}
% \begin{macro}{\mathscr}
% \begin{macro}{\mathbb}
% \begin{macro}{\mathfrak}
% The decorative alphabets restore the original math codes of the input characters within their argument.
% For "symbols=true" the blackboard alphabet and for "symbols=true" and "ams" the calligraphic and script alphabets are composable instead.
%    \begin{macrocode}
  \clist_map_inline:nn {mathcal, mathscr, mathbb, mathfrak} {
    \cs_if_exist:cT {#1} {
      \cs_gset_eq:cc {hep_native_#1:}{#1}
      \cs_gset_protected:cpn {#1} ##1 {
        \group_begin:
        \__hep_math_native:
        \use:c {hep_native_#1:}{##1}
        \group_end:
      }
    }
  }
  \str_if_eq:VnT \hepmathfont@symbols {true}
    {\cs_gset_protected:Npn \mathbb #1 {\hep_math_modify:nn {bb}{#1}}}
  \exp_args:NnV \clist_if_in:nnT {true, ams} \hepmathfont@symbols {
    \cs_gset_protected:Npn \mathcal #1 {\hep_math_modify:nn {cal}{#1}}
    \cs_gset_protected:Npn \mathscr #1 {\hep_math_modify:nn {scr}{#1}}
  }
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \begin{macro}{\mathbf}
% \begin{macro}{\mathup}
% \begin{macro}{\mathrm}
% \begin{macro}{\mathit}
% \begin{macro}{\mathnormal}
% \begin{macro}{\mathsf}
% \begin{macro}{\mathtt}
% \begin{macro}{\mathserif}
% Define the composable commands.
%    \begin{macrocode}
  \cs_gset_protected:Npn \mathbf #1 {\hep_math_modify:nn {bold}{#1}}
  \cs_gset_protected:Npn \mathup #1 {\hep_math_modify:nn {up}{#1}}
  \cs_gset_eq:NN \mathrm \mathup
  \cs_gset_protected:Npn \mathit #1 {\hep_math_modify:nn {it}{#1}}
  \cs_gset_protected:Npn \mathnormal #1
    {\group_begin:\hep_math_initialize: #1\group_end:}
  \cs_gset_protected:Npn \mathsf #1 {\hep_math_modify:nn {sf}{#1}}
  \cs_gset_protected:Npn \mathtt #1 {\hep_math_modify:nn {mono}{#1}}
  \cs_gset_protected:Npn \mathserif #1 {\hep_math_modify:nn {serif}{#1}}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \begin{macro}{\mathbfrm}
% \begin{macro}{\mathbfup}
% \begin{macro}{\mathbfsf}
% \begin{macro}{\mathsfup}
% \begin{macro}{\mathsftext}
% \begin{macro}{\mathbfsfup}
% \begin{macro}{\mathbftt}
% \begin{macro}{\mathttup}
% \begin{macro}{\mathbfttup}
% Define the combined commands.
%    \begin{macrocode}
  \cs_gset_protected:Npn \mathbfrm #1 {\hep_math_modify:nn {bold,up}{#1}}
  \cs_gset_eq:NN \mathbfup \mathbfrm
  \cs_gset_protected:Npn \mathbfsf #1 {\hep_math_modify:nn {bold,sf}{#1}}
  \cs_gset_protected:Npn \mathsfup #1 {\hep_math_modify:nn {sf,up}{#1}}
  \cs_gset_eq:NN \mathsftext \mathsfup
  \cs_gset_protected:Npn \mathbfsfup #1
    {\hep_math_modify:nn {bold,sf,up}{#1}}
  \cs_gset_protected:Npn \mathbftt #1
    {\hep_math_modify:nn {bold,mono}{#1}}
  \cs_gset_protected:Npn \mathttup #1 {\hep_math_modify:nn {mono,up}{#1}}
  \cs_gset_protected:Npn \mathbfttup #1
    {\hep_math_modify:nn {bold,mono,up}{#1}}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% Initialise every inline and display formula.
% Also initialise the document itself, so that the state is defined when a document replaces "\everymath" or uses an alphabet command outside math.
%    \begin{macrocode}
  \everymath\expandafter{\the\everymath\hep_math_initialize:}
  \everydisplay\expandafter{\the\everydisplay\hep_math_initialize:}
  \bool_gset_true:N \g__hep_cache_bool
  \hep_math_initialize:
}
%    \end{macrocode}
%
% \subsection{Text state}
%
% Follow the family and weight declarations of the text, but not within math.
% The assignments are local, so that headings and groups do not change later formulas.
%    \begin{macrocode}
\AddToHook{cmd/rmfamily/after}
  {\mode_if_math:F{\tl_set:Nn\l__hep_text_family_tl{serif}}}
\AddToHook{cmd/sffamily/after}
  {\mode_if_math:F{\tl_set:Nn\l__hep_text_family_tl{sans}}}
\AddToHook{cmd/ttfamily/after}
  {\mode_if_math:F{\tl_set:Nn\l__hep_text_family_tl{mono}}}
\AddToHook{cmd/bfseries/after}
  {\mode_if_math:F{\bool_set_true:N\l__hep_text_bold_bool\boldmath}}
\AddToHook{cmd/mdseries/after}
  {\mode_if_math:F{\bool_set_false:N\l__hep_text_bold_bool\unboldmath}}
\AddToHook{cmd/normalfont/after}{
  \mode_if_math:F{
    \tl_set_eq:NN\l__hep_text_family_tl\g__hep_main_family_tl
    \bool_set_false:N\l__hep_text_bold_bool\unboldmath
  }
}
%    \end{macrocode}
%
% The \software{amsmath} package groups operator names such as "\sin" before it selects the operator font.
% Restore the original math codes there, so that operator names use the operator font.
%    \begin{macrocode}
\AddToHook{cmd/operator@font/after}{\__hep_math_native:}
%    \end{macrocode}
%
% The \software{url} package typesets its argument in math mode with the current text font as family~0.
% Its letters and digits select this family through their original math codes.
% Restore these codes and keep the formula from initialising the math alphabets.
% With the Unicode engines the list of original math codes is empty, and \software{unicode-math} switches to its literal math codes before the formula starts.
% The flag is local and ends with the group of the \URL.
%    \begin{macrocode}
\AddToHook{cmd/Url@MathSetup/after}{
  \bool_set_true:N \l__hep_native_bool
  \__hep_math_native:
}
%    \end{macrocode}
%
% \subsection{Bookmarks}
