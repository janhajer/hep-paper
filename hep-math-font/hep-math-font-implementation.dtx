% The accents follow the glyph table, so that their rows have to be the last ones.
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_math_accent:nnn #1#2#3 {
  \exp_args:Nnee \hep_math_accent:nnn {#1}
    {\int_use:N \g__hep_math_slot_int} {\int_from_hex:n {#3}}
  \int_gincr:N \g__hep_math_slot_int
}
