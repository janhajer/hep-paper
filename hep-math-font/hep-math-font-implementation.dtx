\__hep_math_bb:nnn {0052}{1}{211D}
\__hep_math_bb:nnn {0053}{7}{1D54A}
\__hep_math_bb:nnn {005A}{1}{2124}
\__hep_math_bb:nnn {0061}{26}{1D552}
