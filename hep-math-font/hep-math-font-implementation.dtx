% \subsubsection{Decorative alphabets}
%
% Pack the decorative alphabets into the "hepdecor" virtual fonts, whose slot 255 is an empty skew character, and use them as a single family.
% For "symbols=minion" these are all four decorative alphabets, because the MnSymbol fonts already use eight math families.
% They are provided in the banks $0$ to $3$ for the serif and sans-serif blackboard in medium and bold weight.
% Otherwise these are the Euler fraktur \cite{amsfonts} in the banks $4$ and $5$ for medium and bold weight.
% These banks also contain the four composable italic calligraphic alphabets after the decorative ones.
% The bold math version uses the bold bank.
%    \begin{macrocode}
  \str_if_eq:VnF \hepmathfont@symbols {false} {
    \int_step_inline:nnn {0}{5} {
      \DeclareFontFamily{U}{hepdecor#1}{\skewchar\font=255}
      \DeclareFontShape{U}{hepdecor#1}{m}{n}
        {<-6>hepdecor#1-5<6-9>hepdecor#1-7<9->hepdecor#1-10}{}
    }
    \int_set:Nn \l_tmpa_int {
      \str_if_eq:VnTF \hepmathfont@symbols {minion}
        {\str_if_eq:VnTF \g__hep_main_family_tl {sans} {2}{0}}{4}
    }
    \use:e {
      \exp_not:N \DeclareSymbolFont {hepdecor}{U}
        {hepdecor\int_use:N \l_tmpa_int}{m}{n}
      \exp_not:N \SetSymbolFont {hepdecor}{bold}{U}
        {hepdecor\int_eval:n {\l_tmpa_int+1}}{m}{n}
    }
%    \end{macrocode}
% \begin{macro}{\mathcal}
% \begin{macro}{\mathscr}
% \begin{macro}{\mathbb}
% \begin{macro}{\mathfrak}
% Each decorative alphabet command maps its characters to the packed family within a group.
%    \begin{macrocode}
    \clist_map_inline:nn {mathcal, mathscr, mathbb, mathfrak}
      {\tl_new:c {g__hep_decor_#1_tl}}
    \clist_set:Nn \l_tmpa_clist {mathfrak}
    \str_if_eq:VnT \hepmathfont@symbols {minion} {
      \clist_set:Nn \l_tmpa_clist {mathcal, mathscr, mathbb, mathfrak}
    }
    \clist_map_inline:Nn \l_tmpa_clist {
      \cs_set_protected:cpn {#1} ##1 {
        \group_begin:
        \tex_fam:D -1\scan_stop:
        \tl_use:c {g__hep_decor_#1_tl}
        \tl_clear:N \l__hep_applied_tl
        ##1\group_end:
      }
    }
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \begin{macro}{\hep_math_decor_glyph:nnn}
% Map the character "#2" of the alphabet "#1" to the slot "#3".
%    \begin{macrocode}
    \cs_new_protected:Npn \hep_math_decor_glyph:nnn #1#2#3 {
      \tl_gput_right:cn {g__hep_decor_#1_tl}
        {\mathcode #2=\int_eval:n {"7000+256*\symhepdecor+#3}\scan_stop:}
    }
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\__hep_math_decor:nnn}
% Register the "#3" consecutive characters starting at the hexadecimal character code "#2" of the alphabet "#1" in the next free slots.
%    \begin{macrocode}
    \int_new:N \g__hep_math_decor_int
    \cs_new_protected:Npn \__hep_math_decor:nnn #1#2#3 {
      \int_step_inline:nnn {0}{#3-1} {
        \use:e {
          \exp_not:N \hep_math_decor_glyph:nnn {#1}
            {\int_eval:n {\int_from_hex:n {#2}+##1}}
            {\int_use:N \g__hep_math_decor_int}
        }
        \int_gincr:N \g__hep_math_decor_int
      }
    }
%    \end{macrocode}
% \end{macro}
% The decorative glyph table is also read by the generator script of the virtual fonts.
% The slots of the decorative "\mathcal", "\mathscr" and "\mathbb" are empty in the banks $4$ and $5$.
% RSFS only contains capitals and the double-stroke blackboard \cite{dsfont} contains capitals and the characters h, k and 1.
%    \begin{macrocode}
    \__hep_math_decor:nnn {mathcal}{0041}{26}
    \__hep_math_decor:nnn {mathscr}{0041}{26}
    \__hep_math_decor:nnn {mathbb}{0041}{26}
    \__hep_math_decor:nnn {mathbb}{0068}{1}
    \__hep_math_decor:nnn {mathbb}{006B}{1}
    \__hep_math_decor:nnn {mathbb}{0031}{1}
    \__hep_math_decor:nnn {mathfrak}{0041}{26}
    \__hep_math_decor:nnn {mathfrak}{0061}{26}
    \__hep_math_decor:nnn {mathfrak}{0030}{10}
  }
%    \end{macrocode}
%
% \subsubsection{Script alphabets}
%
% For "symbols=true" and "ams" the "hepscript" virtual font contains the italic and the upright script and the upright calligraphic alphabets, each in medium and bold weight.
% It does not depend on the math version either.
%    \begin{macrocode}
  \exp_args:NnV \clist_if_in:nnT {true, ams} \hepmathfont@symbols {
    \DeclareFontFamily{U}{hepscript}{\skewchar\font=255}
    \DeclareFontShape{U}{hepscript}{m}{n}
      {<-6>hepscript-5<6-9>hepscript-7<9->hepscript-10}{}
    \DeclareSymbolFont{hepscript}{U}{hepscript}{m}{n}
  }
%    \end{macrocode}
%
% \subsubsection{Blackboard alphabet}
%
% For "symbols=true" the "hepbb" virtual font contains the \NCM blackboard of the \software{mathalpha} package and the sans-serif blackboard of the \software{bboldx} package, both in medium and bold weight.
% The blackboard does not depend on the math version, because the state already includes the weight.
%    \begin{macrocode}
  \str_if_eq:VnT \hepmathfont@symbols {true} {
    \DeclareFontFamily{U}{hepbb}{\skewchar\font=255}
    \DeclareFontShape{U}{hepbb}{m}{n}
      {<-6>hepbb-5<6-9>hepbb-7<9->hepbb-10}{}
    \DeclareSymbolFont{hepbb}{U}{hepbb}{m}{n}
  }
%    \end{macrocode}
%
% \subsubsection{Composable alphabets}
%
% The eight "hepalpha" virtual font families contain the serif, sans-serif, typewriter and proportional typewriter alphabets in medium and bold.
% Their lower half contains the italic and their upper half the upright shapes, slot 255 is an empty skew character.
% The fonts are provided at \unit[5]{pt}, \unit[7]{pt} and \unit[10]{pt}.
%    \begin{macrocode}
  \int_step_inline:nnn {0}{7} {
    \DeclareFontFamily{U}{hepalpha#1}{\skewchar\font=255}
    \DeclareFontShape{U}{hepalpha#1}{m}{n}
      {<-6>hepalpha#1-5<6-9>hepalpha#1-7<9->hepalpha#1-10}{}
  }
%    \end{macrocode}
%
% \begin{macro}{\__hep_math_bank:n}
% Only six banks are declared as symbol fonts to save math families.
% With the "proportional" option the typewriter banks $4$ and $5$ use the proportional font families $6$ and $7$.
% The bold math version uses the bold family of the same bank.
%    \begin{macrocode}
  \cs_new:Npn \__hep_math_bank:n #1 {
    \int_eval:n {#1 \ifhepmathfont@proportional
      \int_compare:nNnT {#1} > {3} {+2} \fi}
  }
  \int_step_inline:nnn {0}{5} {
    \use:e {
      \exp_not:N \DeclareSymbolFont {hepalpha#1}{U}
        {hepalpha\__hep_math_bank:n {#1}}{m}{n}
      \exp_not:N \SetSymbolFont {hepalpha#1}{bold}{U}
        {hepalpha\__hep_math_bank:n
          {2*\int_div_truncate:nn {#1}{2}+1}}{m}{n}
    }
  }
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Base fonts}
%
% The virtual fonts also refer to base fonts which the generator script derives from installed fonts.
% These are the CM Unicode and \LM text fonts in an encoding of their Greek letters and h-bar, and slanted copies of math fonts.
% Their map file declares the slanted copies with the "SlantFont" operator.
% With "synthetic=false" the alternative map file declares them without it, so that the original shapes are used.
%    \begin{macrocode}
  \pdfmapfile{=hep-math-font\ifhepmathfont@synthetic\else-fallback\fi.map}
%    \end{macrocode}
%
% \begin{macro}{\__hep_math_tounicode:nn}
% \begin{macro}{\__hep_math_tounicode:w}
% Some source fonts name their glyphs after the characters of a text encoding, so that the text extracted from the document would be wrong.
% Map the glyphs "#2", given as \meta{glyph}"="\meta{hexadecimal character} pairs, of the font "#1" to the correct Unicode characters, which only affects this font.
%    \begin{macrocode}
  \cs_new_protected:Npn \__hep_math_tounicode:nn #1#2 {
    \clist_map_inline:nn {#2}
      {\__hep_math_tounicode:w #1 / ##1 \q_stop}
  }
  \cs_new_protected:Npn \__hep_math_tounicode:w #1 / #2 = #3 \q_stop
    {\pdfglyphtounicode {tfm:#1/#2}{#3}}
  \cs_generate_variant:Nn \__hep_math_tounicode:nn {nV}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\c__hep_math_oml_clist}
% The \CM sans-serif math italic fonts and their slanted copies carry the glyph names of the T1 encoding in the slots of the OML encoding.
% The sans-serif \AMS blackboard does the same, the \AMS kappa symbol is named as the ordinary kappa, and the \LM math italic Delta and mu are named as the increment and micro signs.
%    \begin{macrocode}
  \clist_const:Nn \c__hep_math_oml_clist {
    grave=0393, acute=0394, circumflex=0398, tilde=039B,
    dieresis=039E, hungarumlaut=03A0, ring=03A3, caron=03A5,
    breve=03A6, macron=03A8, dotaccent=03A9, cedilla=03B1,
    ogonek=03B2, quotesinglbase=03B3, guilsinglleft=03B4,
    guilsinglright=03F5, quotedblleft=03B6, quotedblright=03B7,
    quotedblbase=03B8, guillemotleft=03B9, guillemotright=03BA,
    endash=03BB, emdash=03BC, cwm=03BD, perthousand=03BE,
    dotlessi=03C0, dotlessj=03C1, ff=03C3, fi=03C4, fl=03C5,
    ffi=03D5, ffl=03C7, space=03C8, exclam=03C9, quotedbl=03B5,
    numbersign=03D1, dollar=03D6, percent=03F1, ampersand=03C2,
    quoteright=03C6, parenleft=21BC, parenright=21BD,
    asterisk=21C0, plus=21C1, period=25B9, slash=25C3,
    colon=002E, semicolon=002C, equal=002F, question=22C6,
    at=2202, bracketleft=266D, backslash=266E, bracketright=266F,
    asciicircum=2323, underscore=2322, quoteleft=2113,
    braceleft=0131, bar=0237, braceright=2118
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\__hep_math_tounicode_sizes:n}
% Correct the glyph names of these fonts at all sizes, where "#1" is empty for the installed fonts and "hepslant-" for the slanted copies.
%    \begin{macrocode}
  \cs_new_protected:Npn \__hep_math_tounicode_sizes:n #1 {
    \int_step_inline:nnn {5}{10} {
      \__hep_math_tounicode:nV {#1cmssmi##1} \c__hep_math_oml_clist
      \__hep_math_tounicode:nV {#1cmssmib##1} \c__hep_math_oml_clist
      \__hep_math_tounicode:nn {#1ssmsbm##1}{braceleft=03F0}
      \__hep_math_tounicode:nn {#1msbm##1}{kappa=03F0}
      \__hep_math_tounicode:nn {#1lmmi##1}{Delta=0394, mu=03BC}
      \__hep_math_tounicode:nn {#1lmmib##1}{Delta=0394, mu=03BC}
    }
  }
  \__hep_math_tounicode_sizes:n {}
  \__hep_math_tounicode_sizes:n {hepslant-}
%    \end{macrocode}
% \end{macro}
%
% The CM Unicode fonts distinguish the Greek Delta, Omega and mu from the increment, ohm and micro signs by a suffix of the glyph name, which \hologo{pdfTeX} drops.
%    \begin{macrocode}
  \clist_map_inline:nn {rm, bx, ss, sx, tt, tb, it, tx} {
    \__hep_math_tounicode:nn {hep-cmun#1}
      {Delta=0394, Omega=03A9, mu=03BC}
  }
%    \end{macrocode}
%
% \begin{macro}{\hep_math_backend_select:}
% Select the bank $0$, $2$ or $4$ for serif, sans-serif or typewriter, plus one for bold, and the offset $128$ for upright.
%    \begin{macrocode}
  \cs_new_protected:Npn \hep_math_backend_select: {
    \int_set:Nn \l__hep_bank_int {
      \str_case:Vn \l__hep_family_tl {{serif}{0}{sans}{2}{mono}{4}}
    }
    \bool_if:NT \l__hep_bold_bool {\int_incr:N \l__hep_bank_int}
    \int_set:Nn \l__hep_selected_family_int
      {\use:c {symhepalpha\int_use:N \l__hep_bank_int}}
    \int_zero:N \l__hep_offset_int
    \bool_if:NT \l__hep_up_bool
      {\int_set:Nn \l__hep_offset_int {128}}
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep_math_map:nnnnn}
% Map the input character "#2" to the slot "#1" in the selected half of the selected bank.
% Only characters below 128 can be input directly.
%    \begin{macrocode}
  \cs_new_protected:Npn \hep_math_map:nnnnn #1#2#3#4#5 {
    \int_compare:nNnT {#2} < {128} {
      \mathcode #2 = \int_eval:n {
        "7000 + 256 * \l__hep_selected_family_int
        + \l__hep_offset_int + #1
      }\scan_stop:
    }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep_math_bb_select:}
% \begin{macro}{\hep_math_bb_map:nnn}
% Select the blackboard alphabet $0$ to $3$ for serif and sans-serif in medium and bold weight.
% The typewriter family uses the serif alphabet.
% Map the input character "#2" to the slot "#1" of the selected alphabet.
%    \begin{macrocode}
  \cs_new_protected:Npn \hep_math_bb_select: {
    \int_set:Nn \l__hep_bb_family_int {\symhepbb}
    \int_set:Nn \l__hep_bb_offset_int {
      \g__hep_math_bb_int * (
        \str_if_eq:VnTF \l__hep_family_tl {sans} {2}{0}
        + \bool_if:NTF \l__hep_bold_bool {1}{0}
      )
    }
  }
  \cs_new_protected:Npn \hep_math_bb_map:nnn #1#2#3 {
    \mathcode #2 = \int_eval:n {
      "7000 + 256 * \l__hep_bb_family_int + \l__hep_bb_offset_int + #1
    }\scan_stop:
  }
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\hep_math_bb_glyph:nn}
% The \software{bboldx} fonts name their glyphs after the ASCII characters.
% Map the glyph of the input character "#1" to the blackboard character "#2".
%    \begin{macrocode}
  \cs_new_protected:Npn \hep_math_bb_glyph:nn #1#2 {
    \clist_map_inline:nn {Regular, Bold} {
      \pdfglyphtounicode {
        tfm:BBOLDX-##1/
        \int_compare:nNnTF {#1} < {58} {
          \clist_item:nn
            {zero, one, two, three, four, five, six, seven, eight, nine}
            {#1-47}
        }{\char_generate:nn {#1}{12}}
      }{\int_to_Hex:n {#2}}
    }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep_math_cal_select:}
% \begin{macro}{\__hep_math_script_select:}
% \begin{macro}{\__hep_math_cal_select:}
% \begin{macro}{\hep_math_cal_map:nnn}
% Select the italic calligraphic alphabet $0$ to $3$ for serif and sans-serif in medium and bold weight, which follow the decorative alphabets in the "hepdecor" virtual fonts.
% With "synthetic=false" the sans-serif and typewriter families use the medium alphabet in both weights.
% The typewriter family uses the sans-serif alphabet.
% The script alphabets $0$ to $3$ of the "hepscript" virtual fonts are italic and upright in medium and bold weight, the alphabets $4$ and $5$ are the upright calligraphic alphabets.
% With "synthetic=false" the medium italic script alphabet is used.
% Map the input character "#2" to the slot "#1" of the selected alphabet.
%    \begin{macrocode}
  \cs_new_protected:Npn \hep_math_cal_select: {
    \bool_lazy_or:nnTF {\l__hep_scr_bool}{\l__hep_up_bool}
      {\__hep_math_script_select:}{\__hep_math_cal_select:}
  }
  \cs_new_protected:Npn \__hep_math_script_select: {
    \int_set:Nn \l__hep_cal_family_int {\symhepscript}
    \int_set:Nn \l__hep_cal_offset_int {
      \g__hep_math_cal_int * (
        \bool_if:NTF \l__hep_bold_bool {1}{0}
        + \bool_if:NTF \l__hep_scr_bool
          {\bool_if:NTF \l__hep_up_bool {2}{0}}{4}
      )
    }
    \ifhepmathfont@synthetic\else
      \bool_if:NT \l__hep_scr_bool
        {\int_zero:N \l__hep_cal_offset_int}
    \fi
  }
  \cs_new_protected:Npn \__hep_math_cal_select: {
    \int_set:Nn \l__hep_cal_family_int {\symhepdecor}
    \int_set:Nn \l__hep_cal_offset_int
      {\bool_if:NTF \l__hep_bold_bool {1}{0}}
    \str_if_eq:VnF \l__hep_family_tl {serif} {
      \ifhepmathfont@synthetic\else
        \int_zero:N \l__hep_cal_offset_int
      \fi
      \int_add:Nn \l__hep_cal_offset_int {2}
    }
    \int_set:Nn \l__hep_cal_offset_int {
      \g__hep_math_decor_int
      + \g__hep_math_cal_int * \l__hep_cal_offset_int
    }
  }
  \cs_new_protected:Npn \hep_math_cal_map:nnn #1#2#3 {
    \mathcode #2 = \int_eval:n {
      "7000 + 256 * \l__hep_cal_family_int + \l__hep_cal_offset_int + #1
    }\scan_stop:
  }
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\hep_math_glyph:nnnnnnn}
% Register a glyph with its slot "#1", its macro name "#2", the name "#3" of its text command, and its four Unicode characters.
% Record the original math codes of the directly input characters, which are restored for operator names and the decorative alphabets.
% Otherwise a slot of the virtual fonts would be interpreted as a slot of the original font.
% Greek letter macros select the character by its math character.
%    \begin{macrocode}
  \cs_new_protected:Npn \hep_math_glyph:nnnnnnn #1#2#3#4#5#6#7 {
    \tl_gput_right:Nn \g__hep_glyph_setup_tl
      {\hep_math_map:nnnnn {#1}{#4}{#5}{#6}{#7}}
    \int_compare:nNnT {#4} < {128} {
      \tl_gput_right:Nn \g__hep_math_codes_tl {{#4}}
      \tl_gput_right:Nx \g__hep_native_codes_tl
        {\mathcode #4=\the\mathcode #4\scan_stop:}
    }
    \tl_if_empty:nF {#2} {
      \cs_gset_protected:cpn {hep_math_char_#1:} {
        \mathchar\int_eval:n {
          256 * \l__hep_selected_family_int + \l__hep_offset_int + #1
        }\scan_stop:
      }
      \hep_math_greek_record:nnn {#1}{#2}{#3}
    }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\__hep_math_saved_code:n}
% Expand to the assignment which restores the current math code of the character "#1".
%    \begin{macrocode}
  \cs_new:Npn \__hep_math_saved_code:n #1 {
    \exp_not:N \mathcode #1 = \tex_the:D \mathcode #1
    \exp_not:N \scan_stop:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep_math_accent:nnn}
% Declare the accent "#1" in the slot "#2" of the serif or sans-serif bank, matching the letters font, whose vector accent is used by "\vec".
% The bold math version uses the bold bank, just as "\vec" uses the bold math italic font.
%    \begin{macrocode}
  \cs_new_protected:Npn \hep_math_accent:nnn #1#2#3 {
    \use:e {
      \exp_not:N \DeclareMathAccent \exp_not:c {#1} {\exp_not:N \mathord}
        {hepalpha \str_if_eq:VnTF \g__hep_main_family_tl {sans} {2}{0}}
        {#2}
    }
  }
  \ExplSyntaxOff
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\bm}
% Load the \software{bm} package \cite{bm} without reserving additional math families.
%    \begin{macrocode}
  \providecommand\bmmax{0}
  \providecommand\hmmax{0}
  \RequirePackage{bm}
\fi
%    \end{macrocode}
% \end{macro}
%
% \subsection{Glyph table}
%
% Load the \software{alphabeta} package \cite{alphabeta} for the Greek text commands.
%    \begin{macrocode}
\RequirePackage{alphabeta}
\ExplSyntaxOn
%    \end{macrocode}
%
% \begin{macro}{\hep_math_greek_record:nnn}
% \begin{macro}{\g__hep_greek_pdfstring_tl}
% A Greek letter macro "#2" selects the glyph in slot "#1" in math and the text command "\text#3" in text.
% The math variants such as "\varepsilon" typeset the ordinary text letters.
% The protected macros are not expanded in bookmarks, therefore collect the code that lets them stand for the text commands there, see \cref{sec:pdfstring}.
%    \begin{macrocode}
\tl_new:N \g__hep_greek_pdfstring_tl
\cs_new_protected:Npn \hep_math_greek_record:nnn #1#2#3 {
  \tl_gput_right:Nn \g__hep_greek_setup_tl {
    \tl_if_empty:nTF {#3}
      {\cs_gset_protected:cpn {#2}{\use:c {hep_math_char_#1:}}}
      {
        \cs_gset_protected:cpn {#2}
          {\TextOrMath{\use:c {text#3}}{\use:c {hep_math_char_#1:}}}
      }
  }
  \tl_if_empty:nF {#3} {
    \tl_gput_right:Nn \g__hep_greek_pdfstring_tl
      {\cs_set_eq:cc {#2}{text#3}}
  }
}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\__hep_math_glyph:nnnnnn}
% Pass the next slot, the names "#1" and "#2" and the evaluated characters "#3" to "#6" on to the backend.
%    \begin{macrocode}
\int_new:N \g__hep_math_slot_int
\cs_new_protected:Npn \__hep_math_glyph:nnnnnn #1#2#3#4#5#6 {
  \use:e {
    \exp_not:N \hep_math_glyph:nnnnnnn
      {\int_use:N \g__hep_math_slot_int} {#1} {#2}
      {\int_eval:n {#3}} {\int_eval:n {#4}}
      {\int_eval:n {#5}} {\int_eval:n {#6}}
  }
  \int_gincr:N \g__hep_math_slot_int
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\__hep_math_range:nnnnn}
% Register "#1" consecutive characters without macro names.
% The hexadecimal Unicode characters "#2" to "#5" of the first character are the upright, italic, bold and bold italic shapes.
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_math_range:nnnnn #1#2#3#4#5 {
  \int_step_inline:nnn {0}{#1-1} {
    \__hep_math_glyph:nnnnnn {}{}
      {\int_from_hex:n {#2}+##1} {\int_from_hex:n {#3}+##1}
      {\int_from_hex:n {#4}+##1} {\int_from_hex:n {#5}+##1}
  }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\__hep_math_named:nnnnn}
% Register consecutive characters with the macro names given in the list "#1".
% An entry \meta{name}"/"\meta{text} uses the text command "\text"\meta{text}, the entry \meta{name} uses "\text"\meta{name} and the entry \meta{name}"/" has no text command.
%    \begin{macrocode}
\seq_new:N \l__hep_math_name_seq
\int_new:N \l__hep_math_step_int
\cs_new_protected:Npn \__hep_math_named:nnnnn #1#2#3#4#5 {
  \int_zero:N \l__hep_math_step_int
  \clist_map_inline:nn {#1} {
    \seq_set_split:Nnn \l__hep_math_name_seq {/} {##1}
    \__hep_math_glyph:nnnnnn
      {\seq_item:Nn \l__hep_math_name_seq {1}}
      {\seq_item:Nn \l__hep_math_name_seq {-1}}
      {\int_from_hex:n {#2}+\l__hep_math_step_int}
      {\int_from_hex:n {#3}+\l__hep_math_step_int}
      {\int_from_hex:n {#4}+\l__hep_math_step_int}
      {\int_from_hex:n {#5}+\l__hep_math_step_int}
    \int_incr:N \l__hep_math_step_int
  }
}
%    \end{macrocode}
% \end{macro}
