% \begin{macro}{\hep_math_backend_select:}
% Select the serif or sans-serif math font and the style $0$ to $3$ for upright, italic, bold upright and bold italic.
%    \begin{macrocode}
  \cs_new_protected:Npn \hep_math_backend_select: {
    \int_set:Nn \l__hep_selected_family_int {\symhepserif}
    \str_if_eq:VnT \l__hep_family_tl {sans}
      {\int_set:Nn \l__hep_selected_family_int {\symhepsans}}
    \int_set:Nn \l__hep_style_int {1}
    \bool_if:NT \l__hep_up_bool {\int_zero:N \l__hep_style_int}
    \bool_if:NT \l__hep_bold_bool {\int_add:Nn \l__hep_style_int {2}}
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep_math_map:nnnnn}
% Map the input character "#2" and the italic character "#3" to the Unicode character of the selected style.
% The arguments "#2" to "#5" are the upright, italic, bold and bold italic characters.
% A bold character which equals its medium character has no bold Unicode character and is taken from the bold serif math font, or for sans-serif from the bold sans text face if it exists there.
% The typewriter family uses the plain characters from the mono face of the selected weight and shape, but digits are always upright.
% With the "proportional" option the characters below the Greek block come from the proportional face, once it is allocated.
% Characters which do not exist in the text faces, such as "\ell" and "\partial", stay in the math font.
% So does the vartheta of the medium upright mono face, which is drawn as an ordinary theta.
%    \begin{macrocode}
  \cs_new_protected:Npn \hep_math_map:nnnnn #1#2#3#4#5 {
    \int_set:Nn \l_tmpa_int
      {\clist_item:nn {#2,#3,#4,#5}{\l__hep_style_int+1}}
    \int_set_eq:NN \l_tmpb_int \l__hep_selected_family_int
    \bool_if:NT \l__hep_bold_bool {
      \int_compare:nNnT {\l_tmpa_int} =
        {\clist_item:nn {#2,#3}{\l__hep_style_int-1}} {
        \int_set:Nn \l_tmpb_int {\symhepserifbf}
        \bool_lazy_and:nnT
          {\str_if_eq_p:Vn \l__hep_family_tl {sans}}
          {\int_compare_p:nNn {#2} < {"2100}} {
          \int_set:Nn \l_tmpa_int {#2}
          \int_set:Nn \l_tmpb_int {\use:c {symhepsansbf
            \bool_if:NTF \l__hep_up_bool {up}{it}}}
        }
      }
    }
    \str_if_eq:VnT \l__hep_family_tl {mono} {
      \bool_lazy_or:nnF
        {\int_compare_p:nNn {#2} > {"20FF}}
        {
          \bool_lazy_and_p:nn
            {\int_compare_p:nNn {#2} = {"03D1}}
            {\int_compare_p:nNn {\l__hep_style_int} = {0}}
        } {
          \int_set:Nn \l_tmpa_int {#2}
          \tl_set:Nn \l_tmpa_tl {mono}
          \bool_lazy_and:nnT
            {\cs_if_exist_p:N \symheppropup}
            {\int_compare_p:nNn {#2} < {"0370}}
            {\tl_set:Nn \l_tmpa_tl {prop}}
          \int_set:Nn \l_tmpb_int {\use:c {symhep\l_tmpa_tl
            \bool_if:NT \l__hep_bold_bool {bf}
            \bool_if:NTF \l__hep_up_bool {up}{it}}}
          \int_compare:nT {48<=#2<=57} {
            \int_set:Nn \l_tmpb_int {\use:c {symhep\l_tmpa_tl
              \bool_if:NT \l__hep_bold_bool {bf}up}}
          }
        }
    }
    \Umathcode #2 = 7~\l_tmpb_int~\l_tmpa_int\scan_stop:
    \Umathcode #3 = 7~\l_tmpb_int~\l_tmpa_int\scan_stop:
  }
%    \end{macrocode}
% \end{macro}
%
