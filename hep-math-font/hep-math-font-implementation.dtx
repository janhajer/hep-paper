  }
  \cs_new_protected:Npn \hep_math_accent:nnn #1#2#3 {
    \cs_new_protected:cpn {#1} {
      \Umathaccent fixed~0~\symhepaccent
        \int_eval:n {#3+\__hep_math_accent_shape:}\scan_stop:
