% \begin{macro}{\__hep_math_bb:nnn}
% Register "#2" consecutive blackboard characters starting at the hexadecimal input character "#1" and the hexadecimal Unicode character "#3".
% The row order determines the slots within each blackboard alphabet of the virtual font.
%    \begin{macrocode}
\int_new:N \g__hep_math_bb_int
\cs_new_protected:Npn \__hep_math_bb:nnn #1#2#3 {
  \int_step_inline:nnn {0}{#2-1} {
    \hep_math_bb_glyph:nn
      {\int_from_hex:n {#1}+##1} {\int_from_hex:n {#3}+##1}
    \tl_gput_right:Nx \g__hep_bb_setup_tl {
      \exp_not:N \hep_math_bb_map:nnn
        {\int_use:N \g__hep_math_bb_int}
        {\int_eval:n {\int_from_hex:n {#1}+##1}}
        {\int_eval:n {\int_from_hex:n {#3}+##1}}
    }
    \int_gincr:N \g__hep_math_bb_int
  }
}
%    \end{macrocode}
% \end{macro}
