% \begin{macro}{\cyclelistshift}
% Define the "\cyclelistshift" macro, which skips one more step of the cycle list for the following plots of the current axis.
% The global counter accumulates the shifts and must be reset with "\setcounter{cyclelistshift}{0}" before the next axis.
%    \begin{macrocode}
\newcounter{cyclelistshift}
\newcommand*\cyclelistshift{%
  \addtocounter{cyclelistshift}{1}%
