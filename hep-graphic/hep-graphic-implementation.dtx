\CreateSpacedColormapCycleList{rainbow cycle}{rainbow}{\RainbowCycleLength}
\CreateLineStyleCycleList{line styles}{\LineStyleCycleLength}
\CreateSpacedColormapCycleList{colors}{rainbow}{\RainbowCycleLength}
