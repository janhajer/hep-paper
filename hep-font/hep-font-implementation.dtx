% \subsection{Tables and equations}
%
% \begin{environment}{tabular}
% Use tabular numerals in tabulars, whether they are inside a float or not.
% They keep the lining or oldstyle numerals of the surrounding text.
% Captions and the remaining float contents keep the numerals of the text.
% The hooks run inside the group of the environment, so the setting stays local.
%    \begin{macrocode}
\AddToHook{env/tabular/begin}{\tstyle}
\AddToHook{env/tabular*/begin}{\tstyle}
\AddToHook{env/tabularx/begin}{\tstyle}
\AddToHook{env/tabulary/begin}{\tstyle}
\AddToHook{env/longtable/begin}{\tstyle}
%    \end{macrocode}
% \end{environment}
%
% \begin{macro}{\maketag@@@}
% \begin{macro}{\@eqnnum}
% Use tabular numerals for the equation numbers, lining or oldstyle following the package option, using the \software{xpatch} package \cite{xpatch}.
% The style is applied where the number is typeset and not in "\theequation", so that references and hyperlinks are unaffected.
%    \begin{macrocode}
\RequirePackage{xpatch}
\ifhepfont@lining
\AtBeginDocument{%
  \@ifpackageloaded{amsmath}{%
    \xpatchcmd{\maketag@@@}{\normalfont}{\normalfont\tlstyle}{}{%
      \PackageWarning{hep-font}{Could not patch the equation numbers}%
    }%
  }{%
    \xpatchcmd{\@eqnnum}{\normalfont}{\normalfont\tlstyle}{}{%
      \PackageWarning{hep-font}{Could not patch the equation numbers}%
    }%
  }%
}
\else
\AtBeginDocument{%
  \@ifpackageloaded{amsmath}{%
    \xpatchcmd{\maketag@@@}{\normalfont}{\normalfont\tstyle\ostyle}{}{%
      \PackageWarning{hep-font}{Could not patch the equation numbers}%
    }%
  }{%
    \xpatchcmd{\@eqnnum}{\normalfont}{\normalfont\tstyle\ostyle}{}{%
      \PackageWarning{hep-font}{Could not patch the equation numbers}%
    }%
  }%
}
\fi
%    \end{macrocode}
% \end{macro}
% \end{macro}
