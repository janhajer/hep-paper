% \begin{macro}{\hepfont@sc@shapes}
% \begin{macro}{\textsc}
% Store the current series and shape, so that the font state can be restored after the setup.
%    \begin{macrocode}
  \edef\hepfont@restore{%
    \noexpand\fontseries{\f@series}\noexpand\fontshape{\f@shape}%
  }
  \rmfamily
%    \end{macrocode}
% The \LM fonts have no bold small caps.
% Declare them for the serif families with proportional and tabular lining and oldstyle numerals, since the numeral declarations such as "\tstyle", which the \TOC uses, switch between these families.
% The font definitions of each family are loaded first, so that they cannot overwrite the declarations later.
% The italic small caps are the slanted ones.
%    \begin{macrocode}
  \newcommand*{\hepfont@sc@shapes}[2]{%
    \begingroup\fontfamily{#1}\selectfont\endgroup
    \hepfont@sc@shape{#1}{b}{sc}{#2/bx/sc}%
    \hepfont@sc@shape{#1}{bx}{sc}{#2/bx/sc}%
    \hepfont@sc@shape{#1}{b}{scsl}{#2/bx/scsl}%
    \hepfont@sc@shape{#1}{bx}{scsl}{#2/bx/scsl}%
    \hepfont@sc@shape{#1}{b}{scit}{#2/bx/scsl}%
    \hepfont@sc@shape{#1}{bx}{scit}{#2/bx/scsl}%
  }
  \newcommand*{\hepfont@sc@shape}[4]{%
    \DeclareFontShape{\hepfont@encoding}{#1}{#2}{#3}{<->ssub*#4}{}%
  }
%    \end{macrocode}
% Bold small caps with lining numerals are taken from the \CM fonts.
% The \software{slantsc} package \cite{slantsc} combines the small caps with the slanted and italic shapes.
%    \begin{macrocode}
  \ifhepfont@lining
    \RequirePackage{slantsc}
  \fi
  \hepfont@sc@shapes{clm2}{cmr}
  \hepfont@sc@shapes{clm}{cmr}
%    \end{macrocode}
% Bold small caps with oldstyle numerals are taken from the \software{hfoldsty} fonts \cite{hfoldsty}.
%    \begin{macrocode}
  \DeclareFontFamily{\hepfont@encoding}{hfor}{}
  \DeclareFontShape{\hepfont@encoding}{hfor}{bx}{sc}{
    <-6>hfoxc0500<6-7>hfoxc0600<7-8>hfoxc0700<8-9>hfoxc0800
    <9-10>hfoxc0900<10-12>hfoxc1000<12-17>hfoxc1200<17->hfoxc1728
  }{}
  \DeclareFontShape{\hepfont@encoding}{hfor}{bx}{scsl}{
    <-6>hfooc0500<6-7>hfooc0600<7-8>hfooc0700<8-9>hfooc0800
    <9-10>hfooc0900<10-12>hfooc1000<12-17>hfooc1200<17->hfooc1728
  }{}
  \hepfont@sc@shapes{clm2j}{hfor}
  \hepfont@sc@shapes{clmj}{hfor}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\hepfont@sf@shapes}
% \begin{macro}{\hepfont@sf@shape}
% \begin{macro}{\textui}
% The sans-serif small caps and the upright italic shape are taken from the \CM sans fonts of the \software{sansmathfonts} package \cite{sansmathfonts}.
% These small caps have lining numerals only.
% Declare the shapes for the sans-serif families with proportional and tabular lining and oldstyle numerals, since the numeral declarations such as "\tstyle" switch between these families.
% The font definitions of each family are loaded first, so that they cannot overwrite the declarations later.
%    \begin{macrocode}
  \newcommand*{\hepfont@sf@shapes}[1]{%
    \begingroup\fontfamily{#1}\selectfont\endgroup
    \hepfont@sf@shape{#1}{m}{sc}{<->ssub*xcmss/m/sc}%
    \hepfont@sf@shape{#1}{b}{sc}{<->ssub*xcmss/bx/sc}%
    \hepfont@sf@shape{#1}{bx}{sc}{<->ssub*xcmss/bx/sc}%
    \hepfont@sf@shape{#1}{m}{scit}{<->ssub*xcmss/m/scit}%
    \hepfont@sf@shape{#1}{b}{scit}{<->ssub*xcmss/bx/scit}%
    \hepfont@sf@shape{#1}{bx}{scit}{<->ssub*xcmss/bx/scit}%
    \hepfont@sf@shape{#1}{m}{scsl}{<->ssub*xcmss/m/scit}%
    \hepfont@sf@shape{#1}{b}{scsl}{<->ssub*xcmss/bx/scit}%
    \hepfont@sf@shape{#1}{bx}{scsl}{<->ssub*xcmss/bx/scit}%
    \hepfont@sf@shape{#1}{m}{ui}{<->cmssu10}%
  }
  \newcommand*{\hepfont@sf@shape}[4]{%
    \DeclareFontShape{\hepfont@encoding}{#1}{#2}{#3}{#4}{}%
  }
  \hepfont@sf@shapes{clm2s}
  \hepfont@sf@shapes{clms}
  \hepfont@sf@shapes{clm2js}
  \hepfont@sf@shapes{clmjs}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
%
% Leave the serif family, which was selected for the small caps declarations, again.
% Otherwise the rest of the preamble and the hooks of the beginning of the document measure lengths such as "ex" in the serif font, even in sans-serif documents.
% Select the default family with the stored series and shape, as "\normalfont" does at the beginning of the document.
%    \begin{macrocode}
  \fontfamily{\familydefault}\hepfont@restore\selectfont
\fi
%    \end{macrocode}
