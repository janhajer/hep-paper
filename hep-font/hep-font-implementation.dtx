% \begin{macro}{\hep@lining@style}
% The \software{cfr-lm} package encodes the numeral style in the font family name, where a "j" marks oldstyle numerals.
% Remove this marker from the current \LM family and keep the other choices.
% Other font families use the original "\lstyle".
%    \begin{macrocode}
  \ExplSyntaxOn
  \cs_set_eq:NN \hepfont_cfr_lstyle: \lstyle
  \cs_set_protected:Npn \hep@lining@style {
    \tl_set:Nx \l_tmpa_tl { \f@family }
    \exp_args:NnV \regex_match:nnTF { \A clm } \l_tmpa_tl {
      \regex_replace_once:nnN { \A ( clm [^j]* ) j } { \1 } \l_tmpa_tl
      \fontfamily { \tl_use:N \l_tmpa_tl }
      \selectfont
    }{\hepfont_cfr_lstyle:}
  }
  \ExplSyntaxOff
%    \end{macrocode}
% \end{macro}
%
% Lift restrictions of the \CM fonts \cite{fix-cm} and load the text companion fonts \cite{textcomp}.
%    \begin{macrocode}
  \RequirePackage{fix-cm}
  \RequirePackage{textcomp}
%    \end{macrocode}
