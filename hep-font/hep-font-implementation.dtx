% \subsection{Table of contents}
%
% \begin{macro}{\@dottedtocline}
% Use tabular numerals in \TOC entries.
% Appending "\tstyle" to "\normalfont" also covers page numbers for which the class resets the font.
% The group keeps the change local to the entry.
%    \begin{macrocode}
\AddToHook{cmd/@dottedtocline/before}
  {\begingroup\appto\normalfont{\tstyle}\tstyle}
\AddToHook{cmd/@dottedtocline/after}{\endgroup}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hepfont_toc_wrap:n}
% \begin{macro}{\hepfont_toc_wrap_aux:n}
% The book and report classes define entries such as "\l@chapter" which pass their two arguments on to "\@dottedtocline" implicitly.
% An after hook would take these arguments, therefore wrap the entries such that they take both arguments and pass them on within a group.
% Entries with a different signature, such as the argument-less "\l@section" of \software{amsart}, are left alone.
%    \begin{macrocode}
\ExplSyntaxOn
\cs_new_protected:Npn \hepfont_toc_wrap:n #1 {
  \cs_if_exist:cT {l@#1} {
    \str_if_eq:eeT
      { \exp_args:Nc \cs_argument_spec:N {l@#1} }
      { \c_hash_str 1 \c_hash_str 2 }
      { \hepfont_toc_wrap_aux:n {#1} }
  }
}
\cs_new_protected:Npn \hepfont_toc_wrap_aux:n #1 {
  \cs_gset_eq:cc {hepfont_toc_saved_#1:}{l@#1}
  \cs_gset_protected:cpn {l@#1} ##1##2 {
    \group_begin:
    \appto\normalfont{\tstyle}\tstyle
    \use:c {hepfont_toc_saved_#1:}{##1}{##2}
    \group_end:
  }
}
\AddToHook{begindocument/end}{
  \clist_map_inline:nn {section, chapter, part}{\hepfont_toc_wrap:n {#1}}
}
\ExplSyntaxOff
%    \end{macrocode}
% \end{macro}
% \end{macro}
