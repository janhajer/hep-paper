% \subsection{Greek letters}
%
% Load the \software{alphabeta} package \cite{alphabeta}, which lets the Greek letter macros typeset text Greek outside of math.
%    \begin{macrocode}
\RequirePackage{alphabeta}
%    \end{macrocode}
%
% \begin{macro}{\hepfont_greek_wrap:nn}
% With the Unicode engines a math font package such as \software{unicode-math} \cite{unicode-math} can redefine the Greek letter macros at the beginning of the document.
% Wrap them afterwards, so that they select the text command "\text"\meta{name} in text mode and their saved math meaning in math mode.
% The separate name for the saved meaning prevents recursion if another package also wraps them.
% The \software{hyperref} package does not expand protected macros in bookmarks, therefore record that the letters stand for the text commands there, see \cref{sec:pdfstring}.
%    \begin{macrocode}
\iftutex
  \ExplSyntaxOn
  \cs_new_protected:Npn \hepfont_greek_wrap:nn #1#2 {
    \cs_gset_eq:cc {hepfont_math_#1:}{#1}
    \cs_gset_protected:cpn {#1}
      {\TextOrMath{\use:c {text#2}}{\use:c {hepfont_math_#1:}}}
    \tl_gput_right:Nn \g_hepfont_greek_pdfstring_tl
      {\cs_set_eq:cc {#1}{text#2}}
  }
%    \end{macrocode}
% \end{macro}
% Wrap the letters and the variants which correspond to a different text letter.
% The \software{hep-math-font} package defines these macros itself, so leave them alone if it is loaded.
%    \begin{macrocode}
  \AddToHook{begindocument/end}{
    \IfPackageLoadedF{hep-math-font}{
    \clist_map_inline:nn {
      Alpha, Beta, Gamma, Delta, Epsilon, Zeta, Eta, Theta, Iota, Kappa,
      Lambda, Mu, Nu, Xi, Omicron, Pi, Rho, Sigma, Tau, Upsilon, Phi,
      Chi, Psi, Omega, alpha, beta, gamma, delta, epsilon, zeta, eta,
      theta, iota, kappa, lambda, mu, nu, xi, omicron, pi, rho, sigma,
      tau, upsilon, phi, chi, psi, omega
    }{\hepfont_greek_wrap:nn {#1}{#1}}
    \hepfont_greek_wrap:nn {varsigma}{finalsigma}
    \hepfont_greek_wrap:nn {varepsilon}{epsilon}
    \hepfont_greek_wrap:nn {varphi}{phi}
    \hepfont_greek_wrap:nn {vartheta}{thetasymbol}
    \hepfont_greek_wrap:nn {varrho}{rhosymbol}
    \hepfont_greek_wrap:nn {varpi}{pisymbol}
    }
  }
  \ExplSyntaxOff
\fi
%    \end{macrocode}
%
% \begin{macro}{\hepfont_lgr_substitute:nn}
% With \hologo{pdfLaTeX} text Greek uses the \LGR encoding.
% The \software{cfr-lm} package does not provide \LGR fonts, so substitute each of its families with the matching CB Greek family.
% Declaring the family first prevents \LaTeX{} from searching for a non-existing font definition file such as \file{LGRclm.fd}, which would otherwise be reported by \software{latexmk}.
%    \begin{macrocode}
\ifpdftex
  \ExplSyntaxOn
  \cs_new_protected:Npn \hepfont_lgr_substitute:nn #1#2 {
    \clist_map_inline:nn {#1} {
      \DeclareFontFamily{LGR}{##1}{}
      \DeclareFontFamilySubstitution{LGR}{##1}{#2}
    }
  }
%    \end{macrocode}
% \end{macro}
% Map the numeral and width variants of the serif, sans-serif and typewriter families.
%    \begin{macrocode}
  \hepfont_lgr_substitute:nn
    {clm, clmj, clm2, clm2j, clmd, clmdj, clm2d, clm2dj}{lmr}
  \hepfont_lgr_substitute:nn
    {clms, clmjs, clm2s, clm2js, clmqs, clmjqs, clm2qs, clm2jqs}{lmss}
  \hepfont_lgr_substitute:nn
    {clmt, clmjt, clm2t, clm2jt, clmv, clmjv, clm2v, clm2jv}{lmtt}
  \ExplSyntaxOff
%    \end{macrocode}
% The CB Greek typewriter font has no bold face.
% Use the bold serif face instead, keeping the weight.
%    \begin{macrocode}
  \input{lgrlmtt.fd}
  \DeclareFontShape{LGR}{lmtt}{b}{n}{<->ssub*lmr/bx/n}{}
  \DeclareFontShape{LGR}{lmtt}{bx}{n}{<->ssub*lmr/bx/n}{}
  \DeclareFontShape{LGR}{lmtt}{b}{it}{<->ssub*lmr/bx/it}{}
  \DeclareFontShape{LGR}{lmtt}{bx}{it}{<->ssub*lmr/bx/it}{}
  \DeclareFontShape{LGR}{lmtt}{b}{sl}{<->ssub*lmr/bx/sl}{}
  \DeclareFontShape{LGR}{lmtt}{bx}{sl}{<->ssub*lmr/bx/sl}{}
\fi
%    \end{macrocode}
