% \subsection{Options}
%
% Define a "hepfont" namespace for the options using the \software{kvoptions} package \cite{kvoptions}.
%    \begin{macrocode}
\RequirePackage{kvoptions}
\SetupKeyvalOptions{
  family=hepfont,
  prefix=hepfont@
}
%    \end{macrocode}
%
% \begin{macro}{size}
% Define the "size" option, which keeps the class font size by default.
%    \begin{macrocode}
\DeclareStringOption[default]{size}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{sans}
% \begin{macro}{serif}
% Define the "sans" option switching to sans serif font.
%    \begin{macrocode}
\DeclareBoolOption[false]{sans}
\DeclareComplementaryOption{serif}{sans}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{lining}
% \begin{macro}{oldstyle}
% Define the "lining" option deactivating the use of oldstyle figures in text mode.
%    \begin{macrocode}
\DeclareBoolOption[true]{lining}
\DeclareComplementaryOption{oldstyle}{lining}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% Process options.
%    \begin{macrocode}
\ProcessKeyvalOptions*
%    \end{macrocode}
%
% Validate an explicit size already here, but change the size only after the fonts are set up.
% Otherwise fractional sizes can lead to spurious font substitutions.
%    \begin{macrocode}
\ExplSyntaxOn
\str_if_eq:VnF \hepfont@size {default} {
  \exp_args:NnV \regex_match:nnTF
    {\A [0-9]+ (\.[0-9]+)? pt \Z} \hepfont@size {
    \dim_compare:nNnF {\hepfont@size} > {0pt} {
      \PackageError{hep-font}{Font~size~must~be~positive}
        {Use~size=default~or~e.g.~size=11pt.}
    }
  }{
    \PackageError{hep-font}{Invalid~font~size~'\hepfont@size'}
      {Use~size=default~or~e.g.~size=11pt.}
  }
}
\ExplSyntaxOff
%    \end{macrocode}
%
% Distinguish the engines using the \software{iftex} package \cite{iftex}.
%    \begin{macrocode}
\RequirePackage{iftex}
%    \end{macrocode}
%
% \subsection{Unicode engines}
%
% Load the \NCM text fonts with the \software{fontspec} package \cite{fontspec}.
% The numeral style is set per text family and not as a global default, so that math fonts loaded later do not inherit oldstyle numerals.
%    \begin{macrocode}
\iftutex
  \RequirePackage{fontspec}
  \ifhepfont@lining
    \def\hepfont@numbers{Lining}
  \else
    \def\hepfont@numbers{OldStyle}
  \fi
%    \end{macrocode}
%
% Use the regular, italic and bold faces and the \unit[8]{pt} optical sizes below \unit[9]{pt}.
% Slanted roman and typewriter text is slanted synthetically.
%    \begin{macrocode}
  \setmainfont{NewCM10-Regular.otf}[
    Numbers=\hepfont@numbers,
    SlantedFont=NewCM10-Regular.otf,
    SlantedFeatures={FakeSlant=.25},
    BoldSlantedFont=NewCM10-Bold.otf,
    BoldSlantedFeatures={FakeSlant=.25},
    SizeFeatures={
      {Size=-9,Font=NewCM08-Regular.otf,ItalicFont=NewCM08-Italic.otf},
      {Size=9-,Font=NewCM10-Regular.otf,ItalicFont=NewCM10-Italic.otf}
    }
  ]
  \setsansfont{NewCMSans10-Regular.otf}[
    Numbers=\hepfont@numbers,
    SlantedFont=NewCMSans10-Oblique.otf,
    BoldSlantedFont=NewCMSans10-BoldOblique.otf,
    SizeFeatures={
      {Size=-9,Font=NewCMSans08-Regular.otf,
        ItalicFont=NewCMSans08-Oblique.otf},
      {Size=9-,Font=NewCMSans10-Regular.otf,
        ItalicFont=NewCMSans10-Oblique.otf}
    }
  ]
  \setmonofont{NewCMMono10-Regular.otf}[
    Numbers=\hepfont@numbers,
    SlantedFont=NewCMMono10-Regular.otf,
    SlantedFeatures={FakeSlant=.25},
    BoldSlantedFont=NewCMMono10-Bold.otf,
    BoldSlantedFeatures={FakeSlant=.25}
  ]
%    \end{macrocode}
%
% \begin{macro}{\uncial}
% \begin{macro}{\textuncial}
% Provide the uncial font.
%    \begin{macrocode}
  \newfontfamily\uncial{NewCMUncial10-Regular.otf}[
    Numbers=\hepfont@numbers,
    BoldFont=NewCMUncial10-Bold.otf,
    SlantedFont=NewCMUncial10-Regular.otf,
    SlantedFeatures={FakeSlant=.25},
    BoldSlantedFont=NewCMUncial10-Bold.otf,
    BoldSlantedFeatures={FakeSlant=.25}
  ]
  \DeclareTextFontCommand{\textuncial}{\uncial}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% Define the proportional \LM typewriter font used by "\tvstyle".
% It does not contain Greek letters.
%    \begin{macrocode}
  \newfontfamily\hepfont@vmono{lmmonoprop10-regular.otf}[
    Numbers=\hepfont@numbers,
    ItalicFont=lmmonoprop10-oblique.otf,
    BoldFont=lmmonoproplt10-bold.otf,
    BoldItalicFont=lmmonoproplt10-boldoblique.otf
  ]
%    \end{macrocode}
%
% Switch to the sans-serif font if requested.
%    \begin{macrocode}
  \ifhepfont@sans
    \renewcommand*{\familydefault}{\sfdefault}
  \fi
%    \end{macrocode}
%
% \begin{macro}{\hepfont@pnum}
% \begin{macro}{\hepfont@tnum}
% The OpenType features are applied in the order of the lookups in the font, not in the order in which they are requested.
% The regular and italic \NCM serif faces list "tnum" before "onum", so that "tnum" leaves the lining digits alone and "onum" then replaces them with the proportional oldstyle digits, although the fonts contain tabular oldstyle digits.
% With \hologo{LuaTeX} define the "hepftnum" feature, which the \software{luaotfload} package \cite{luaotfload} appends after the lookups of the font, and which replaces the proportional by the tabular oldstyle digits.
% Fonts without these glyphs are unaffected.
% \hologo{XeTeX} offers no such hook and keeps the proportional digits.
%    \begin{macrocode}
  \ifluatex
    \directlua{
      local data = {}
      for _, digit in ipairs{"zero", "one", "two", "three", "four",
          "five", "six", "seven", "eight", "nine"} do
        data[digit .. ".oldstyle"] = digit .. ".taboldstyle"
      end
      fonts.handlers.otf.addfeature{
        name = "hepftnum", type = "substitution", data = data
      }
    }
    \def\hepfont@pnum{Numbers=Proportional,RawFeature=-hepftnum}
    \def\hepfont@tnum{Numbers=Monospaced,RawFeature=+hepftnum}
  \else
    \def\hepfont@pnum{Numbers=Proportional}
    \def\hepfont@tnum{Numbers=Monospaced}
  \fi
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\pstyle}
% \begin{macro}{\tstyle}
% \begin{macro}{\ostyle}
% \begin{macro}{\lstyle}
% Provide the numeral declarations of the \software{cfr-lm} package also for the Unicode engines.
% They are local to the current group and cannot be used as math alphabets.
%    \begin{macrocode}
  \DeclareRobustCommand{\pstyle}{%
    \not@math@alphabet\pstyle\relax
    \expandafter\addfontfeatures\expandafter{\hepfont@pnum}%
  }
  \DeclareRobustCommand{\tstyle}{%
    \not@math@alphabet\tstyle\relax
    \expandafter\addfontfeatures\expandafter{\hepfont@tnum}%
  }
  \DeclareRobustCommand{\ostyle}{%
    \not@math@alphabet\ostyle\relax
    \addfontfeatures{Numbers=OldStyle}%
  }
  \DeclareRobustCommand{\lstyle}{%
    \not@math@alphabet\lstyle\relax
    \addfontfeatures{Numbers=Lining}%
  }
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\postyle}
% \begin{macro}{\plstyle}
% \begin{macro}{\tostyle}
% \begin{macro}{\tlstyle}
% Combine the numeral declarations.
%    \begin{macrocode}
  \DeclareRobustCommand{\postyle}{\pstyle\ostyle}
  \DeclareRobustCommand{\plstyle}{\pstyle\lstyle}
  \DeclareRobustCommand{\tostyle}{\tstyle\ostyle}
  \DeclareRobustCommand{\tlstyle}{\tstyle\lstyle}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\tmstyle}
% \begin{macro}{\tvstyle}
% Select the fixed-width and the proportional typewriter fonts.
%    \begin{macrocode}
  \DeclareRobustCommand{\tmstyle}{\ttfamily}
  \DeclareRobustCommand{\tvstyle}{\ttfamily\hepfont@vmono}
%    \end{macrocode}
% \end{macro}
% \end{macro}
