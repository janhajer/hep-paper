% \subsection{Bookmarks}
% \label{sec:pdfstring}
%
% \begin{macro}{\hepfont_pdfstring:}
% The \software{hyperref} package \cite{hyperref} turns sectioning titles into bookmarks by expansion.
% It does not know the font commands of this package and of \software{nfssext-cfr}, whose expansion either breaks the bookmark or leaves font internals in it.
% Keep only the argument of the text commands and drop the declarations.
% With \hologo{pdfLaTeX} \software{nfssext-cfr} defines them only at the beginning of the document, so define them also if they do not exist yet, which covers document information set in the preamble.
%    \begin{macrocode}
\ExplSyntaxOn
\tl_new:N \g_hepfont_greek_pdfstring_tl
\cs_new_protected:Npn \hepfont_pdfstring: {
  \clist_map_inline:nn {
    textl, texto, textp, textt, textpl, textpo, texttl, textto,
    textui, textuncial
  }{\cs_set_eq:cN {##1}\use:n}
  \clist_map_inline:nn {
    lstyle, ostyle, pstyle, tstyle, plstyle, postyle, tlstyle,
    tostyle, tmstyle, tvstyle, codestyle, uishape, uncial
  }{\cs_set_eq:cN {##1}\prg_do_nothing:}
%    \end{macrocode}
% The verbatim argument of "\code" has already been read when the bookmark is created.
% Turn it into a string, so that characters such as the underscore are kept.
%    \begin{macrocode}
  \bool_if:NT \g_hepfont_code_bool
    {\cs_set:Npn \code ##1 {\tl_to_str:n {##1}}}
%    \end{macrocode}
% With the Unicode engines the Greek letters are protected, use the text commands instead.
% With \hologo{pdfLaTeX} \software{hyperref} already handles the definitions of \software{alphabeta}.
%    \begin{macrocode}
  \tl_use:N \g_hepfont_greek_pdfstring_tl
}
%    \end{macrocode}
% \end{macro}
% Register the definitions with \software{hyperref}, whether it is loaded before or after this package.
%    \begin{macrocode}
\cs_new_protected:Npn \hepfont_pdfstring_setup:
  {\pdfstringdefDisableCommands{\hepfont_pdfstring:}}
\IfPackageLoadedTF{hyperref}{\hepfont_pdfstring_setup:}
  {\AddToHook{package/hyperref/after}{\hepfont_pdfstring_setup:}}
\ExplSyntaxOff
%    \end{macrocode}
