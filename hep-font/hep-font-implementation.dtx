% \subsection{pdf\TeX}
%
% Load the "utf8" input encoding \cite{inputenc} and the "T1" font encoding \cite{fontenc}.
%    \begin{macrocode}
\else
  \PassOptionsToPackage{utf8}{inputenc}
  \RequirePackage{inputenc}
  \def\hepfont@encoding{T1}
  \PassOptionsToPackage{\hepfont@encoding}{fontenc}
  \RequirePackage{fontenc}
  \ifhepfont@sans
    \renewcommand*{\familydefault}{\sfdefault}
  \fi
%    \end{macrocode}
%
% Silence the expected messages of the \software{nfssext-cfr} package \cite{nfssext-cfr} using the \software{silence} \cite{silence} and \software{etoolbox} \cite{etoolbox} packages.
% The \software{silence} package redefines the warning macros with "\def\sl@PackageName", which breaks if a warning is expanded within an "\edef".
% This happens for instance with undefined references in the \software{svjour3} "\thanksref" macro.
% Therefore make them robust.
%    \begin{macrocode}
  \RequirePackage{etoolbox}
  \RequirePackage{silence}
  \robustify\PackageWarning
  \robustify\PackageWarningNoLine
  \robustify\ClassWarning
  \robustify\ClassWarningNoLine
  \robustify\@latex@warning
  \robustify\@latex@warning@no@line
  \robustify\@font@warning
  \robustify\sl@StoreMessage
  \WarningFilter{nfssext-cfr}
    {Patching font initialisation macro for serif.}
  \WarningFilter{nfssext-cfr}
    {Patching font initialisation macro for sans.}
  \WarningFilter{nfssext-cfr}
    {Patching font initialisation macro for typewriter.}
  \WarningFilter{nfssext-cfr}
    {Overwriting kernel definition of \swshape (new)}
%    \end{macrocode}
%
% Load the \LM fonts using the \software{cfr-lm} package \cite{cfr-lm}, whose default are oldstyle numerals.
%    \begin{macrocode}
  \ifhepfont@lining
    \PassOptionsToPackage{rm={lining},sf={lining},tt={lining}}{cfr-lm}
  \fi
  \RequirePackage{cfr-lm}
%    \end{macrocode}
%
% \begin{macro}{\exfs@info}
% Each switch of the numeral style loads a font family, and \software{nfssext-cfr} writes an info message to the log file for every switch.
% Drop these messages, but keep them as warnings in the "debug" mode of \software{nfssext-cfr}.
% Its real warnings are not affected.
% The macro is only defined at the beginning of the document.
% The code avoids \TeX\ conditionals, since "\ifexfs@debug" is undefined in the skipped Unicode branch.
%    \begin{macrocode}
  \ExplSyntaxOn
  \hook_gput_code:nnn { begindocument/before } { hep-font } {
    \cs_if_exist:NT \exfs@info {
      \RenewDocumentCommand \exfs@info { O{nfssext-cfr} m } {
        \legacy_if:nT { exfs@debug }
          { \PackageWarning {#1} { Info:~#2 } }
      }
    }
  }
  \hook_gset_rule:nnnn { begindocument/before }
    { nfssext-cfr } { before } { hep-font }
  \ExplSyntaxOff
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\exfs@merge@families}
% \begin{macro}{\hepfont_cfr_set:}
% The \software{nfssext-cfr} package combines numeral styles with "\exfs@merge@families", which stores its list of font variants globally in "\set".
% In oldstyle mode every switch such as "\tstyle" therefore overwrites user macros of this name, for example the "\set" of \software{hep-math}, also during the measuring pass of the "align" environment, which typesets the equation number.
% Rename the list to "\hepfont@exfs@set" with the \software{xpatch} package \cite{xpatch}, repeating the patch until no "\set" is left.
% The macro is only defined at the beginning of the document, so the patch runs in the same hook as above.
%    \begin{macrocode}
  \RequirePackage{xpatch}
  \ExplSyntaxOn
  \cs_new_protected:Npn \hepfont_cfr_set: {
    \xpatchcmd \exfs@merge@families { \set } { \hepfont@exfs@set }
      { \hepfont_cfr_set: } { }
  }
  \hook_gput_code:nnn { begindocument/before } { hep-font } {
    \cs_if_exist:NT \exfs@merge@families { \hepfont_cfr_set: }
  }
  \ExplSyntaxOff
%    \end{macrocode}
% \end{macro}
% \end{macro}
