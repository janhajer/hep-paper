% hep-paper: automatic REVTeX compatibility mode (hep-revtex).
\input{regression-test}
\documentclass{revtex4-2}
\usepackage{hep-paper}
\input{hep-regression}
\makeatletter
% \OPTION{name}: the value of a kvoptions string or boolean option
\newcommand*{\OPTION}[1]{%
  \@ifundefined{ifhep@#1}{%
    \TYPE{#1: [\csname hep@#1\endcsname]}%
  }{%
    \TYPE{#1: \csname ifhep@#1\endcsname true\else false\fi}%
  }%
}
% \PACKAGES{list}: loaded or not, and the options it was loaded with
\newcommand*{\PACKAGES}[1]{%
  \@for\hep@test@name:=#1\do{%
    \TYPE{\hep@test@name: \expandafter\ifx
      \csname ver@\hep@test@name.sty\endcsname\relax not loaded\else
      loaded [\unexpanded\expandafter\expandafter\expandafter
        {\csname opt@\hep@test@name.sty\endcsname}]%
      \fi}%
  }%
}
% \DEFINED{list of macro names}
\newcommand*{\DEFINED}[1]{%
  \@for\hep@test@name:=#1\do{%
    \TYPE{\hep@test@name: \ifcsname\hep@test@name\endcsname
      \expandafter\ifx\csname\hep@test@name\endcsname\relax
      undefined\else defined\fi\else undefined\fi}%
  }%
}
\title{The \textit{title} with $\alpha$}
\subtitle{Sub}
\arxiv{2101.00001}
\preprint{CERN-TH-0000-000}
\author[1]{First Author}
\affiliation[1]{First Institute}
% \TRACE: the code hep-journal has handed to the class
\ExplSyntaxOn
\cs_new_protected:Npn \TRACE
  { \seq_map_inline:Nn \g__hep_jr_trace_seq { \TYPE { \tl_to_str:n {##1} } } }
\ExplSyntaxOff
\begin{document}
% Make the title before the test, so font loading is not recorded.
\setbox0\vbox{\maketitle}
\makeatletter
\START

\TEST{Option values}{%
  \TYPE{class: \hep@class}%
  \OPTION{paper}\OPTION{font}\OPTION{lang}\OPTION{symbols}%
  \OPTION{bibliography}\OPTION{serif}\OPTION{lining}\OPTION{parindent}%
  \OPTION{defaults}\OPTION{title}\OPTION{physics}\OPTION{glossaries}%
  \OPTION{references}\OPTION{eqnarray}\OPTION{manualplacement}%
  \OPTION{beamer}\OPTION{revtex}\OPTION{jhep}\OPTION{jcap}\OPTION{pos}%
  \OPTION{springer}\OPTION{amsart}\OPTION{sissa}\OPTION{journal}%
}

\TEST{Loaded packages and their options}{%
  \PACKAGES{hep-math,hep-font,hep-math-font,geometry,parskip,hep-text,%
    hep-float,hep-title,hep-bibliography,biblatex,hep-reference,hyperref,%
    cleveref,hep-acronym,titlesec,hep-revtex,hep-sissa,hep-journal,xpatch}%
}

\TEST{Page geometry and font size}{%
  \TYPE{paper: \the\paperwidth\space x \the\paperheight}%
  \TYPE{text: \the\textwidth\space x \the\textheight}%
  \TYPE{font size: \f@size}%
  \TYPE{parindent: \the\parindent, parskip: \the\parskip}%
}


\TEST{hep-journal: title data handed to REVTeX}{%
  \TRACE
}

\TEST{hep-journal: document title}{%
  \PDFINFO{title}%
  \PDFINFO{author}%
}

\TEST{hep-revtex: figure and table names}{%
  \TYPE{\figurename, \tablename}%
}

\makeatother
\END
