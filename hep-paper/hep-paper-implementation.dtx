          }
        \tl_put_right:Ne \l__hep_jr_tmp_tl
          {
            \int_compare:nNnF {##1} = 1 { \exp_not:N \and }
            \__hep_jr_name:n {##1}
            \clist_if_empty:NF \l__hep_jr_tmp_clist
              {
                \exp_not:N \thanksref
                  { \clist_use:Nn \l__hep_jr_tmp_clist { , } }
              }
          }
