% \begin{macro}{\hep@if@class@option}
% Read the font and paper size from the class options stored in
% "\@classoptionslist".
% This happens before the package options are processed, so that the class options only change the defaults, while explicit "font" and "paper" options of this package take precedence.
%    \begin{macrocode}
\newcommand*{\hep@if@class@option}[1]{%
  \ifx\@classoptionslist\relax
    \in@false
  \else
    \@expandtwoargs\in@{,#1,}{,\@classoptionslist,}%
  \fi
  \ifin@
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi
}
\hep@if@class@option{a5paper}{\setkeys{hep}{paper=a5}}{}
\hep@if@class@option{b5paper}{\setkeys{hep}{paper=b5}}{}
\hep@if@class@option{letterpaper}{\setkeys{hep}{paper=letter}}{}
\hep@if@class@option{legalpaper}{\setkeys{hep}{paper=legal}}{}
\hep@if@class@option{executivepaper}{%
  \setkeys{hep}{paper=executive}%
}{}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\hep@class@size}
% Take every class option of the form \meta{number}"pt", such as "10pt" or the "14pt" of the \software{extsizes} classes, as default "font" size, since the \software{hep-font} package accepts any positive point size.
%    \begin{macrocode}
\ExplSyntaxOn
\cs_new_protected:Npn \hep@class@size #1 {
  \regex_match:nnT { \A [0-9]+ (\.[0-9]+)? pt \Z } {#1}
    { \setkeys{hep}{font=#1} }
}
\ExplSyntaxOff
\ifx\@classoptionslist\relax\else
  \@for\hep@option:=\@classoptionslist\do{%
    \expandafter\hep@class@size\expandafter{\hep@option}%
  }
\fi
%    \end{macrocode}
% \end{macro}
