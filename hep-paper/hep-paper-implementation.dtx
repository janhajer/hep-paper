% \begin{macro}{\hep@class}
% Store the name of the document class, the first class file in "\@filelist".
% Files loaded before the class, for example with "\RequirePackage", are skipped.
%    \begin{macrocode}
\def\hep@get@class#1.cls#2\@nil{#1}
\let\hep@class\@empty
\@for\hep@file:=\@filelist\do{%
  \ifx\hep@class\@empty
    \@expandtwoargs\in@{.cls}{\hep@file}%
    \ifin@
      \edef\hep@class{\expandafter\hep@get@class\hep@file\@nil}%
    \fi
  \fi
}
%    \end{macrocode}
% \end{macro}
