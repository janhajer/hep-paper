              { \__hep_jr_emit:n { \noaffiliation } }
          }
      }
    \seq_map_inline:Nn \g__hep_jr_preprint_seq
      { \__hep_jr_emit:n { \preprint {##1} } }
    \seq_map_inline:Nn \g__hep_jr_arxiv_seq
      {
        \__hep_jr_emit:e
          { \exp_not:N \preprint { arXiv:~ \__hep_jr_arxiv_link:n {##1} } }
      }
    \__hep_jr_emit_date:
    \__hep_jr_emit_keywords:
    \__hep_jr_emit_abstract:
    \__hep_jr_emit:n { \maketitle }
  }
%    \end{macrocode}
