%
% Ensure that the hyperlinks are colored correctly using the software{xcolor} package \cite{xcolor}.
%    \begin{macrocode}
\RequirePackage{xcolor}
\definecolor{linkcolor}{RGB}{46,48,146}
\AtEndPreamble{
\@ifpackageloaded{hyperref}{
\hypersetup{
  colorlinks=true,
  linkcolor=linkcolor,
  citecolor=linkcolor,
  urlcolor=linkcolor,
  linktocpage=true
}}{}}
\AtEndPreamble{\@ifpackageloaded{cleveref}{%
  \@cref@nameinlinkfalse%
  \crefalias{BackrefHyperFootnoteCounter}{footnote}%
}{}}
\AtEndPreamble{\@ifpackageloaded{glossaries}{\glsdisablehyper}{}}
%    \end{macrocode}
%
% Without the \software{hep-journal} package set the PDF title when the title is made.
% The default of a missing title is a warning, which must not be issued in a PDF string, where it loops if the \software{silence} package is loaded.
%    \begin{macrocode}
\ifhep@title\else
  \pdfstringdefDisableCommands{\let\class@warn\@gobble}
  \AddToHook{cmd/maketitle/before}{\hypersetup{pdftitle={\@title}}}
\fi
%    \end{macrocode}
%
% Ensure correct formatting of float captions using the \software{ragged2e} package \cite{ragged2e}.
%    \begin{macrocode}
\AtBeginDocument{\@ifpackageloaded{caption}{
  \RequirePackage{ragged2e}
  \DeclareCaptionFormat{revtex}{#1#2\justifying{#3}}
  \captionsetup{font=small, format=revtex}
  \captionsetup[sub]{font=small, format=plain}
}{}}
%    \end{macrocode}
%
% Fixing the names of figures and tables.
%    \begin{macrocode}
\AfterEndPreamble{
  \renewcommand{\figurename}{FIG.}
  \renewcommand{\tablename}{TABLE}
}
%    \end{macrocode}
%
%</revtex>
%
% \section{Journal title data}
%
%<*journal>
%
% The \software{hep-journal} package is loaded by \software{hep-paper} in the compatibility modes instead of \software{hep-title}.
% It provides the user interface of \software{hep-title}, stores the title data instead of typesetting them, and hands them to the macros of the journal class or style when the title is made.
% The option names the journal: "jhep", "jcap", "revtex", "springer", "amsart", "pos", or "koma".
% Load the \software{environ} package \cite{environ}, define the messages and warn once for every macro without counterpart in the journal.
%
%    \begin{macrocode}
\RequirePackage{environ}
\ExplSyntaxOn
\str_new:N \g__hep_jr_backend_str
\DeclareOption*{\str_gset:Ne \g__hep_jr_backend_str {\CurrentOption}}
\ProcessOptions\relax
\msg_new:nnn { hep-journal } { unsupported }
  { \iow_char:N\\#1~is~not~supported~by~the~#2~mode~and~ignored. }
\msg_new:nnn { hep-journal } { no-author }
  { \iow_char:N\\#1~without~preceding~\iow_char:N\\author~ignored. }
\msg_new:nnn { hep-journal } { label }
  { Affiliation~label~'#1'~is~not~defined. }
\msg_new:nnn { hep-journal } { unused }
  { Affiliation~'#1'~is~not~used~by~any~author. }
\msg_new:nnn { hep-journal } { late-abstract }
  {
    The~abstract~comes~after~the~title~and~is~placed~there~in~the~
    next~run.~Place~it~directly~after~\iow_char:N\\maketitle~to~
    avoid~the~second~run.
  }
\msg_new:nnn { hep-journal } { no-title }
  { The~title~has~not~been~made,~\iow_char:N\\maketitle~is~missing. }
\clist_new:N \g__hep_jr_warned_clist
\cs_new_protected:Npn \__hep_jr_unsupported:n #1
  {
    \clist_if_in:NnF \g__hep_jr_warned_clist {#1}
      {
        \clist_gput_right:Nn \g__hep_jr_warned_clist {#1}
        \msg_warning:nnnV { hep-journal } { unsupported } {#1}
          \g__hep_jr_backend_str
      }
  }
\cs_generate_variant:Nn \msg_warning:nnnn { nnnV }
%    \end{macrocode}
%
% \subsection{Storage}
%
% The title data are kept in global variables.
% Every author \meta{n} has a name, a list of affiliation labels, and lists of email addresses, ORCID identifiers and thanks.
% Affiliations without label get the labels "hep-affiliation-"\meta{n} and belong to the authors without label since the previous affiliation, as in \software{authblk}.
%
%    \begin{macrocode}
\tl_new:N \g__hep_jr_title_tl
\tl_new:N \g__hep_jr_short_title_tl
\tl_new:N \g__hep_jr_subtitle_tl
\tl_new:N \g__hep_jr_series_tl
\tl_new:N \g__hep_jr_date_tl
\bool_new:N \g__hep_jr_date_bool
\tl_new:N \g__hep_jr_keywords_tl
\seq_new:N \g__hep_jr_preprint_seq
\seq_new:N \g__hep_jr_arxiv_seq
\seq_new:N \g__hep_jr_reprint_seq
\seq_new:N \g__hep_jr_doi_seq
\seq_new:N \g__hep_jr_editor_seq
\int_new:N \g__hep_jr_authors_int
\int_new:N \g__hep_jr_current_int
\prop_new:N \g__hep_jr_affil_prop
\seq_new:N \g__hep_jr_affil_seq
\seq_new:N \g__hep_jr_pending_seq
\bool_new:N \g__hep_jr_after_affil_bool
\int_new:N \g__hep_jr_affil_int
\tl_new:N \g__hep_jr_abstract_tl
\bool_new:N \g__hep_jr_abstract_bool
\tl_new:N \g__hep_jr_aux_abstract_tl
\bool_new:N \g__hep_jr_aux_abstract_bool
\bool_new:N \g__hep_jr_made_bool
\bool_new:N \g__hep_jr_pending_bool
\seq_new:N \g__hep_jr_code_seq
\seq_new:N \g__hep_jr_trace_seq
\tl_new:N \l__hep_jr_name_tl
\tl_new:N \l__hep_jr_before_tl
\tl_new:N \l__hep_jr_after_tl
\tl_new:N \l__hep_jr_opt_tl
\tl_new:N \l__hep_jr_arg_tl
\tl_new:N \l__hep_jr_arg_ii_tl
\tl_new:N \l__hep_jr_label_tl
\tl_new:N \l__hep_jr_tmp_tl
\seq_new:N \l__hep_jr_tmp_seq
\clist_new:N \l__hep_jr_tmp_clist
\prop_new:N \l__hep_jr_letter_prop
\int_new:N \l__hep_jr_tmp_int
\quark_new:N \q__hep_jr_mark
\quark_new:N \q__hep_jr_stop
%    \end{macrocode}
%
% Save copies of the class macros that are replaced by the user interface, using "\NewCommandCopy" so that commands with optional arguments keep working.
% They are restored before the data are handed to the class.
%
%    \begin{macrocode}
\clist_const:Nn \c__hep_jr_class_clist
  {
    title, author, affiliation, email, thanks, keywords, date, subtitle,
    preprint, abstract, endabstract, maketitle
  }
\clist_map_inline:Nn \c__hep_jr_class_clist
  {
    \cs_if_exist:cT {#1}
      {
        \exp_args:Ncc \NewCommandCopy
          { __hep_jr_class_ #1 : } {#1}
      }
  }
\cs_new_protected:Npn \__hep_jr_restore:
  {
    \clist_map_inline:Nn \c__hep_jr_class_clist
      {
        \cs_if_exist:cT { __hep_jr_class_ ##1 : }
          { \cs_gset_eq:cc {##1} { __hep_jr_class_ ##1 : } }
      }
    \cs_if_exist:NF \__hep_jr_class_endabstract:
      { \cs_undefine:N \endabstract }
  }
%    \end{macrocode}
%
% \subsection{Authors}
%
% Create a new author with labels \marg{labels} and name \marg{name}.
% The contact information inside the name is moved to the lists of the author, while "\email", "\orcid", "\orcmail" and "\thanks" after "\author" are added to the last author.
%
%    \begin{macrocode}
\cs_new:Npn \__hep_jr_field:nn #1#2
  { g__hep_jr_author_ #1 _ #2 }
\cs_new_protected:Npn \__hep_jr_new_author:nn #1#2
  {
    \int_gincr:N \g__hep_jr_authors_int
    \int_gset_eq:NN \g__hep_jr_current_int \g__hep_jr_authors_int
    \tl_set:Ne \l__hep_jr_tmp_tl { \int_use:N \g__hep_jr_current_int }
    \tl_new:c { \__hep_jr_field:Vn \l__hep_jr_tmp_tl { name_tl } }
    \clist_new:c { \__hep_jr_field:Vn \l__hep_jr_tmp_tl { labels_clist } }
    \seq_new:c { \__hep_jr_field:Vn \l__hep_jr_tmp_tl { email_seq } }
    \seq_new:c { \__hep_jr_field:Vn \l__hep_jr_tmp_tl { orcid_seq } }
    \seq_new:c { \__hep_jr_field:Vn \l__hep_jr_tmp_tl { thanks_seq } }
    \bool_if:NT \g__hep_jr_after_affil_bool
      {
        \seq_gclear:N \g__hep_jr_pending_seq
        \bool_gset_false:N \g__hep_jr_after_affil_bool
      }
    \tl_if_blank:nTF {#1}
      { \seq_gput_right:NV \g__hep_jr_pending_seq \l__hep_jr_tmp_tl }
      {
        \clist_gset:cn
          { \__hep_jr_field:Vn \l__hep_jr_tmp_tl { labels_clist } } {#1}
      }
    \tl_set:Nn \l__hep_jr_name_tl {#2}
    \__hep_jr_extract:NnN \email { 1 } \__hep_jr_email:nnn
    \__hep_jr_extract:NnN \orcid { 1 } \__hep_jr_orcid:nnn
    \__hep_jr_extract:NnN \orcmail { 2 } \__hep_jr_orcmail:nnn
    \__hep_jr_extract:NnN \thanks { 1 } \__hep_jr_thanks:nnn
    \tl_gset_eq:cN
      { \__hep_jr_field:Vn \l__hep_jr_tmp_tl { name_tl } }
      \l__hep_jr_name_tl
  }
\cs_generate_variant:Nn \__hep_jr_field:nn { V , e }
\cs_new_protected:Npn \__hep_jr_add:nn #1#2
  {
    \int_compare:nNnTF \g__hep_jr_current_int > 0
      {
        \seq_gput_right:cn
          { \__hep_jr_field:en { \int_use:N \g__hep_jr_current_int } {#1} }
          {#2}
      }
      {
        \int_compare:nNnT \g__hep_jr_current_int = 0
          { \msg_warning:nnn { hep-journal } { no-author } {#1} }
      }
  }
\cs_new_protected:Npn \__hep_jr_email:nnn #1#2#3
  { \__hep_jr_add:nn { email_seq } {#2} }
\cs_new_protected:Npn \__hep_jr_orcid:nnn #1#2#3
  { \__hep_jr_add:nn { orcid_seq } {#2} }
\cs_new_protected:Npn \__hep_jr_orcmail:nnn #1#2#3
  {
    \__hep_jr_add:nn { email_seq } {#3}
    \__hep_jr_add:nn { orcid_seq } {#2}
  }
\cs_new_protected:Npn \__hep_jr_thanks:nnn #1#2#3
  { \__hep_jr_add:nn { thanks_seq } {#2} }
%    \end{macrocode}
%
% Remove the top level occurrences of the command "#1" with an optional and "#2" mandatory arguments from the name and pass the arguments to "#3".
% The name is split at the command with a delimited argument, and the arguments are read with "\tl_head:N" and "\tl_tail:N".
% The quark "\q__hep_jr_mark" protects the rest of the name from losing its braces.
%
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_jr_extract:NnN #1#2#3
  {
    \tl_if_in:NnT \l__hep_jr_name_tl {#1}
      {
        \cs_set_protected:Npn \__hep_jr_split:w ##1 #1 ##2 \q__hep_jr_stop
          {
            \tl_set:Nn \l__hep_jr_before_tl {##1}
            \tl_set:Nn \l__hep_jr_after_tl {##2}
          }
        \exp_after:wN \__hep_jr_split:w \l__hep_jr_name_tl
          \q__hep_jr_mark \q__hep_jr_stop
        \tl_clear:N \l__hep_jr_opt_tl
        \tl_trim_spaces:N \l__hep_jr_after_tl
        \exp_args:NV \tl_if_head_eq_charcode:nNT \l__hep_jr_after_tl [
          {
            \exp_after:wN \__hep_jr_opt:w \l__hep_jr_after_tl
              \q__hep_jr_stop
          }
        \__hep_jr_arg:N \l__hep_jr_arg_tl
        \tl_clear:N \l__hep_jr_arg_ii_tl
        \int_compare:nNnT {#2} > 1
          { \__hep_jr_arg:N \l__hep_jr_arg_ii_tl }
        \tl_remove_all:Nn \l__hep_jr_after_tl { \q__hep_jr_mark }
        \tl_trim_spaces:N \l__hep_jr_before_tl
        \tl_trim_spaces:N \l__hep_jr_after_tl
        \tl_set:Ne \l__hep_jr_name_tl
          {
            \exp_not:V \l__hep_jr_before_tl
            \tl_if_empty:NF \l__hep_jr_after_tl
              { \c_space_tl \exp_not:V \l__hep_jr_after_tl }
          }
        \use:e
          {
            \exp_not:N #3
              { \exp_not:V \l__hep_jr_opt_tl }
              { \exp_not:V \l__hep_jr_arg_tl }
              { \exp_not:V \l__hep_jr_arg_ii_tl }
          }
        \__hep_jr_extract:NnN #1 {#2} #3
      }
  }
\cs_new_protected:Npn \__hep_jr_opt:w [ #1 ] #2 \q__hep_jr_stop
  {
    \tl_set:Nn \l__hep_jr_opt_tl {#1}
    \tl_set:Nn \l__hep_jr_after_tl {#2}
  }
\cs_new_protected:Npn \__hep_jr_arg:N #1
  {
    \tl_set:Ne #1 { \tl_head:N \l__hep_jr_after_tl }
    \tl_if_eq:NNTF #1 \q__hep_jr_mark
      { \tl_clear:N #1 }
      {
        \tl_set:Ne \l__hep_jr_after_tl
          { \tl_tail:N \l__hep_jr_after_tl }
      }
  }
%    \end{macrocode}
%
% \subsection{User interface}
%
% The commands of \software{hep-title} only store their arguments.
% The layout commands of \software{hep-title} are ignored, unless the class defines a command with the same name.
%
%    \begin{macrocode}
\RenewDocumentCommand \title { o m }
  {
    \tl_gset:Nn \g__hep_jr_title_tl {#2}
    \IfValueTF {#1}
      { \tl_gset:Nn \g__hep_jr_short_title_tl {#1} }
      { \tl_gclear:N \g__hep_jr_short_title_tl }
  }
\DeclareDocumentCommand \subtitle { m }
  { \tl_gset:Nn \g__hep_jr_subtitle_tl {#1} }
\DeclareDocumentCommand \series { m }
  { \tl_gset:Nn \g__hep_jr_series_tl {#1} }
\RenewDocumentCommand \date { m }
  {
    \tl_gset:Nn \g__hep_jr_date_tl {#1}
    \bool_gset_true:N \g__hep_jr_date_bool
  }
\DeclareDocumentCommand \keywords { m }
  { \tl_gset:Nn \g__hep_jr_keywords_tl {#1} }
\DeclareDocumentCommand \preprint { m }
  { \seq_gput_right:Nn \g__hep_jr_preprint_seq {#1} }
\DeclareDocumentCommand \arxiv { m }
  { \seq_gput_right:Nn \g__hep_jr_arxiv_seq {#1} }
\DeclareDocumentCommand \reprint { m }
  { \seq_gput_right:Nn \g__hep_jr_reprint_seq {#1} }
\DeclareDocumentCommand \doi { m }
  { \seq_gput_right:Nn \g__hep_jr_doi_seq {#1} }
\DeclareDocumentCommand \author { O{} m }
  { \__hep_jr_new_author:nn {#1} {#2} }
\cs_new_protected:Npn \__hep_jr_person:nn #1#2
  {
    \seq_gput_right:Nn \g__hep_jr_editor_seq {#1}
    \int_gset:Nn \g__hep_jr_current_int { -1 }
  }
\DeclareDocumentCommand \editor { O{} m }
  { \__hep_jr_person:nn { \editor } {#2} }
\DeclareDocumentCommand \endorser { O{} m }
  { \__hep_jr_person:nn { \endorser } {#2} }
\DeclareDocumentCommand \affiliation { o m }
  {
    \tl_if_novalue:nTF {#1}
      {
        \int_gincr:N \g__hep_jr_affil_int
        \tl_set:Ne \l__hep_jr_label_tl
          { hep-affiliation- \int_use:N \g__hep_jr_affil_int }
        \seq_map_inline:Nn \g__hep_jr_pending_seq
          {
            \clist_gput_right:cV
              { \__hep_jr_field:nn {##1} { labels_clist } }
              \l__hep_jr_label_tl
          }
        \bool_gset_true:N \g__hep_jr_after_affil_bool
      }
      { \tl_set:Ne \l__hep_jr_label_tl { \tl_trim_spaces:n {#1} } }
    \prop_gput:NVn \g__hep_jr_affil_prop \l__hep_jr_label_tl {#2}
    \seq_gput_right:NV \g__hep_jr_affil_seq \l__hep_jr_label_tl
  }
\cs_new_protected:Npn \__hep_jr_contact:nnn #1#2#3
  {
    \bool_if:NTF \g__hep_jr_made_bool {#3} { #1 { } {#2} { } }
  }
\DeclareDocumentCommand \email { o m }
  {
    \__hep_jr_contact:nnn \__hep_jr_email:nnn {#2}
      { \hep@email {#2} }
  }
\DeclareDocumentCommand \orcid { m }
  {
    \__hep_jr_contact:nnn \__hep_jr_orcid:nnn {#1}
      { \online { https://orcid.org/#1 } {#1} }
  }
\DeclareDocumentCommand \orcmail { m m }
  { \email {#2} \orcid {#1} }
\DeclareDocumentCommand \thanks { o m }
  {
    \bool_if:NTF \g__hep_jr_made_bool
      { \__hep_jr_class_thanks: {#2} }
      { \__hep_jr_thanks:nnn { } {#2} { } }
  }
\clist_map_inline:nn
  {
    seriesfont, titlefont, subtitlefont, authorfont, authortitlefont,
    affiliationfont, editorfont, endorserfont, editortitlefont,
    endorsertitlefont, datefont, preprintfont, reprintfont, preseries,
    postseries, presubtitle, postsubtitle, preauthortitle,
    postauthortitle, preeditor, posteditor, preendorser, postendorser,
    preeditortitle, posteditortitle, preendorsertitle, postendorsertitle
  }
  { \cs_if_exist:cF {#1} { \cs_new_protected:cpn {#1} ##1 { } } }
\clist_map_inline:nn { authortitle, editortitle, endorsertitle }
  { \cs_if_exist:cF {#1} { \cs_new_protected:cpn {#1} ##1##2 { } } }
\clist_map_inline:nn { placepreprint, placereprint }
  { \cs_if_exist:cF {#1} { \cs_new_protected:cpn {#1} { } } }
%    \end{macrocode}
%
% \subsection{Abstract}
%
% The abstract can be given in the preamble or in the document, as environment or in the command form "\abstract"\marg{text}, before or directly after "\maketitle".
% Before the title is made the abstract is stored.
% An abstract environment directly after "\maketitle" is stored as well and the title is made at the end of the environment.
% An abstract later in the document is typeset by classes that allow this (\software{svjour3} and the \software{KOMA-Script} classes); otherwise it is written to the auxiliary file and used in the next run.
% Classes without abstract, such as \software{scrbook}, get the environment as well, and the abstract is ignored with a warning.
%
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_jr_store_abstract:n #1
  {
    \tl_gset:Nn \g__hep_jr_abstract_tl {#1}
    \bool_gset_true:N \g__hep_jr_abstract_bool
  }
\cs_new_protected:Npn \hep@journal@abstract #1
  {
    \tl_gset:Nn \g__hep_jr_aux_abstract_tl {#1}
    \bool_gset_true:N \g__hep_jr_aux_abstract_bool
  }
\cs_new_protected:Npn \__hep_jr_abstract:n #1
  {
    \bool_if:NTF \g__hep_jr_made_bool
      { \__hep_jr_late_abstract:n {#1} }
      {
        \__hep_jr_store_abstract:n {#1}
        \bool_if:NT \g__hep_jr_pending_bool
          { \group_insert_after:N \__hep_jr_render: }
      }
  }
\cs_new_protected:Npn \__hep_jr_late_abstract:n #1
  {
    \cs_if_exist_use:cF
      { __hep_jr_ \g__hep_jr_backend_str _late_abstract:n }
      {
        \bool_if:NF \g__hep_jr_aux_abstract_bool
          { \msg_warning:nn { hep-journal } { late-abstract } }
        \iow_now:Ne \@auxout
          { \exp_not:N \hep@journal@abstract { \exp_not:n {#1} } }
        \use_none:n
      }
      {#1}
  }
\cs_if_exist:NF \abstract { \newenvironment { abstract } { } { } }
\RenewEnviron { abstract }
  { \exp_args:NV \__hep_jr_abstract:n \BODY }
\cs_gset_eq:NN \__hep_jr_abstract_environment: \abstract
\cs_gset_protected:Npn \abstract
  {
    \str_if_eq:VnTF \@currenvir { abstract }
      { \__hep_jr_abstract_environment: }
      {
        \bool_if:NTF \g__hep_jr_made_bool
          { \__hep_jr_late_abstract:n }
          { \__hep_jr_store_abstract:n }
      }
  }
\cs_gset_protected:cpn { abstract* }
  { \maketitle \begin { abstract } }
\cs_gset_protected:cpn { endabstract* } { \end { abstract } }
%    \end{macrocode}
%
% Keep copies of the user commands, so that they can be reinstalled after the class commands have been used.
%
%    \begin{macrocode}
\clist_map_inline:Nn \c__hep_jr_class_clist
  {
    \cs_if_exist:cT {#1}
      {
        \exp_args:Ncc \NewCommandCopy
          { __hep_jr_user_ #1 : } {#1}
      }
  }
\cs_new_protected:Npn \__hep_jr_install:n #1
  {
    \clist_map_inline:nn {#1}
      { \cs_gset_eq:cc {##1} { __hep_jr_user_ ##1 : } }
  }
%    \end{macrocode}
%
% \subsection{Title}
%
% "\maketitle" looks ahead for an abstract environment, skipping spaces, paragraphs and the "\Hy@maketitle@end" of \software{hyperref}, which wraps "\maketitle".
% The title is made by collecting the code for the class in a sequence, restoring the class macros, and running the code.
% If \software{hyperref} has wrapped "\maketitle", the wrapper is kept around the class "\maketitle".
%
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_jr_maketitle:
  { \bool_if:NF \g__hep_jr_made_bool { \__hep_jr_peek: } }
\cs_gset_eq:NN \maketitle \__hep_jr_maketitle:
\bool_new:N \g__hep_jr_hyperref_bool
