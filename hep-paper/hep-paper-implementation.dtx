    \__hep_jr_emit:e { \exp_not:N \author { \exp_not:V \l__hep_jr_tmp_tl } }
    \seq_if_empty:NF \l__hep_jr_tmp_seq
      {
        \__hep_jr_emit:e
          {
            \exp_not:N \institute
