%
% Define the SISSA conditional.
% The "jhep" and "jcap" options load the \software{JHEP} and \software{JCAP} styles if they have not been loaded before.
% These styles are distributed by the journals, so ignore the options with a warning if the styles are not installed.
%    \begin{macrocode}
\newcommand*\hep@sissa@style[2]{%
  \csname ifhep@#1\endcsname
    \IfFileExists{#2.sty}{\RequirePackage{#2}}{%
      \PackageWarningNoLine{hep-paper}{%
        Option `#1' ignored, since #2.sty is not installed%
      }%
      \setkeys{hep}{#1=false}%
    }%
  \fi
}
\hep@sissa@style{jhep}{jheppub}
\hep@sissa@style{jcap}{jcappub}
\@ifpackageloaded{jheppub}{\setkeys{hep}{jhep}}{}
\@ifpackageloaded{jcappub}{\setkeys{hep}{jcap}}{}
\newif\ifhep@sissa
\ifhep@jhep\hep@sissatrue
\else
  \ifhep@jcap\hep@sissatrue
  \else\hep@sissafalse
  \fi
\fi
%    \end{macrocode}
%
% Set the SISSA compatibility options.
%    \begin{macrocode}
\ifhep@sissa
  \setkeys{hep}{defaults, bibliography=false}
  \RequirePackage{hep-sissa}
\fi
\ifhep@jhep
    \PassOptionsToPackage{\hep@paper paper}{geometry}
    \RequirePackage{geometry}
    \geometry{
      offset=0in,
      top=.1\paperheight,
      textheight=.756\paperheight,
      textwidth=.72\paperwidth,
    }
\fi
