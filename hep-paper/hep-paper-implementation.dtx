% \subsection{Set compatibility}
%
% \begin{macro}{\hep@compatibility}
% The classes are detected below, so the compatibility options for classes are not needed.
% Ignore the option "#1" with a warning if none of the classes "#2" is loaded, since the compatibility mode would fail with any other class.
%    \begin{macrocode}
\newcommand*\hep@compatibility[2]{%
  \csname ifhep@#1\endcsname
    \@tempswafalse
    \@for\hep@tempa:=#2\do{\@ifclassloaded{\hep@tempa}{\@tempswatrue}{}}%
    \if@tempswa\else
      \PackageWarningNoLine{hep-paper}{%
        Option `#1' ignored, since none of the classes\MessageBreak
        #2 is loaded.\MessageBreak
        The compatibility mode is selected automatically\MessageBreak
        if one of them is loaded%
      }%
      \setkeys{hep}{#1=false}%
    \fi
  \fi
}
\hep@compatibility{amsart}{amsart}
\hep@compatibility{koma}{scrartcl,scrreprt,scrbook}
\hep@compatibility{springer}{svjour,svjour2,svjour3}
\hep@compatibility{pos}{PoS}
\hep@compatibility{beamer}{beamer}
\hep@compatibility{revtex}{revtex4,revtex4-1,revtex4-2}
%    \end{macrocode}
% \end{macro}
