                \exp_not:N \hfill
                \exp_not:N \begin { tabular } [ t ] { @ { } r @ { } }
                \seq_use:Nn \l__hep_jr_tmp_seq { \\ }
                \exp_not:N \end { tabular }
              }
          }
      }
  }
%    \end{macrocode}
%
% An abstract later in the document is typeset where it stands.
