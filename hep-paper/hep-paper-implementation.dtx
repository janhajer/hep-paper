% \subsubsection{PoS}
%
% Every author gets one "\author" with affiliations and emails.
% The series becomes "\FullConference", the title "\ShortTitle", unless they are given, and the keywords are appended to the abstract.
% The class makes the title at the beginning of the document.
% If the abstract is known by then, the title is made there and "\maketitle" does nothing.
% Otherwise the data are handed over at the beginning of the document and the abstract and the title follow at "\maketitle".
%
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_jr_pos_code:
  {
    \__hep_jr_no_preprint:
    \__hep_jr_no_reprint:
    \__hep_jr_no_orcid:
    \__hep_jr_no_date:
    \__hep_jr_emit:e { \exp_not:N \title { \__hep_jr_full_title: } }
    \legacy_if:nF { @shorttitle }
      {
        \__hep_jr_emit:e
          {
            \exp_not:N \ShortTitle
              {
                \tl_if_empty:NTF \g__hep_jr_short_title_tl
                  { \exp_not:V \g__hep_jr_title_tl }
                  { \exp_not:V \g__hep_jr_short_title_tl }
              }
          }
      }
    \legacy_if:nF { @conf }
      {
        \tl_if_empty:NF \g__hep_jr_series_tl
          {
            \__hep_jr_emit:e
              {
                \exp_not:N \FullConference
                  { \exp_not:V \g__hep_jr_series_tl }
              }
          }
      }
    \int_step_inline:nn { \g__hep_jr_authors_int }
      {
        \seq_clear:N \l__hep_jr_tmp_seq
        \seq_put_right:Ne \l__hep_jr_tmp_seq
          {
            \__hep_jr_name:n {##1}
            \seq_map_function:cN
              { \__hep_jr_field:nn {##1} { thanks_seq } }
              \__hep_jr_pos_thanks:n
          }
        \clist_map_inline:cn { \__hep_jr_field:nn {##1} { labels_clist } }
          {
            \prop_if_in:NnT \g__hep_jr_affil_prop {####1}
              {
                \seq_put_right:Ne \l__hep_jr_tmp_seq
                  { \__hep_jr_affil:n {####1} }
              }
          }
        \seq_if_empty:cF { \__hep_jr_field:nn {##1} { email_seq } }
          {
            \seq_put_right:Ne \l__hep_jr_tmp_seq
              {
                E-mail:~
                \seq_map_function:cN
                  { \__hep_jr_field:nn {##1} { email_seq } }
                  \__hep_jr_pos_email:n
              }
          }
        \__hep_jr_emit:e
          {
            \exp_not:N \author
              { \seq_use:Nn \l__hep_jr_tmp_seq { \\ } }
          }
      }
  }
\cs_new:Npn \__hep_jr_pos_thanks:n #1
  { \exp_not:N \thanks { \exp_not:n {#1} } }
\cs_new:Npn \__hep_jr_pos_email:n #1
  { \exp_not:N \email { \exp_not:n {#1} } \c_space_tl }
\cs_new_protected:Npn \__hep_jr_pos_abstract:
  {
    \__hep_jr_emit:e
      {
        \exp_not:N \abstract
          {
            \bool_if:NT \g__hep_jr_abstract_bool
              { \exp_not:V \g__hep_jr_abstract_tl }
            \tl_if_empty:NF \g__hep_jr_keywords_tl
              {
                \exp_not:N \par \exp_not:N \medskip \exp_not:N \noindent
                \exp_not:N \textit { Keywords: }
                \c_space_tl \exp_not:V \g__hep_jr_keywords_tl
              }
          }
      }
  }
\str_if_eq:VnT \g__hep_jr_backend_str { pos }
  {
    \cs_gset_eq:NN \__hep_jr_pos_maketitle: \auto@maketitle
    \AddToHook { begindocument }
      {
        \bool_if:NF \g__hep_jr_abstract_bool
          {
            \bool_if:NT \g__hep_jr_aux_abstract_bool
              {
                \exp_args:NV \__hep_jr_store_abstract:n
                  \g__hep_jr_aux_abstract_tl
              }
          }
        \bool_if:NTF \g__hep_jr_abstract_bool
          {
            \__hep_jr_prepare:
            \__hep_jr_pos_code:
            \__hep_jr_pos_abstract:
            \__hep_jr_run:
          }
          {
            \seq_gclear:N \g__hep_jr_code_seq
            \__hep_jr_pos_code:
            \legacy_if_gset_true:n { @abstract }
            \cs_gset_eq:NN \auto@maketitle \prg_do_nothing:
            \cs_gset_protected:Npn \__hep_jr_pos_code:
              {
                \__hep_jr_pos_abstract:
                \__hep_jr_emit:n
                  {
                    \legacy_if_set_true:n { @titlepage }
                    \__hep_jr_pos_maketitle:
                    \legacy_if_set_false:n { @titlepage }
                  }
              }
            \__hep_jr_restore:
            \__hep_jr_use_code:
            \__hep_jr_install:n
              {
                title, author, affiliation, email, thanks, keywords,
                date, subtitle, preprint, abstract, endabstract
              }
            \cs_gset_eq:NN \maketitle \__hep_jr_maketitle:
          }
      }
  }
%    \end{macrocode}
%
% \subsubsection{KOMA-Script}
%
% The series becomes the "\subject" and the preprint and arXiv numbers are placed right aligned in the "\titlehead".
% The authors are separated by "\and" and get the letters of their affiliations in the order of first use, unless there is only one affiliation, and their emails and thanks as "\thanks".
% The affiliations are listed in "\publishers", which follows the authors and the date.
% The abstract follows the title, with the keywords appended.
% The \software{scrbook} class has no abstract.
%
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_jr_koma_code:
  {
    \__hep_jr_no_reprint:
    \__hep_jr_no_orcid:
    \tl_if_empty:NF \g__hep_jr_series_tl
      {
        \__hep_jr_emit:e
          { \exp_not:N \subject { \exp_not:V \g__hep_jr_series_tl } }
      }
    \__hep_jr_koma_titlehead:
    \__hep_jr_emit:e
      { \exp_not:N \title { \exp_not:V \g__hep_jr_title_tl } }
    \tl_if_empty:NF \g__hep_jr_subtitle_tl
      {
        \__hep_jr_emit:e
          { \exp_not:N \subtitle { \exp_not:V \g__hep_jr_subtitle_tl } }
      }
    \__hep_jr_labels:N \l__hep_jr_tmp_seq
    \prop_clear:N \l__hep_jr_letter_prop
    \int_compare:nNnT { \seq_count:N \l__hep_jr_tmp_seq } > 1
      {
        \seq_map_indexed_inline:Nn \l__hep_jr_tmp_seq
          {
            \prop_put:Nne \l__hep_jr_letter_prop {##2}
              { \int_to_alph:n {##1} }
          }
      }
    \tl_clear:N \l__hep_jr_tmp_tl
    \int_step_inline:nn { \g__hep_jr_authors_int }
      {
        \clist_clear:N \l__hep_jr_tmp_clist
        \clist_map_inline:cn { \__hep_jr_field:nn {##1} { labels_clist } }
          {
            \prop_get:NnNT \l__hep_jr_letter_prop {####1}
              \l__hep_jr_label_tl
              {
                \clist_put_right:NV \l__hep_jr_tmp_clist
                  \l__hep_jr_label_tl
              }
          }
        \tl_put_right:Ne \l__hep_jr_tmp_tl
          {
            \int_compare:nNnF {##1} = 1 { \exp_not:N \and }
            \__hep_jr_name:n {##1}
            \clist_if_empty:NF \l__hep_jr_tmp_clist
              {
                \exp_not:N \textsuperscript
                  { \clist_use:Nn \l__hep_jr_tmp_clist { , } }
              }
            \seq_map_function:cN
              { \__hep_jr_field:nn {##1} { email_seq } }
              \__hep_jr_koma_email:n
            \seq_map_function:cN
              { \__hep_jr_field:nn {##1} { thanks_seq } }
              \__hep_jr_pos_thanks:n
          }
      }
    \__hep_jr_emit:e { \exp_not:N \author { \exp_not:V \l__hep_jr_tmp_tl } }
    \__hep_jr_emit_date:
    \seq_if_empty:NF \l__hep_jr_tmp_seq
      {
        \__hep_jr_emit:e
          {
            \exp_not:N \publishers
              {
                \seq_map_indexed_function:NN \l__hep_jr_tmp_seq
                  \__hep_jr_koma_affil:nn
              }
          }
      }
    \__hep_jr_emit:n { \maketitle }
    \cs_if_exist:NTF \__hep_jr_class_abstract:
      {
        \bool_if:NT \g__hep_jr_abstract_bool
          {
            \__hep_jr_emit:e
              {
                \exp_not:N \begin { abstract }
                \exp_not:V \g__hep_jr_abstract_tl
                \__hep_jr_koma_keywords:
                \exp_not:N \end { abstract }
              }
          }
      }
      {
        \bool_if:NT \g__hep_jr_abstract_bool
          { \__hep_jr_unsupported:n { abstract } }
      }
    \bool_if:nT
      {
        ! \bool_if_p:N \g__hep_jr_abstract_bool
        || ! \cs_if_exist_p:N \__hep_jr_class_abstract:
      }
      {
        \tl_if_empty:NF \g__hep_jr_keywords_tl
          { \__hep_jr_unsupported:n { keywords } }
      }
  }
\cs_new:Npn \__hep_jr_koma_email:n #1
  {
    \exp_not:N \thanks
      { E-mail:~ \exp_not:N \hep@email { \exp_not:n {#1} } }
  }
\cs_new:Npn \__hep_jr_koma_affil:nn #1#2
  {
    \int_compare:nNnF {#1} = 1 { \exp_not:N \par }
    \int_compare:nNnT { \seq_count:N \l__hep_jr_tmp_seq } > 1
      { \exp_not:N \textsuperscript { \int_to_alph:n {#1} } }
    \__hep_jr_affil:n {#2}
  }
\cs_new:Npn \__hep_jr_koma_keywords:
  {
    \tl_if_empty:NF \g__hep_jr_keywords_tl
      {
        \exp_not:N \par \exp_not:N \medskip \exp_not:N \noindent
        \exp_not:N \textit { Keywords: }
        \c_space_tl \exp_not:V \g__hep_jr_keywords_tl
      }
  }
%    \end{macrocode}
%
% Preprint and arXiv numbers are listed right aligned in the title head.
%
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_jr_koma_titlehead:
  {
    \seq_set_eq:NN \l__hep_jr_tmp_seq \g__hep_jr_preprint_seq
