            \seq_put_right:Nn \l__hep_jr_tmp_seq {####1}
          }
      }
    \seq_map_inline:Nn \g__hep_jr_affil_seq
      {
        \seq_if_in:NnF \l__hep_jr_tmp_seq {##1}
          { \msg_warning:nnn { hep-journal } { unused } {##1} }
      }
  }
%    \end{macrocode}
