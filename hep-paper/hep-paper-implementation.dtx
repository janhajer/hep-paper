%
% \subsubsection{JHEP and JCAP}
%
% The labels become letters in the order of first use, thanks become "\note"s with numbers and emails "\emailAdd"s.
% The series becomes the "\subheader", the first arXiv number the "\arxivnumber".
%
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_jr_sissa_code:
  {
    \__hep_jr_no_reprint:
    \__hep_jr_no_orcid:
    \__hep_jr_no_date:
    \tl_if_empty:NF \g__hep_jr_series_tl
      {
        \__hep_jr_emit:e
          { \exp_not:N \subheader { \exp_not:V \g__hep_jr_series_tl } }
      }
    \__hep_jr_emit_title:
    \__hep_jr_labels:N \l__hep_jr_tmp_seq
    \prop_clear:N \l__hep_jr_letter_prop
    \seq_map_indexed_inline:Nn \l__hep_jr_tmp_seq
      {
        \prop_put:Nne \l__hep_jr_letter_prop {##2}
          { \int_to_alph:n {##1} }
      }
    \int_zero:N \l__hep_jr_tmp_int
    \int_step_inline:nn { \g__hep_jr_authors_int }
      {
        \clist_clear:N \l__hep_jr_tmp_clist
        \clist_map_inline:cn { \__hep_jr_field:nn {##1} { labels_clist } }
          {
            \prop_get:NnNT \l__hep_jr_letter_prop {####1}
              \l__hep_jr_label_tl
              {
                \clist_put_right:NV \l__hep_jr_tmp_clist
                  \l__hep_jr_label_tl
              }
          }
        \seq_map_inline:cn { \__hep_jr_field:nn {##1} { thanks_seq } }
          {
            \int_incr:N \l__hep_jr_tmp_int
            \clist_put_right:Ne \l__hep_jr_tmp_clist
              { \int_use:N \l__hep_jr_tmp_int }
          }
        \__hep_jr_emit:e
          {
            \exp_not:N \author
            \clist_if_empty:NF \l__hep_jr_tmp_clist
              { [ \clist_use:Nn \l__hep_jr_tmp_clist { , } ] }
            { \__hep_jr_name:n {##1} }
          }
      }
    \seq_map_indexed_inline:Nn \l__hep_jr_tmp_seq
      {
        \__hep_jr_emit:e
          {
            \exp_not:N \affiliation [ \int_to_alph:n {##1} ]
              { \__hep_jr_affil:n {##2} }
          }
      }
    \int_zero:N \l__hep_jr_tmp_int
    \int_step_inline:nn { \g__hep_jr_authors_int }
      {
        \seq_map_inline:cn { \__hep_jr_field:nn {##1} { thanks_seq } }
          {
            \int_incr:N \l__hep_jr_tmp_int
            \__hep_jr_emit:e
              {
                \exp_not:N \note [ \int_use:N \l__hep_jr_tmp_int ]
                  { \exp_not:n {####1} }
              }
          }
        \seq_map_inline:cn { \__hep_jr_field:nn {##1} { email_seq } }
          { \__hep_jr_emit:n { \emailAdd {####1} } }
      }
    \__hep_jr_sissa_preprint:
    \seq_if_empty:NF \g__hep_jr_arxiv_seq
      {
        \__hep_jr_emit:e
          {
            \exp_not:N \arxivnumber
              { \seq_item:Nn \g__hep_jr_arxiv_seq { 1 } }
          }
      }
    \__hep_jr_emit_keywords:
    \bool_if:NT \g__hep_jr_abstract_bool
      {
        \__hep_jr_emit:e
          { \exp_not:N \abstract { \exp_not:V \g__hep_jr_abstract_tl } }
      }
    \__hep_jr_emit:n { \maketitle }
  }
\cs_new_eq:NN \__hep_jr_jhep_code: \__hep_jr_sissa_code:
\cs_new_eq:NN \__hep_jr_jcap_code: \__hep_jr_sissa_code:
%    \end{macrocode}
%
% Preprint numbers and further arXiv numbers are placed right aligned in the header, by "\preprint" in \software{JHEP} and appended to "\@fpheader" in \software{JCAP}.
%
%    \begin{macrocode}
\cs_new_protected:Npn \__hep_jr_sissa_preprint:
  {
    \seq_set_eq:NN \l__hep_jr_tmp_seq \g__hep_jr_preprint_seq
    \seq_map_indexed_inline:Nn \g__hep_jr_arxiv_seq
      {
        \int_compare:nNnT {##1} > 1
          {
            \seq_put_right:Ne \l__hep_jr_tmp_seq
              { arXiv:~ \__hep_jr_arxiv_link:n {##2} }
          }
      }
    \seq_if_empty:NF \l__hep_jr_tmp_seq
      {
        \tl_set:Ne \l__hep_jr_tmp_tl
          {
            \exp_not:N \begin { tabular } [ t ] { @ { } r @ { } }
            \seq_use:Nn \l__hep_jr_tmp_seq { \\ }
            \exp_not:N \end { tabular }
          }
        \cs_if_exist:NTF \__hep_jr_class_preprint:
          {
            \__hep_jr_emit:e
              { \exp_not:N \preprint { \exp_not:V \l__hep_jr_tmp_tl } }
          }
          {
            \__hep_jr_emit:e
              {
                \exp_not:N \g@addto@macro \exp_not:N \@fpheader
                  { \exp_not:N \hfill \exp_not:V \l__hep_jr_tmp_tl }
              }
          }
      }
  }
%    \end{macrocode}
%
% \subsubsection{REV\hologo{TeX}}
